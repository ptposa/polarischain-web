---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/hero/Hero.astro';
import Motivation from '../components/sections/Motivation.astro';
import Landscape from '../components/sections/Landscape.astro';
import Gap from '../components/sections/Gap.astro';
import Proposal from '../components/sections/Proposal.astro';
import Model from '../components/sections/Model.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Admission from '../components/sections/Admission.astro';
import CommonLog from '../components/sections/CommonLog.astro';
import Migration from '../components/sections/Migration.astro';
import UseCases from '../components/sections/UseCases.astro';
import Laboratory from '../components/sections/Laboratory.astro';
import Credits from '../components/sections/Credits.astro';
import Horizon from '../components/Horizon.astro';
---

<BaseLayout
  title="PolarisChain · A governed graph model for federated trust"
  description="PolarisChain models PKI federation as a governed, weighted graph: admissible certification paths are discovered, governed and chosen across classical, hybrid and post-quantum domains."
>
  <Header />
  <main>
    <Hero />
    <Motivation />
    <Landscape />
    <Gap />
    <Proposal />
    <Model />
    <HowItWorks />
    <Admission />
    <CommonLog />
    <Migration />
    <UseCases />
    <Laboratory />
    <Credits />
  </main>
  <Horizon />
</BaseLayout>
