---
import MainLayout from "../layouts/MainLayout.astro";
import PKIGraphHero from "../components/PKIGraphHero.astro";
import ResearchSection from "../components/ResearchSection.astro";
import HowItWorks from "../components/HowItWorks.astro";
import OpenScience from "../components/OpenScience.astro";
import "../styles/global.css";
---

<MainLayout title="PolarisChain">
  <header class="site-header">
    <div class="container header-shell">
      <a href="/" class="brand" aria-label="PolarisChain home">
        <span class="brand-mark"></span>
        <span>PolarisChain</span>
      </a>

      <nav class="nav nav-right" aria-label="Primary">
        <a href="#research">Research</a>
        <a href="#interoperability">Interoperability</a>
        <a href="#how-it-works">How it works</a>
        <a href="/docs" class="cta">Launch app</a>
      </nav>
    </div>
  </header>

  <main>
    <PKIGraphHero />
    <ResearchSection />
    <HowItWorks />
    <OpenScience />
  </main>
</MainLayout>
