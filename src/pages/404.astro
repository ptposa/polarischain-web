---
import MainLayout from "../layouts/MainLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StatusPage from "../components/StatusPage.astro";
---

<MainLayout
  title="Page not found | PolarisChain"
  description="The requested PolarisChain page could not be found."
>
  <SiteHeader />
  <StatusPage
    eyebrow="Route status"
    statusCode="404"
    title="Page not found"
    description="The route you requested is not available in the current PolarisChain navigation. It may have moved, remained unpublished, or simply never existed within this research environment."
    note="You can return to the landing page and continue from the main research sections."
    primaryHref="/"
    primaryLabel="Return home"
    secondaryHref="/#research"
    secondaryLabel="Explore research"
    panelKicker="Lookup result"
    panelTitle="No published route in the graph."
    panelText="PolarisChain keeps its public surface intentionally focused. This address is not part of the currently available research portal."
    metaPrimaryLabel="Resolution"
    metaPrimaryValue="Not found"
    metaSecondaryLabel="Suggested path"
    metaSecondaryValue="Homepage"
  />
</MainLayout>
