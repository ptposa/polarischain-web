---
import { citeNum } from '../../data/references';
import Chapter from '../Chapter.astro';
import Figure from '../Figure.astro';
import FigState from '../figures/FigState.astro';
import FigAdmissionMap from '../figures/FigAdmissionMap.astro';
import FigWorkedExample from '../figures/FigWorkedExample.astro';
import FigFloorPrice from '../figures/FigFloorPrice.astro';
import FigCone from '../figures/FigCone.astro';
import Where from '../Where.astro';

// The section follows chapter 3 of the thesis, in its short version of
// 16 November 2026. Formulas are written as markup and rendered with
// set:html, so their braces need no escaping.
const eqGraph = 'G|<sub>t</sub> = ( V, E|<sub>t</sub>, src, dst, w, Φ )';
const eqInstant = 'E|<sub>t</sub> = { e ∈ E : t ∈ time(e) }';
const eqLife = 'life<sub>d</sub>(e) = { t ∈ time(e) : rev<sub>d</sub>(e, t) = <code>good</code> }';
const eqPolicy =
  'π<sub>d</sub> = ( TP<sub>d</sub>, κ<sub>d</sub>, τ<sub>d</sub>, A<sub>d</sub><sup>key</sup>, A<sub>d</sub><sup>sig</sup>, σ<sub>d</sub>, L<sub>d</sub>, F<sub>d</sub>, D<sub>d</sub> )';
const eqFloor =
  'ℓ(u) ⪰ τ &nbsp;⟺&nbsp; stage(u) ≥ τ<sup>stage</sup> ∧ nist_category(u) ≥ τ<sup>cat</sup>';
const eqCost =
  'b(e) = |pk(dst(e))| + |sig(e)| &emsp; w<sub>d</sub>(e) = b(e) + κ<sub>d</sub> · c<sub>dist</sub>(e) <br />W<sub>d</sub>(P) = Σ<sub>e ∈ P</sub> w<sub>d</sub>(e)';
const eqState =
  'S = ℕ<sub>∞</sub> × 𝒯 × 𝒯 × 𝒢<sub>pol</sub> × ℕ<sub>∞</sub><sup>3</sup> × 2<sup>OID</sup><br />δ : S × E → S ∪ {⊥} &emsp; fin<sub>t</sub> : V × S × 𝒳 → 𝒪 ∪ {⊥}';
const eqAdm =
  'P<sub>adm</sub>(d, c, t, τ) = { P ∈ Paths<sub>d,τ</sub>(t) ∩ 𝒰<sub>d</sub> :<br />fresh<sub>d</sub>(M, t) ∧ P ⊨<sub>d,c</sub> Φ ∧ ∀i ∈ {1, …, h+1} : status<sub>t</sub>(P, i) }';
const eqStatus =
  'status<sub>t</sub>(P, i) ⟺ exempt(x<sub>i</sub>) ∨ ( ( i = 1 ∨ crl(e<sub>i−1</sub>) ) ∧ rev<sub>d</sub>(x<sub>i</sub>, t) = <code>good</code> )';
const eqSel =
  'P*<sub>d</sub>(c) = Sel( arg min<sub>P ∈ P<sub>adm</sub></sub> W<sub>d</sub>(P) )<br />k(P) = ( W<sub>d</sub>(P), h, id<sub>tp</sub>, (id(e<sub>1</sub>), …, id(e<sub>h</sub>)) )';
const eqCone =
  'Cone<sub>d</sub>(M, t) = { v : a path of E<sub>d,τ<sub>d</sub><sup>r</sup></sub>|<sub>t</sub> leads from v<sub>tp</sub> to v, for some tp ∈ TP<sub>d</sub>(t) }';

const graphRows = [
  ['V', 'CA keys, v = ⟨dn, pk, alg⟩', 'Subject name, subjectPublicKeyInfo. Each key carries its domain, its level ℓ(v) and a weak-key flag.'],
  ['E|<sub>t</sub> ⊆ E', 'Certificates between keys', 'Those within their validity period at <span class="m">t</span>. Revocation is not here: each receiver resolves it at admission.'],
  ['src, dst', 'E → V', 'The key that signs each certificate and the key it certifies. Two certificates may join the same two keys: E is a multigraph.'],
  ['w', 'E → ℕ × {0, 1}', 'Cost of the edge as common facts: octets that depend on the algorithm, and whether it crosses an administrative boundary.'],
  ['Φ', 'E → 𝒞', 'Governance constraints of the certificate, ⟨depth, name, pol⟩, composed along the path as in RFC 5280, section 6.'],
  ['π<sub>d</sub>', 'not part of the graph', 'Policy of the receiving domain <span class="m">d</span>. The graph is queried with <span class="m">(π<sub>d</sub>, c, t)</span>.'],
];

const edgeConds = [
  'The signature verifies with the key <span class="m">src(e)</span>, and the two signature algorithm fields agree (RFC 5280, 6.1.3 (a)(1) and 4.1.1.2).',
  'The issuer field matches the name of the CA that holds <span class="m">src(e)</span> (6.1.3 (a)(4)).',
  '<code class="x509">basicConstraints</code> has <code class="x509">cA</code> set to <code>TRUE</code> (6.1.4 (k)).',
  'If <code class="x509">keyUsage</code> is present, it includes <code class="x509">keyCertSign</code> (6.1.4 (n)).',
  'The two ends are different keys, so the certificate is not self-signed.',
  'It carries no critical extension that the parser cannot process (6.1.4 (o)).',
  'It does not carry <code class="x509">noRevAvail</code>, which RFC 9608 forbids in CA certificates.',
];

const policyRows = [
  ['TP<sub>d</sub>', 'Trust anchor entries, each with its identifier, its key, its initial state s<sub>0</sub>(d, tp), its provenance and its validity.', '6.1.1 (c) to (i)'],
  ['κ<sub>d</sub>', 'Octets that crossing one administrative boundary is worth.', 'outside the RFC'],
  ['τ<sub>d</sub>', 'Ordered list of cryptographic floors, of one or more elements.', 'outside the RFC'],
  ['A<sub>d</sub><sup>key</sup>, A<sub>d</sub><sup>sig</sup>', 'Key profiles and signature algorithms admitted.', 'outside the RFC'],
  ['σ<sub>d</sub>', 'Purposes the chain must allow, such as <code class="x509">clientAuth</code>.', 'outside section 6'],
  ['L<sub>d</sub>', 'Largest number of CA certificates in a path.', 'outside the RFC'],
  ['F<sub>d</sub>', 'Freshness demanded of the log checkpoint and of the status evidence.', 'outside section 6'],
  ['D<sub>d</sub>', 'Keys the receiver excludes, by a canonical identifier <span class="m">kid(v)</span> of the key material.', 'outside the RFC'],
];

const sizes = [
  ['ML-DSA-87', '4,627', '2,592', 'post_quantum', '5'],
  ['ECDSA P-384 + ML-DSA-65', '3,413', '2,049', 'hybrid', '3'],
  ['ML-DSA-65', '3,309', '1,952', 'post_quantum', '3'],
  ['ECDSA P-256 + ML-DSA-44', '2,492', '1,377', 'hybrid', '2'],
  ['ML-DSA-44', '2,420', '1,312', 'post_quantum', '2'],
  ['RSA-4096', '512', '512', 'traditional', '0'],
  ['RSA-2048', '256', '256', 'traditional', '0'],
  ['ECDSA P-384', '104', '97', 'traditional', '0'],
  ['ECDSA P-256', '72', '65', 'traditional', '0'],
];
// On phones the same rows are grouped by stage, so the stage is written once
// per group and the table keeps four narrow columns.
const stages = ['post_quantum', 'hybrid', 'traditional'];
const sizesByStage = stages.map((st) => ({ st, rows: sizes.filter((r) => r[3] === st) }));

// The components of every displayed formula, one by one (see Where.astro).
const where1 = [
  ['t', 'The instant at which the federation is looked at.'],
  ['V', 'The keys of the certification authorities, each one a node v = ⟨dn(v), pk(v), alg(v)⟩: its distinguished name, its public key and the profile of that key. Each node also carries its domain dom(v), its cryptographic level ℓ(v) and a weak-key flag weak(v).'],
  ['E|<sub>t</sub>', 'The CA certificates between those keys that are within their validity period at <i>t</i>, a subset of every edge <i>E</i> compiled from the material.'],
  ['src, dst', 'Two functions E → V that give, for each certificate, the key that signs it and the key it certifies. Two certificates may join the same two keys, so the graph is a multigraph.'],
  ['w', 'The cost of each edge as common facts, a function E → ℕ × {0, 1}: the octets that depend on the algorithm, and whether the certificate crosses an administrative boundary.'],
  ['Φ', 'The governance constraints of each certificate, a function E → 𝒞 that gives ⟨depth, name, pol⟩: its depth budget, its name constraints and its policy extensions, composed along the path as in RFC 5280, section 6.'],
  ['(π<sub>d</sub>, c, t)', 'The query: the policy of the receiving domain <i>d</i>, which is not part of the graph, the certificate <i>c</i> it is presented and the instant <i>t</i>.'],
];
const where2 = [
  ['E', 'Every edge compiled from the snapshot of the material, whatever its validity.'],
  ['e', 'One edge, that is, one CA certificate between two keys.'],
  ['time(e)', 'The validity period of its certificate, from the field <code class="x509">notBefore</code> to the field <code class="x509">notAfter</code>.'],
  ['t', 'The instant of the query.'],
];
const where3 = [
  ['life<sub>d</sub>(e)', 'The instants at which receiver <i>d</i> can traverse the edge <i>e</i>.'],
  ['d', 'The receiving domain. Revocation depends on it, because the authority of the evidence is bound to its anchor.'],
  ['time(e)', 'The validity period of the certificate of <i>e</i>.'],
  ['rev<sub>d</sub>(e, t)', 'The revocation state of the certificate at <i>t</i> for the receiver: <code>revoked</code> if the applicable evidence revokes it or some evidence did so irrevocably, <code>good</code> if the applicable evidence covers <i>t</i> and holds it good, and <code>unknown</code> otherwise.'],
];
const where4 = [
  ['TP<sub>d</sub>', 'The trust anchor entries, each with its identifier, its key, its initial state s<sub>0</sub>(d, tp), its provenance and its validity.', 'RFC 5280, 6.1.1 (c) to (i)'],
  ['κ<sub>d</sub>', 'The octets that crossing one administrative boundary is worth to the receiver.', 'outside the RFC'],
  ['τ<sub>d</sub>', 'The ordered list of cryptographic floors, of one or more elements, from the most to the least demanding.', 'outside the RFC'],
  ['A<sub>d</sub><sup>key</sup>, A<sub>d</sub><sup>sig</sup>', 'The key profiles and the signature algorithms the receiver admits.', 'outside the RFC'],
  ['σ<sub>d</sub>', 'The purposes the chain must allow, such as <code class="x509">clientAuth</code>.', 'outside section 6'],
  ['L<sub>d</sub>', 'The largest number of CA certificates in a path.', 'outside the RFC'],
  ['F<sub>d</sub>', 'The freshness demanded of the log checkpoint, F<sub>d</sub><sup>cp</sup>, and of the status evidence, F<sub>d</sub><sup>ev</sup>.', 'outside section 6'],
  ['D<sub>d</sub>', 'The keys the receiver excludes, by a canonical identifier kid(v) of the key material.', 'outside the RFC'],
];
const where5 = [
  ['u', 'A key of the path, the anchor included.'],
  ['ℓ(u)', 'Its cryptographic level, the pair (stage(u), nist_category(u)).'],
  ['stage(u)', 'Its migration stage, ordered <code>traditional</code> &lt; <code>hybrid</code> &lt; <code>post_quantum</code>, with the names of RFC 9794.'],
  ['nist_category(u)', 'Its NIST security category, from 1 to 5, with 0 for traditional algorithms and the category of the post-quantum component for a hybrid one.'],
  ['τ', 'A cryptographic floor, the pair (τ<sup>stage</sup>, τ<sup>cat</sup>) the receiver demands.'],
  ['⪰', 'Meets the floor: both components are at least as high. The order is partial, so two levels may not be comparable.'],
];
const where6 = [
  ['b(e)', 'The octets of the two parts of the certificate that depend on the algorithm.'],
  ['|pk(dst(e))|', 'The size of the public key it certifies, that of the key <i>dst(e)</i>.'],
  ['|sig(e)|', 'The size of the signature that closes it, made by the key <i>src(e)</i>.'],
  ['c<sub>dist</sub>(e)', '1 if the two keys belong to different administrative domains, and 0 otherwise.'],
  ['κ<sub>d</sub>', 'The price receiver <i>d</i> puts on crossing one boundary, in octets.'],
  ['w<sub>d</sub>(e)', 'The cost of the edge for the receiver, in octet-equivalents.'],
  ['P', 'A path, a sequence of edges.'],
  ['W<sub>d</sub>(P)', 'The cost of the path, the sum of the costs of its edges.'],
];
const where7 = [
  ['ℕ<sub>∞</sub>', 'The remaining depth, <code class="x509">max_path_length</code>: a natural number, or ∞ when there is no limit.'],
  ['𝒯 × 𝒯', 'The permitted and the excluded name subtrees, <code class="x509">permitted_subtrees</code> and <code class="x509">excluded_subtrees</code>: two values of the same type.'],
  ['𝒢<sub>pol</sub>', 'The graph of valid policies of RFC 9618, which replaces the policy tree of RFC 5280.'],
  ['ℕ<sub>∞</sub><sup>3</sup>', 'The three policy counters, <code class="x509">explicit_policy</code>, <code class="x509">inhibit_anyPolicy</code> and <code class="x509">policy_mapping</code>.'],
  ['2<sup>OID</sup>', 'The initial set of policies the receiver accepts, any subset of the policy identifiers.'],
  ['δ', 'The transition: from a state and an edge, the next state, or ⊥ if the edge breaks a constraint.'],
  ['⊥', 'The failure state, which is never left.'],
  ['fin<sub>t</sub>', 'The closing step at <i>t</i>: from the last key, the state reached and the presented certificate, the output of the validation, or ⊥.'],
  ['𝒳, 𝒪', 'The presented certificates and the outputs of the closing step, the valid policies restricted by the user, as RFC 9618 fixes.'],
];
const where8 = [
  ['P<sub>adm</sub>(d, c, t, τ)', 'The paths receiver <i>d</i> may accept for the presented certificate <i>c</i> at the instant <i>t</i> under the floor <i>τ</i>.'],
  ['Paths<sub>d,τ</sub>(t)', 'The paths that start at a valid anchor entry of <i>d</i> and run over its subgraph under <i>τ</i>, each edge leaving the key the previous one reached.'],
  ['𝒰<sub>d</sub>', 'The search universe: the simple paths, with no key repeated, of at most L<sub>d</sub> CA certificates.'],
  ['fresh<sub>d</sub>(M, t)', 'The snapshot <i>M</i> is recent: its checkpoint is no older than F<sub>d</sub><sup>cp</sup>. It guards the whole query.'],
  ['P ⊨<sub>d,c</sub> Φ', 'The path satisfies the constraints for <i>c</i>: the state never falls to ⊥ and the closing step accepts it.'],
  ['h', 'The number of CA certificates of the path; the presented certificate is the (h + 1)-th.'],
  ['status<sub>t</sub>(P, i)', 'The <i>i</i>-th certificate of the chain is held good at <i>t</i>, as defined by (9).'],
];
const where9 = [
  ['x<sub>i</sub>', 'The <i>i</i>-th certificate of the chain (x<sub>1</sub>, …, x<sub>h+1</sub>), the certificates of the path followed by the presented one. It is issued by the key v<sub>i−1</sub>.'],
  ['exempt(x<sub>i</sub>)', 'Holds only for a presented certificate that carries <code class="x509">noRevAvail</code>.'],
  ['i = 1', 'The first certificate, whose issuer is the anchor: the anchor entry grants it the right to sign lists.'],
  ['crl(e<sub>i−1</sub>)', 'The permission of the certificate through which the path reaches the issuing key: its <code class="x509">keyUsage</code> carries <code class="x509">cRLSign</code>, as RFC 10007 demands.'],
  ['rev<sub>d</sub>(x<sub>i</sub>, t)', 'The revocation state for the receiver, from the list signed by the key that issued x<sub>i</sub>.'],
];
const where10 = [
  ['P*<sub>d</sub>(c)', 'The path receiver <i>d</i> selects for the certificate <i>c</i>.'],
  ['arg min W<sub>d</sub>(P)', 'The admissible paths of least cost, under the first floor of the list that leaves any, τ<sub>d</sub><sup>j*</sup>.'],
  ['Sel', 'The choice of a single path among them, the first in the order of the key <i>k</i>.'],
  ['k(P)', 'The selection key, compared in order: the cost W<sub>d</sub>(P), the number of certificates <i>h</i>, the identifier of the anchor entry id<sub>tp</sub> and the identifiers id(e<sub>1</sub>), …, id(e<sub>h</sub>) of its certificates.'],
  ['id(e)', 'The SHA-256 digest of the signed content of the certificate together with the key that signs it.'],
];
const where11 = [
  ['Cone<sub>d</sub>(M, t)', 'The cone of trust of receiver <i>d</i> over the snapshot <i>M</i> at the instant <i>t</i>.'],
  ['v', 'A key of the graph.'],
  ['E<sub>d,τ<sub>d</sub><sup>r</sup></sub>|<sub>t</sub>', 'The edges of the receiver’s subgraph at <i>t</i> under the last floor of its list, τ<sub>d</sub><sup>r</sup>.'],
  ['v<sub>tp</sub>', 'The key of the anchor entry <i>tp</i>.'],
  ['TP<sub>d</sub>(t)', 'The anchor entries of <i>d</i> that are valid at <i>t</i>.'],
];

const exEdges = [
  ['e<sub>1</sub>', 'Root B → Intermediate B', '5,462', '0', '5,462'],
  ['e<sub>2</sub>', 'Intermediate B → Intermediate C1', '5,462', '1', '11,462'],
  ['e<sub>3</sub>', 'Intermediate C1 → Issuing C', '5,365', '0', '5,365'],
  ['e<sub>8</sub>', 'Intermediate B → Intermediate C3', '6,005', '1', '12,005'],
  ['e<sub>9</sub>', 'Intermediate C3 → Issuing C', '6,579', '0', '6,579'],
  ['e<sub>4</sub>', 'Intermediate B → Intermediate A1', '3,510', '1', '9,510'],
  ['e<sub>10</sub>', 'Intermediate A1 → Issuing C', '2,056', '1', '8,056'],
];
