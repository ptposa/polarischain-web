---
import Chapter from '../Chapter.astro';
import Figure from '../Figure.astro';
import FigWorkedExample from '../figures/FigWorkedExample.astro';

// Each formula is followed by the meaning of its fields: the symbol, where
// the value comes from (the X.509 name when there is one), and what it does.
// Symbols and sources carry literal markup and are rendered with set:html.
interface Def {
  sym: string;
  src: string;
  text: string;
}

const graphDefs: Def[] = [
  {
    sym: 'V',
    src: 'CA certificates',
    text: 'The certification authorities of the federation, one node per algorithm: rotating a key adds a version of a node, changing algorithm adds a new node.',
  },
  {
    sym: 'E|t',
    src: 'CA-to-CA certificates, valid and not revoked at t',
    text: 'Every certificate between CAs in force at the instant t: the cross-certificates between intermediates of different domains and the internal edges of each hierarchy.',
  },
  {
    sym: 'w',
    src: 'attributes of the CA reached',
    text: 'The cost of each hop, in the receiving domain’s own weights. Defined below, in (5).',
  },
  {
    sym: 'Φ',
    src: 'X.509 extensions of each certificate',
    text: 'The governance constraints each edge imposes by itself. Defined next, in (2).',
  },
];

const phiDefs: Def[] = [
  {
    sym: 'depth(e)',
    src: 'X.509 · basicConstraints, pathLenConstraint<br />RFC 5280, section 4.2.1.9',
    text: 'How many intermediate certificates may still follow; the budget shrinks at each hop along the path.',
  },
  {
    sym: 'name(e)',
    src: 'X.509 · nameConstraints<br />RFC 5280, section 4.2.1.10',
    text: 'The name spaces the path may reach, permitted and excluded, accumulated by intersection along the path.',
  },
  {
    sym: 'pol(e)',
    src: 'X.509 · certificatePolicies, policyMappings,<br />policyConstraints, inhibitAnyPolicy',
    text: 'The policies the path carries, with their mappings and constraints, processed as the policy tree of RFC 5280, section 6.',
  },
];

const policyDefs: Def[] = [
  {
    sym: 'TP<sub>d</sub>',
    src: 'trust anchors of the receiver',
    text: 'The anchors the receiving domain accepts. Every path it considers starts at one of them.',
  },
  {
    sym: 's<sub>0</sub>',
    src: 'RFC 5280, section 6.1.1, inputs',
    text: 'The initial state of validation: the initial policy set, the explicit-policy, policy-mapping and anyPolicy indicators, and the initial name subtrees.',
  },
  {
    sym: 'α, β, γ, δ',
    src: 'weights of the cost, α + β + γ + δ = 1',
    text: 'How much the receiver values posture, friction, key strength and distance.',
  },
  {
    sym: 'τ<sub>d</sub>',
    src: 'cryptographic threshold, in [0, 1]',
    text: 'The highest posture the receiver admits on any hop: 1 accepts classical nodes, 0.3 hybrid ones, 0 only post-quantum.',
  },
  {
    sym: 'σ<sub>d</sub>',
    src: 'X.509 · extendedKeyUsage<br />RFC 5280, section 4.2.1.12',
    text: 'The purposes the path must allow, such as TLS client authentication.',
  },
];

const costDefs: Def[] = [
  {
    sym: 'c<sub>crypto</sub>(v)',
    src: 'posture · algorithm of the CA reached',
    text: '0 post-quantum, 0.3 hybrid, 1 classical.',
  },
  {
    sym: 'c<sub>alg</sub>(v)',
    src: 'friction · signature and public key size',
    text: 'Octets of signature and public key the verifier must carry, normalised.',
  },
  {
    sym: 'c<sub>key</sub>(v)',
    src: 'key strength · NIST security category',
    text: 'Strength of the key material, by NIST security category.',
  },
  {
    sym: 'c<sub>dist</sub>(u, v)',
    src: 'distance · dom(u) ≠ dom(v)',
    text: '1 when the hop crosses an administrative boundary, 0 otherwise.',
  },
];
---

<Chapter id="model" num="05" kicker="The model" title="One governed graph, read by each receiver.">
  <div class="article">
    <p class="intro">
      The federated ecosystem is modelled as a directed graph that changes over time and carries
      its own governance, read from the certificates themselves:
    </p>

    <div class="eq" role="math" aria-label="G at t equals V, E at t, w, Phi">
      <span class="eq__body"
        ><span class="v">G</span>|<span class="v">t</span> = ( <span class="v">V</span>, <span class="v">E</span
        >|<span class="v">t</span>, <span class="v">w</span>, <span class="g">Φ</span> )</span
      >
      <span class="eq__n">(1)</span>
    </div>

    <dl class="defs">
      {
        graphDefs.map((d) => (
          <div class="def">
            <dt>
              <span class="def__sym" set:html={d.sym} />
              <span class="def__src" set:html={d.src} />
            </dt>
            <dd>{d.text}</dd>
          </div>
        ))
      }
    </dl>

    <p>
      Each edge carries the governance constraints of its certificate, composed along the path
      with the semantics of RFC 5280, section 6:
    </p>

    <div class="eq" role="math" aria-label="Phi of e equals depth, name, pol">
      <span class="eq__body"
        ><span class="g">Φ</span>(<span class="v">e</span>) = ⟨ <span class="fn">depth</span>(<span
          class="v">e</span
        >), <span class="fn">name</span>(<span class="v">e</span>), <span class="fn">pol</span>(<span
          class="v">e</span
        >) ⟩</span
      >
      <span class="eq__n">(2)</span>
    </div>

    <dl class="defs">
      {
        phiDefs.map((d) => (
          <div class="def">
            <dt>
              <span class="def__sym" set:html={d.sym} />
              <span class="def__src" set:html={d.src} />
            </dt>
            <dd>{d.text}</dd>
          </div>
        ))
      }
    </dl>

    <p>
      The graph is never read in the abstract. It is always queried by a receiving domain <span
        class="m">d</span
      >, through its policy:
    </p>

    <div class="eq" role="math" aria-label="pi d">
      <span class="eq__body"
        ><span class="g">π</span><sub>d</sub> = ( <span class="v">TP</span><sub>d</sub>, <span
          class="v">s</span
        ><sub>0</sub>, <span class="g">α</span>, <span class="g">β</span>, <span class="g">γ</span>,{' '}
        <span class="g">δ</span>, <span class="g">τ</span><sub>d</sub>, <span class="g">σ</span><sub
          >d</sub
        > )</span
      >
      <span class="eq__n">(3)</span>
    </div>

    <dl class="defs defs--5">
      {
        policyDefs.map((d) => (
          <div class="def">
            <dt>
              <span class="def__sym" set:html={d.sym} />
              <span class="def__src" set:html={d.src} />
            </dt>
            <dd>{d.text}</dd>
          </div>
        ))
      }
    </dl>

    <p>
      A path is <em>admissible</em> for <span class="m">d</span> when it starts at one of its
      anchors, satisfies <span class="m">Φ</span>, keeps every hop under the threshold and allows
      the required purposes:
    </p>

    <div class="eq eq--wide" role="math" aria-label="Admissible paths">
      <span class="eq__body"
        ><span class="v">P</span><sub>adm</sub>(<span class="v">d</span>, <span class="v">v</span>,{' '}
        <span class="v">t</span>) = &#123; <span class="v">P</span> : <span class="v">tp</span> ⇝
        <span class="v">v</span> | <span class="v">tp</span> ∈ <span class="v">TP</span><sub>d</sub
        >, <span class="v">P</span> ⊆ <span class="v">E</span>|<span class="v">t</span>, <span class="v">P</span
        > ⊨ <span class="g">Φ</span>,<br />
        ∀<span class="v">e</span> ∈ <span class="v">P</span> : <span class="v">c</span><sub
          >crypto</sub
        >(<span class="v">e</span>) ≤ <span class="g">τ</span><sub>d</sub>, <span class="g">σ</span
        ><sub>d</sub> ⊆ ∩ <span class="fn">eku</span>(<span class="v">e</span>) &#125;</span
      >
      <span class="eq__n">(4)</span>
    </div>

    <p>Among the admissible paths, each hop has a cost in the receiver's own weights,</p>

    <div class="eq" role="math" aria-label="w d of u v">
      <span class="eq__body"
        ><span class="v">w</span><sub>d</sub>(<span class="v">u</span>, <span class="v">v</span>) ={' '}
        <span class="g">α</span> <span class="v">c</span><sub>crypto</sub>(<span class="v">v</span>)
        + <span class="g">β</span> <span class="v">c</span><sub>alg</sub>(<span class="v">v</span>) +{' '}
        <span class="g">γ</span> <span class="v">c</span><sub>key</sub>(<span class="v">v</span>) +{' '}
        <span class="g">δ</span> <span class="v">c</span><sub>dist</sub>(<span class="v">u</span>,{' '}
        <span class="v">v</span>)</span
      >
      <span class="eq__n">(5)</span>
    </div>

    <dl class="defs">
      {
        costDefs.map((d) => (
          <div class="def">
            <dt>
              <span class="def__sym" set:html={d.sym} />
              <span class="def__src" set:html={d.src} />
            </dt>
            <dd>{d.text}</dd>
          </div>
        ))
      }
    </dl>

    <p>
      Each term lies in [0, 1]. The receiver selects the path of least total cost:
    </p>

    <div class="eq" role="math" aria-label="Selected path">
      <span class="eq__body"
        ><span class="v">P</span>*<sub>d</sub>(<span class="v">v</span>) = <span class="fn">Sel</span
        >( <span class="fn">arg min</span><sub
          ><span class="v">P</span> ∈ <span class="v">P</span><sub>adm</sub></sub
        > Σ<sub><span class="v">e</span> ∈ <span class="v">P</span></sub> <span class="v">w</span><sub
          >d</sub
        >(<span class="v">e</span>) )</span
      >
      <span class="eq__n">(6)</span>
    </div>

    <p>
      where Sel breaks ties deterministically: the fewest certificates first, then the
      lexicographic order of their issuer and serial number.
    </p>
  </div>

  <p class="key">
    <span class="m">Φ</span> and <span class="m">τ<sub>d</sub></span> decide which paths may exist.{' '}
    <span class="m">w<sub>d</sub></span> decides which one is preferred.
  </p>

  <div class="article">
    <p>
      Admission is binary and comes first; preference is continuous and only orders what was
      admitted. Two receivers can order the same routes differently, and each is right under its
      own policy.
    </p>
  </div>

  <h3 class="example-h">A worked example</h3>
  <div class="article">
    <p>
      A receiver in domain B, hybrid with τ<sub>B</sub> = 0.3, validates a certificate issued in
      domain C. Four candidate paths exist. The threshold prunes the one through a classical
      intermediate of A; the depth budget prunes the one through the bridge, inside domain C. Of
      the two survivors, the cost selects the path through the ML-DSA-87 intermediate.
    </p>
  </div>

  <Figure num={5} caption="Four candidate paths, two pruned by different constraints, one selected by cost. With a policy that favours bandwidth instead, the hybrid path wins: the crossover can be computed, at β = 0.473.">
    <FigWorkedExample />
  </Figure>
</Chapter>

<style>
  /* The model reads as the page of a paper: every formula in one brown ink
     (the tan of the numbered labels), each followed by the meaning of its
     fields, whose symbols are set in sand. */
  :global(#model) {
    --ink: #e6d4b2;
    --ink-eq: var(--tan);
    --ink-rule: #a8957a;
  }

  .article .intro {
    max-width: var(--measure);
  }

  .article p {
    margin: 0 0 1em;
  }

  .m {
    font-family: var(--font-math);
    color: var(--ink);
  }

  .eq {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 2.8rem 0 1.6rem;
    padding: 1.1rem 0 1.1rem 1.5rem;
    border-block: 1px solid rgba(168, 149, 122, 0.22);
    background: linear-gradient(90deg, rgba(230, 212, 178, 0.035), rgba(230, 212, 178, 0));
  }

  .eq__body {
    flex: 1;
    font-family: var(--font-math);
    font-size: 1.22rem;
    line-height: 1.6;
    color: var(--ink-eq);
    text-align: center;
  }

  .eq__body sub {
    font-size: 0.66em;
  }

  .eq .fn {
    letter-spacing: 0.01em;
  }

  /* The sentence after a formula or its fields stands apart from both. */
  .eq + p {
    margin-top: 2.6rem;
  }

  .eq__n {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-rule);
  }

  /* The fields of a formula: symbol, where it comes from, what it does. */
  .defs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.4rem 2rem;
    margin: 0 0 3rem;
  }

  /* The five fields of the policy fit one row on wide screens. */
  @media (min-width: 1100px) {
    .defs--5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  .def {
    padding-left: 1rem;
    border-left: 1px solid rgba(168, 149, 122, 0.35);
  }

  .def dt {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0 0 0.45rem;
  }

  .def__sym {
    font-family: var(--font-math);
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .def__sym :global(sub) {
    font-size: 0.66em;
  }

  .def__src {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: var(--x509);
  }

  .def dd {
    margin: 0;
    font-family: var(--font-figure);
    font-size: var(--body-size);
    line-height: 1.5;
    color: var(--text-soft);
  }

  .key sub {
    font-size: 0.65em;
  }

  .key .m {
    font-style: normal;
  }

  :global(.chapter) .example-h {
    margin-top: 3rem;
  }

  @media (max-width: 560px) {
    .eq {
      padding-left: 0.6rem;
      gap: 0.6rem;
    }
    .eq__body {
      font-size: 1.02rem;
      text-align: left;
    }
  }
</style>
