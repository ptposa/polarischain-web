---
import { normative, informative } from '../../data/references';

// References cited on this page, in the style of the references section of
// an RFC: a key in brackets, then the entry. Each one is a link target.
// Only the works this page cites, in the order in which it first cites them.
const pick = [
  'Hiller2020',
  'BZ2083449',
  'WorldBank',
  'FPKI-PDVAL',
  'RFC5280',
  'RFC4158',
  'RFC5055',
  'ARMOR2024',
  'Verdict2025',
  'RFC9618',
  'RFC9608',
  'RFC10007',
  'FIPS204',
  'RFC10073',
  'Gabow1976',
  'RFC6962',
  'RFC9810',
];
const all = [...normative, ...informative];
const refs = pick.map((k) => all.find((r) => r.key === k)).filter((r) => r !== undefined);
---

<section class="chapter credits" id="references" aria-labelledby="references-h">
  <div class="wrap">
    <p class="sec"><span>End matter</span></p>
    <h2 id="references-h">References</h2>

    <ol class="refs">
      {
        refs.map((r) => (
          <li id={`ref-${r.key}`}>
            <span class="refs__key">[{r.key}]</span>
            <span>
              {r.url ? (
                <a href={r.url} target="_blank" rel="noreferrer">
                  {r.text}
                </a>
              ) : (
                r.text
              )}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="credits__head" id="credits">
      <p class="sec"><span>Academic context</span></p>
      <h2 id="credits-h">Credits</h2>
    </div>

    <div class="people grid-3">
      <div class="person">
        <p class="label">Author</p>
        <h3>Jorge Pablo Trías Posa</h3>
        <p class="small">
          Master’s Degree in Cybersecurity and Cyberintelligence<br />
          Polytechnic University of Valencia&nbsp;(UPV)
        </p>
        <p class="links">
          <a href="https://orcid.org/0009-0005-8226-8071" target="_blank" rel="noreferrer">ORCID</a>
          <a href="mailto:jptripos@upv.edu.es">jptripos@upv.edu.es</a>
        </p>
      </div>

      <div class="person">
        <p class="label">Thesis supervisor</p>
        <h3>Dr. Mario Aragonés Lozano</h3>
        <p class="small">
          <a class="plain" href="https://www.upv.es/entidades/etsit/" target="_blank" rel="noreferrer"
            >Higher Technical School of Telecommunication Engineering&nbsp;(ETSIT)</a
          ><br />
          Polytechnic University of Valencia&nbsp;(UPV)
        </p>
        <p class="links">
          <a href="https://www.upv.es/ficha-personal/maarlo9" target="_blank" rel="noreferrer"
            >Profile and publications</a
          >
        </p>
      </div>

      <div class="person">
        <p class="label">Project</p>
        <h3>PolarisChain</h3>
        <p class="small">
          Ongoing research since 2026, born as a master’s thesis and continuing as doctoral research.
        </p>
        <p class="links">
          <a href="https://github.com/ptposa/polarischain-web" target="_blank" rel="noreferrer"
            >Source of this site</a
          >
        </p>
      </div>
    </div>

    <footer class="foot">
      <p>
        This page is a public overview of research in progress, and the authoritative text is the thesis report. Laboratory results are described as planned unless a date says that they were run. The figures adapt the diagrams of the thesis and its annexes, distributed by their
        author under CC BY 4.0. All
        typefaces are under the SIL Open Font License.
      </p>
      <p class="foot__line">
        <span>PolarisChain · Jorge Pablo Trías Posa · 2026</span>
        <a href="#top">Back to the sky</a>
      </p>
    </footer>
  </div>
</section>

<style>
  .credits h2 {
    margin-bottom: 2rem;
  }

  .credits__head {
    margin-top: var(--section-gap);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .refs {
    max-width: var(--table);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .refs li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 0.45rem 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-soft);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .refs li:target {
    color: var(--text-strong);
  }
  .refs li:target .refs__key {
    color: var(--brass);
  }
  .refs a {
    color: inherit;
    text-decoration: none;
  }
  .refs a:hover {
    color: var(--link-hover);
  }
  .refs__key {
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .person h3 {
    font-size: 1.35rem;
  }
  .person .small {
    margin: 0.3rem 0 0;
    color: var(--text-soft);
  }
  .person .small a.plain {
    color: inherit;
    text-decoration: none;
  }
  .person .small a.plain:hover {
    color: var(--link-hover);
  }
  .person .label {
    margin: 0 0 0.6rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    margin: 0.8rem 0 0;
    font-family: var(--font-figure);
    font-size: 0.875rem;
  }

  .foot {
    max-width: var(--table);
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-figure);
    font-size: var(--small-size);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .foot p:not(.foot__line) {
    margin: 0;
  }
  .foot__line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 0;
  }

  @media (max-width: 560px) {
    .refs li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
