---
import { normative, informative, cited } from '../../data/references';

// References cited on this page, numbered in brackets as in the thesis
// report, in the order in which the page first cites them. Each one is a
// link target.
const all = [...normative, ...informative];
const refs = cited.map((k) => all.find((r) => r.key === k)).filter((r) => r !== undefined);
---

<section class="chapter credits" id="references" aria-labelledby="references-h">
  <div class="wrap">
    <p class="sec"><span>End matter</span></p>
    <h2 id="references-h">References</h2>

    <ol class="refs">
      {
        refs.map((r, i) => (
          <li id={`ref-${r.key}`}>
            <span class="refs__key">[{i + 1}]</span>
            <span>
              {r.url ? (
                <a href={r.url} target="_blank" rel="noreferrer">
                  {r.text}
                </a>
              ) : (
                r.text
              )}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="credits__head" id="credits">
      <p class="sec"><span>Academic context</span></p>
      <h2 id="credits-h">Credits</h2>
    </div>

    <div class="people grid-3">
      <div class="person">
        <p class="label">Author</p>
        <h3>Jorge Pablo Trías Posa</h3>
        <p class="small">
          Master’s Degree in Cybersecurity and Cyberintelligence<br />
          Polytechnic University of Valencia&nbsp;(UPV)
        </p>
        <p class="links">
          <a href="https://orcid.org/0009-0005-8226-8071" target="_blank" rel="noreferrer">ORCID</a>
          <a href="mailto:jptripos@upv.edu.es">jptripos@upv.edu.es</a>
        </p>
      </div>

      <div class="person">
        <p class="label">Thesis supervisor</p>
        <h3>Dr. Mario Aragonés Lozano</h3>
        <p class="small">
          <a class="plain" href="https://www.upv.es/entidades/etsit/" target="_blank" rel="noreferrer"
            >Higher Technical School of Telecommunication Engineering&nbsp;(ETSIT)</a
          ><br />
          Polytechnic University of Valencia&nbsp;(UPV)
        </p>
        <p class="links">
          <a href="https://www.upv.es/ficha-personal/maarlo9" target="_blank" rel="noreferrer"
            >Profile and publications</a
          >
        </p>
      </div>

      <div class="person">
        <p class="label">Project</p>
        <h3>PolarisChain</h3>
        <p class="small">
          Ongoing research since 2026, born as a master’s thesis and continuing as doctoral research.
        </p>
        <p class="links">
          <a href="https://github.com/ptposa/polarischain-web" target="_blank" rel="noreferrer"
            >Source of this site</a
          >
        </p>
      </div>
    </div>

    <footer class="foot">
      <p>
        This page is a public overview of research in progress whose authoritative text is the thesis report, so laboratory results are described as planned unless a date says that they were run. The figures adapt the diagrams of the thesis and its annexes.
      </p>
      <p class="foot__licence">
        The thesis report and its annexes, and the text and figures of this page, are licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noreferrer">CC&nbsp;BY&nbsp;4.0</a>, and the source code of the site under the <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="license noreferrer">Apache License&nbsp;2.0</a>. When reusing the CC&nbsp;BY material, credit it as <span class="foot__cite">Jorge Pablo Trías Posa · PolarisChain, 2026 · polarischain.org · CC&nbsp;BY&nbsp;4.0</span>. All typefaces are under the SIL Open Font License.
      </p>
      <p class="foot__line">
        <span>PolarisChain · Jorge Pablo Trías Posa · 2026</span>
        <a href="#top">Back to the sky</a>
      </p>
    </footer>
  </div>
</section>

<style>
  .credits h2 {
    margin-bottom: 2rem;
  }

  .credits__head {
    margin-top: var(--section-gap);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .refs {
    max-width: var(--table);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .refs li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.6rem;
    padding: 0.45rem 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-soft);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .refs li:target {
    color: var(--text-strong);
  }
  .refs li:target .refs__key {
    color: var(--brass);
  }
  .refs a {
    color: inherit;
    text-decoration: none;
  }
  .refs a:hover {
    color: var(--link-hover);
  }
  .refs__key {
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .person h3 {
    font-size: 1.35rem;
  }
  .person .small {
    margin: 0.3rem 0 0;
    color: var(--text-soft);
  }
  .person .small a.plain {
    color: inherit;
    text-decoration: none;
  }
  .person .small a.plain:hover {
    color: var(--link-hover);
  }
  .person .label {
    margin: 0 0 0.6rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    margin: 0.8rem 0 0;
    font-family: var(--font-figure);
    font-size: 0.875rem;
  }

  .foot {
    max-width: var(--table);
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-figure);
    font-size: var(--small-size);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .foot p:not(.foot__line) {
    margin: 0;
  }
  .foot p.foot__licence {
    margin-top: 0.8rem;
  }
  .foot__licence a {
    color: inherit;
  }
  .foot__licence a:hover {
    color: var(--link-hover);
  }
  .foot__cite {
    color: var(--text-soft);
  }
  .foot__line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 0;
  }

  @media (max-width: 560px) {
    .refs li {
      grid-template-columns: 2.2rem 1fr;
      gap: 0.4rem;
    }
  }
</style>
