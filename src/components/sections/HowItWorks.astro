---
import Chapter from '../Chapter.astro';
import PathDiscovery from '../PathDiscovery.astro';

const steps = [
  {
    title: 'Present',
    text: 'A peer presents its certificate inside the mTLS handshake, and the receiver starts from its own anchors and builds the path from the graph it compiled, so neither the foreign root nor the chain that the peer sends decides anything.',
  },
  {
    title: 'Admit',
    text: 'The search walks only the receiver’s subgraph: every key at or above the floor <span class="m">τ<sub>d</sub></span>, <span class="m">Φ</span> composed edge by edge, the purposes <span class="m">σ<sub>d</sub></span> allowed, and every certificate held good by the list of the key that issued it, entitled to sign it on that path.',
  },
  {
    title: 'Prefer',
    text: 'Among the admissible paths the receiver prefers the one of least cost <span class="m">W<sub>d</sub></span>, measured in octet-equivalents, and <span class="m">Sel</span> makes that choice unique.',
  },
  {
    title: 'Validate',
    text: 'The selected path is the only one validated explicitly with a standard library, and if anything is missing or differs the connection is denied, with Audit recording which of seven outcomes it was.',
  },
];
---

<Chapter id="how-it-works" num="7" kicker="Path discovery" title="From a presented certificate to an admissible path">
  <div class="hiw">
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="steps__n">{i + 1}</span>
            <div>
              <h3>{s.title}</h3>
              <p class="small" set:html={s.text} />
            </div>
          </li>
        ))
      }
      <li class="steps__note">
        <p class="small">
          Crossings always link intermediate CAs, so the root of the origin domain is never on the path and{' '}
          <strong>the relying party does not need to trust it</strong>.
        </p>
      </li>
    </ol>

    <div class="hiw__live">
      <PathDiscovery />
    </div>
  </div>
</Chapter>

<style>
  .hiw {
    display: grid;
    grid-template-columns: minmax(0, 23rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: 1rem;
  }

  .hiw__live {
    min-width: 0;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.6rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule);
  }

  .steps__n {
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--brass);
  }

  .steps h3 {
    margin-bottom: 0.3rem;
    font-size: 1.25rem;
  }

  .steps .small {
    margin: 0;
  }

  .steps li.steps__note {
    display: block;
    padding-top: 1.4rem;
  }

  .steps__note .small {
    color: var(--text-soft);
  }

  @media (max-width: 960px) {
    .hiw {
      grid-template-columns: minmax(0, 1fr);
    }
    .hiw__live {
      order: -1;
      max-width: 40rem;
    }
  }
</style>
