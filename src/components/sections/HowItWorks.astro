---
import Chapter from '../Chapter.astro';
import PathDiscovery from '../PathDiscovery.astro';

const steps = [
  {
    title: 'Present',
    text: 'A server presents its certificate inside the mTLS handshake. The receiver starts from its own anchors, never from the foreign root.',
  },
  {
    title: 'Admit',
    text: 'The search walks only the admissible subgraph: Φ composed hop by hop, every hop under the threshold τ<sub>d</sub>, the purposes σ<sub>d</sub> allowed.',
  },
  {
    title: 'Prefer',
    text: 'Among the admissible paths, the one of least cost w<sub>d</sub>, with a deterministic tie-break.',
  },
  {
    title: 'Validate',
    text: 'The selected path is validated explicitly with a standard library. If anything is missing or differs, the connection is denied with its reason.',
  },
];
---

<Chapter id="how-it-works" num="06" kicker="How it works" title="From a presented certificate to an admissible path.">
  <div class="hiw">
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <p class="small" set:html={s.text} />
            </div>
          </li>
        ))
      }
      <li class="steps__note">
        <p class="small">
          Crossings always link intermediate CAs. The root of the origin domain is never on the path:
          <strong>the relying party does not need to trust it</strong>.
        </p>
      </li>
    </ol>

    <div class="hiw__live">
      <PathDiscovery />
    </div>
  </div>
</Chapter>

<style>
  .hiw {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: 1rem;
  }

  .hiw__live {
    min-width: 0;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.6rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule);
  }

  .steps__n {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ieee-cyan-50);
    padding-top: 0.3rem;
  }

  .steps h3 {
    margin-bottom: 0.3rem;
    font-size: 1.15rem;
  }

  .steps .small {
    margin: 0;
  }

  .steps li.steps__note {
    display: block;
    padding-top: 1.4rem;
  }

  .steps__note .small {
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .hiw {
      grid-template-columns: minmax(0, 1fr);
    }
    .hiw__live {
      order: -1;
      max-width: 40rem;
    }
  }
</style>
