---
// The mark is imported straight out of public/ so it has a single source of
// truth: the same file is served verbatim as the favicon (see BaseLayout).
import logoUrl from '../../public/logo.svg?url';

const links = [
  { href: '#motivation', label: 'Motivation' },
  { href: '#gap', label: 'Gap' },
  { href: '#model', label: 'Model' },
  { href: '#threats', label: 'Threat model' },
  { href: '#admission', label: 'Admission' },
  { href: '#laboratory', label: 'Laboratory' },
  { href: '#limits', label: 'Limits' },
  { href: '#references', label: 'References' },
];
---

<header class="site-header" data-site-header data-state="top">
  <div class="site-header__inner">
    <a href="#top" class="brand" aria-label="PolarisChain, back to the top">
      <img src={logoUrl} class="brand__logo" alt="" width="24" height="24" />
      <span class="brand__name">PolarisChain</span>
    </a>
    <nav class="nav" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>


<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      opacity 0.3s,
      transform 0.3s;
  }

  .site-header[data-state='hidden'] {
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }

  .site-header[data-state='solid'] {
    background: rgba(2, 11, 28, 0.95);
    border-bottom-color: var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(var(--wide), 100% - 2 * var(--gutter));
    height: 100%;
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text-strong);
  }

  .brand__logo {
    width: auto;
    height: 22px;
  }

  .brand__name {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  .nav {
    display: flex;
    gap: 1.6rem;
    white-space: nowrap;
  }

  /* The small capitals of the text face, as in the status of a result,
     small and tracked like the running head of a book. */
  .nav a {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--text);
  }

  /* Tablets keep the navigation: tighter, and with the mark alone. */
  @media (max-width: 1040px) {
    .nav {
      gap: 0.95rem;
    }
    .nav a {
      letter-spacing: 0.05em;
    }
  }
  @media (max-width: 880px) {
    .brand__name {
      display: none;
    }
    .nav {
      gap: 0.75rem;
    }
  }
  /* Phones have no room for eight links in one line. */
  @media (max-width: 719px) {
    .nav {
      display: none;
    }
    .brand__name {
      display: inline;
    }
  }
</style>
