---
// The mark is imported straight out of public/ so it has a single source of
// truth: the same file is served verbatim as the favicon (see BaseLayout).
import logoUrl from '../../public/logo.svg?url';

const links = [
  { href: '#motivation', label: 'Motivation' },
  { href: '#proposal', label: 'Proposal' },
  { href: '#model', label: 'Model' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#laboratory', label: 'Laboratory' },
  { href: '#credits', label: 'Credits' },
];
---

<header class="site-header" data-site-header data-state="top">
  <div class="site-header__inner">
    <a href="#top" class="brand" aria-label="PolarisChain, back to the top">
      <img src={logoUrl} class="brand__logo" alt="" width="28" height="28" />
      <span class="brand__name">PolarisChain</span>
    </a>
    <div class="right">
      <nav class="nav" aria-label="Sections">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="palette-switch" role="group" aria-label="Colour palette" data-palette-switch>
        <button type="button" data-palette-choice="0" aria-pressed="true" title="Current">0</button>
        <button type="button" data-palette-choice="1" aria-pressed="false" title="Sand">1</button>
        <button type="button" data-palette-choice="2" aria-pressed="false" title="Default, softer title yellow">2</button>
        <button type="button" data-palette-choice="3" aria-pressed="false" title="Apricot">3</button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      opacity 0.3s,
      transform 0.3s;
  }

  .site-header[data-state='hidden'] {
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }

  .site-header[data-state='solid'] {
    background: rgba(2, 11, 28, 0.94);
    border-bottom-color: var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(var(--wide), 100% - 2 * var(--gutter));
    height: 100%;
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text-strong);
  }

  .brand__logo {
    width: auto;
    height: 26px;
  }

  .brand__name {
    font-family: var(--font-figure);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  .nav {
    display: flex;
    gap: 1.6rem;
  }

  /* Provisional: goes once a palette is chosen. */
  .palette-switch {
    display: inline-flex;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    overflow: hidden;
  }

  .palette-switch button {
    padding: 0.28rem 0.62rem;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .palette-switch button[aria-pressed='true'] {
    background: rgba(255, 212, 106, 0.14);
    color: var(--ieee-yellow-75);
  }

  .nav a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--text-soft);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
  }
</style>
