---
import {
  academicCardItemClasses,
  floatingAcademicCardLayoutClasses,
  academicCardListClasses,
  academicCardTermClasses,
  academicCardTitleClasses,
  academicCardValueClasses,
  buttonBaseClasses,
  buttonPrimaryClasses,
  buttonSecondaryClasses,
  floatingAcademicCardClasses,
} from "../lib/ui";

type PrimaryNodeId = "target" | "issuing" | "bridge" | "external" | "anchor";
type AmbientNodeId = `a${number}`;
type NodeId = PrimaryNodeId | AmbientNodeId;

type NodeMeta = {
  policy: string;
  crypto: string;
  score: string;
};

type PrimaryNode = {
  id: PrimaryNodeId;
  label: string[];
  x: number;
  y: number;
  type: PrimaryNodeId;
  meta: NodeMeta;
  card?: {
    x: number;
    y: number;
  };
};

type AmbientNode = {
  id: AmbientNodeId;
  x: number;
  y: number;
  size: "tiny" | "small";
};

type GraphNode = PrimaryNode | AmbientNode;
type GraphLink = readonly [NodeId, NodeId];

const graphFrame = { x: 150, y: 110, width: 880, height: 310 };

const primaryNodes: PrimaryNode[] = [
  {
    id: "target",
    label: ["Target certificate"],
    x: 220,
    y: 314,
    type: "target",
    meta: {
      policy: "Leaf authentication policy",
      crypto: "End-entity RSA-3072",
      score: "N/A",
    },
    card: { x: 232, y: 344 },
  },
  {
    id: "issuing",
    label: ["Issuing CA"],
    x: 382,
    y: 246,
    type: "issuing",
    meta: {
      policy: "Enterprise issuance policy",
      crypto: "RSA-4096",
      score: "0.81",
    },
  },
  {
    id: "bridge",
    label: ["Federated", "bridge CA"],
    x: 544,
    y: 206,
    type: "bridge",
    meta: {
      policy: "Cross-domain trust policy",
      crypto: "Hybrid RSA/PQC",
      score: "0.89",
    },
  },
  {
    id: "external",
    label: ["External", "trust CA"],
    x: 690,
    y: 286,
    type: "external",
    meta: {
      policy: "Federated validation policy",
      crypto: "ML-DSA",
      score: "0.93",
    },
  },
  {
    id: "anchor",
    label: ["Trust anchor"],
    x: 826,
    y: 190,
    type: "anchor",
    meta: {
      policy: "Root governance policy",
      crypto: "PQC-Ready",
      score: "0.97",
    },
  },
];

const ambientNodes: AmbientNode[] = [
  { id: "a1", x: 170, y: 230, size: "tiny" },
  { id: "a2", x: 206, y: 402, size: "tiny" },
  { id: "a3", x: 252, y: 182, size: "small" },
  { id: "a4", x: 286, y: 374, size: "small" },
  { id: "a5", x: 318, y: 122, size: "tiny" },
  { id: "a6", x: 336, y: 432, size: "tiny" },
  { id: "a7", x: 410, y: 154, size: "small" },
  { id: "a8", x: 430, y: 344, size: "small" },
  { id: "a9", x: 466, y: 258, size: "tiny" },
  { id: "a10", x: 492, y: 392, size: "tiny" },
  { id: "a11", x: 522, y: 130, size: "small" },
  { id: "a12", x: 586, y: 150, size: "tiny" },
  { id: "a13", x: 610, y: 364, size: "small" },
  { id: "a14", x: 646, y: 120, size: "tiny" },
  { id: "a15", x: 652, y: 240, size: "small" },
  { id: "a16", x: 684, y: 380, size: "tiny" },
  { id: "a17", x: 748, y: 148, size: "small" },
  { id: "a18", x: 754, y: 332, size: "small" },
  { id: "a19", x: 806, y: 270, size: "tiny" },
  { id: "a20", x: 832, y: 362, size: "small" },
  { id: "a21", x: 890, y: 236, size: "small" },
  { id: "a22", x: 926, y: 144, size: "tiny" },
  { id: "a23", x: 952, y: 314, size: "small" },
  { id: "a24", x: 998, y: 200, size: "tiny" },
  { id: "a25", x: 1018, y: 292, size: "small" },
  { id: "a26", x: 1042, y: 126, size: "tiny" },
  { id: "a27", x: 1060, y: 356, size: "tiny" },
  { id: "a28", x: 1106, y: 228, size: "small" },
  { id: "a29", x: 1134, y: 166, size: "tiny" },
  { id: "a30", x: 1162, y: 304, size: "small" },
  { id: "a35", x: 268, y: 226, size: "tiny" },
  { id: "a36", x: 310, y: 176, size: "tiny" },
  { id: "a38", x: 364, y: 404, size: "tiny" },
  { id: "a40", x: 420, y: 214, size: "tiny" },
  { id: "a43", x: 522, y: 246, size: "tiny" },
  { id: "a46", x: 614, y: 204, size: "tiny" },
  { id: "a48", x: 672, y: 164, size: "tiny" },
  { id: "a49", x: 702, y: 240, size: "tiny" },
  { id: "a51", x: 762, y: 194, size: "tiny" },
  { id: "a53", x: 824, y: 132, size: "tiny" },
  { id: "a54", x: 846, y: 214, size: "tiny" },
  { id: "a57", x: 950, y: 352, size: "tiny" },
  { id: "a59", x: 1012, y: 238, size: "tiny" },
  { id: "a63", x: 1144, y: 134, size: "tiny" },
];

const nodeMap: Record<NodeId, GraphNode> = Object.fromEntries(
  [...primaryNodes, ...ambientNodes].map((node) => [node.id, node]),
 ) as Record<NodeId, GraphNode>;

const ambientLinks: GraphLink[] = [
  ["a1", "target"],
  ["a3", "issuing"],
  ["a3", "a7"],
  ["a4", "target"],
  ["a4", "a8"],
  ["a5", "a7"],
  ["a6", "a4"],
  ["a7", "issuing"],
  ["a7", "bridge"],
  ["a8", "bridge"],
  ["a8", "a13"],
  ["a9", "bridge"],
  ["a10", "a13"],
  ["a11", "bridge"],
  ["a11", "a14"],
  ["a12", "external"],
  ["a13", "external"],
  ["a14", "external"],
  ["a15", "external"],
  ["a16", "a20"],
  ["a17", "anchor"],
  ["a17", "a21"],
  ["a18", "anchor"],
  ["a18", "a23"],
  ["a19", "anchor"],
  ["a20", "a23"],
  ["a21", "a24"],
  ["a22", "a24"],
  ["a23", "a25"],
  ["a24", "a28"],
  ["a25", "a28"],
  ["a26", "a29"],
  ["a27", "a30"],
  ["a28", "a29"],
  ["a28", "a30"],
];

const primaryLinks: GraphLink[] = [
  ["target", "issuing"],
  ["issuing", "bridge"],
  ["bridge", "external"],
  ["external", "anchor"],
];

function linkPath(fromId: NodeId, toId: NodeId) {
  const from = nodeMap[fromId];
  const to = nodeMap[toId];
  return `M ${from.x} ${from.y} L ${to.x} ${to.y}`;
}

const cardOffsets: Record<PrimaryNodeId, { x: number; y: number }> = {
  target: { x: 28, y: -170 },
  issuing: { x: 57, y: -10 },
  bridge: { x: 30, y: 150 },
  external: { x: 55, y: -82 },
  anchor: { x: 80, y: 82 },
};

function cardStyle(node: PrimaryNode) {
  const offset = cardOffsets[node.type];
  return `--card-x:${(((node.card?.x ?? node.x) - graphFrame.x) / graphFrame.width) * 100}%; --card-y:${(((node.card?.y ?? node.y) - graphFrame.y) / graphFrame.height) * 100}%; --card-offset-x:${offset.x}px; --card-offset-y:${offset.y}px;`;
}
---

<section class="pki-hero" id="top">
  <div class="pki-hero-track">
    <div class="pki-hero-backdrop" aria-hidden="true"></div>
    <div class="pki-hero-starfield" aria-hidden="true"></div>
    <div class="pki-hero-overlay" aria-hidden="true"></div>
    <div class="pki-hero-mobile-sweep" aria-hidden="true"></div>

    <div class="container pki-hero-shell">
      <div class="pki-hero-copy">
        <h1>Navigating trust across federated PKI ecosystems</h1>
        <p class="pki-hero-lead">
          A research-driven platform for formal graph-based modeling of governed trust, enabling optimal trust path discovery and crypto-agile interoperability across federated PKI ecosystems.
        </p>
        <p class="pki-hero-body">
          PolarisChain formalizes certification authorities and federation
          relationships as a governed weighted graph, enabling deterministic and
          explainable trust-path computation across classical, hybrid, and
          post-quantum environments without replacing PKIX validation semantics.
        </p>

        <div class="pki-hero-actions">
          <a class={`${buttonBaseClasses} ${buttonPrimaryClasses}`} href="#research">
            Explore research
          </a>
          <a class={`${buttonBaseClasses} ${buttonSecondaryClasses}`} href="/docs">
            Read documentation
          </a>
        </div>

        <div class="pki-hero-byline" aria-label="Author and academic context">
          <p><span>Author:</span> Jorge Pablo Trías Posa</p>
          <p><span>Email:</span> jptripos@etsinf.upv.es</p>
          <p><span>Institution:</span> Polytechnic University of Valencia</p>
          <p><span>Thesis supervisor:</span> Mario Aragonés Lozano</p>
          <p><span>Thesis supervisor email:</span> maragones@teleco.upv.es</p>
          <p><span>Academic context:</span> Master’s thesis with progress toward a PhD</p>
        </div>
      </div>

      <div class="pki-hero-graph-wrap">
        <svg
          id="pki-hero-graph"
          class="pki-hero-graph"
          viewBox={`${graphFrame.x} ${graphFrame.y} ${graphFrame.width} ${graphFrame.height}`}
          role="img"
          aria-label="Federated PKI graph with optimal trust path"
        >
          <defs>
            <radialGradient id="pkiPathGlow" cx="50%" cy="50%" r="55%">
              <stop offset="0%" stop-color="rgba(212, 233, 255, 0.34)" />
              <stop offset="100%" stop-color="rgba(212, 233, 255, 0)" />
            </radialGradient>
          </defs>

          <g class="pki-ambient-links">
            {ambientLinks.map(([from, to]) => (
              <path
                class={`pki-link ${from.startsWith("a") && to.startsWith("a") ? "is-dim" : "is-structural"}`}
                d={linkPath(from, to)}
              />
            ))}
          </g>

          <g class="pki-primary-links">
            {primaryLinks.map(([from, to], index) => (
              <path
                class="pki-primary-link"
                data-path-link
                data-step={index + 1}
                d={linkPath(from, to)}
              />
            ))}
          </g>

          <g class="pki-ambient-nodes">
            {ambientNodes.map((node) => (
              <circle
                class={`pki-node pki-node-ambient ${node.size === "tiny" ? "is-tiny" : "is-small"}`}
                cx={node.x}
                cy={node.y}
                r={node.size === "tiny" ? 2.9 : 5.2}
              />
            ))}
          </g>

          <g class="pki-primary-nodes">
            {primaryNodes.map((node, index) => (
              <g class="pki-primary-node-group" data-path-node-group data-step={index + 1}>
                <circle
                  class="pki-node-halo"
                  data-node-halo
                  cx={node.x}
                  cy={node.y}
                  r={node.type === "anchor" ? 32 : 24}
                />
                <circle
                  class={`pki-node pki-node-primary is-${node.type}`}
                  data-path-node
                  cx={node.x}
                  cy={node.y}
                  r={node.type === "anchor" ? 9.5 : 8}
                />
                <g class="pki-node-label">
                  {node.label.map((line, lineIndex) => (
                    <text
                      x={node.x + (node.type === "target" ? -50 : node.type === "anchor" ? -34 : -28)}
                      y={node.y + (node.type === "target" ? 38 : node.type === "anchor" ? -22 : -22) + lineIndex * 20}
                    >
                      {line}
                    </text>
                  ))}
                </g>
              </g>
            ))}
          </g>
        </svg>

        <div class={`pki-node-cards ${floatingAcademicCardLayoutClasses}`} aria-hidden="true">
          {primaryNodes.map((node, index) => (
            <article
              class={floatingAcademicCardClasses}
              data-node-card
              data-step={index + 1}
              style={cardStyle(node)}
            >
              <span class={academicCardTitleClasses}>{node.label[0]}</span>
              {node.label[1] ? <span class={academicCardTitleClasses}>{node.label[1]}</span> : null}
              <dl class={academicCardListClasses}>
                <div class={academicCardItemClasses}>
                  <dt class={academicCardTermClasses}>Policy</dt>
                  <dd class={academicCardValueClasses}>{node.meta.policy}</dd>
                </div>
                <div class={academicCardItemClasses}>
                  <dt class={academicCardTermClasses}>Crypto</dt>
                  <dd class={academicCardValueClasses}>{node.meta.crypto}</dd>
                </div>
                <div class={academicCardItemClasses}>
                  <dt class={academicCardTermClasses}>Trust score</dt>
                  <dd class={academicCardValueClasses}>{node.meta.score}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pki-hero {
    position: relative;
    min-height: 200vh;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background:
      radial-gradient(circle at 68% 30%, rgba(100, 135, 185, 0.12), transparent 22%),
      radial-gradient(circle at 86% 22%, rgba(212, 231, 255, 0.07), transparent 16%),
      linear-gradient(180deg, #070b13 0%, #0b1018 100%);
    overflow: clip;
  }

  .pki-hero-track {
    position: relative;
    min-height: 100vh;
    overflow: clip;
  }

  .pki-hero-backdrop,
  .pki-hero-starfield,
  .pki-hero-overlay,
  .pki-hero-mobile-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pki-hero-backdrop {
    opacity: 0.24;
    background-image:
      radial-gradient(circle at 8% 14%, rgba(255, 255, 255, 0.42) 0 1px, transparent 1.6px),
      radial-gradient(circle at 12% 22%, rgba(255, 255, 255, 0.78) 0 1px, transparent 1.6px),
      radial-gradient(circle at 22% 12%, rgba(255, 255, 255, 0.4) 0 1px, transparent 1.5px),
      radial-gradient(circle at 28% 34%, rgba(255, 255, 255, 0.36) 0 1px, transparent 1.5px),
      radial-gradient(circle at 42% 30%, rgba(255, 255, 255, 0.52) 0 1px, transparent 1.5px),
      radial-gradient(circle at 56% 16%, rgba(255, 255, 255, 0.38) 0 1px, transparent 1.6px),
      radial-gradient(circle at 74% 26%, rgba(255, 255, 255, 0.56) 0 1px, transparent 1.6px),
      radial-gradient(circle at 82% 44%, rgba(255, 255, 255, 0.34) 0 1px, transparent 1.6px),
      radial-gradient(circle at 88% 62%, rgba(255, 255, 255, 0.44) 0 1px, transparent 1.6px),
      radial-gradient(circle at 94% 20%, rgba(255, 255, 255, 0.32) 0 1px, transparent 1.6px);
    background-size:
      320px 320px,
      520px 520px,
      360px 360px,
      420px 420px,
      640px 640px,
      460px 460px,
      700px 700px,
      540px 540px,
      760px 760px,
      620px 620px;
  }

  .pki-hero-starfield {
    opacity: 0.34;
    background-image:
      radial-gradient(circle at 8% 12%, rgba(255, 255, 255, 0.46) 0 1px, transparent 1.7px),
      radial-gradient(circle at 14% 28%, rgba(255, 255, 255, 0.4) 0 1px, transparent 1.7px),
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.62) 0 1px, transparent 1.7px),
      radial-gradient(circle at 22% 44%, rgba(255, 255, 255, 0.34) 0 1px, transparent 1.7px),
      radial-gradient(circle at 28% 14%, rgba(255, 255, 255, 0.36) 0 1px, transparent 1.7px),
      radial-gradient(circle at 34% 58%, rgba(255, 255, 255, 0.42) 0 1px, transparent 1.8px),
      radial-gradient(circle at 42% 32%, rgba(255, 255, 255, 0.32) 0 1px, transparent 1.8px),
      radial-gradient(circle at 50% 16%, rgba(255, 255, 255, 0.28) 0 1px, transparent 1.8px),
      radial-gradient(circle at 58% 24%, rgba(255, 255, 255, 0.48) 0 1px, transparent 1.8px),
      radial-gradient(circle at 66% 52%, rgba(255, 255, 255, 0.3) 0 1px, transparent 1.8px),
      radial-gradient(circle at 72% 72%, rgba(255, 255, 255, 0.36) 0 1px, transparent 1.8px),
      radial-gradient(circle at 82% 22%, rgba(255, 255, 255, 0.28) 0 1px, transparent 1.8px),
      radial-gradient(circle at 92% 34%, rgba(255, 255, 255, 0.4) 0 1px, transparent 1.8px);
    background-size:
      120px 120px,
      160px 160px,
      220px 220px,
      180px 180px,
      240px 240px,
      280px 280px,
      320px 320px,
      360px 360px,
      420px 420px,
      460px 460px,
      520px 520px,
      560px 560px,
      620px 620px;
    mix-blend-mode: screen;
  }

  .pki-hero-overlay {
    background:
      linear-gradient(90deg, rgba(6, 10, 17, 0.9) 0%, rgba(7, 11, 18, 0.8) 22%, rgba(8, 12, 20, 0.5) 42%, rgba(8, 12, 20, 0.12) 62%, rgba(8, 12, 20, 0) 76%);
  }

  .pki-hero-mobile-sweep {
    display: none;
    z-index: 1;
    inset: auto -30% -20% -30%;
    height: 56%;
    opacity: 0;
    background:
      radial-gradient(circle at 50% 72%, rgba(222, 239, 255, 0.17) 0%, rgba(164, 204, 245, 0.1) 24%, rgba(94, 136, 184, 0.05) 48%, rgba(8, 12, 20, 0) 80%),
      linear-gradient(180deg, rgba(226, 239, 255, 0) 0%, rgba(187, 214, 243, 0.04) 58%, rgba(214, 232, 255, 0.1) 100%);
    filter: blur(34px);
    mix-blend-mode: screen;
    transform: translate3d(0, 0, 0);
  }

  .pki-hero-shell {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1.32fr);
    align-items: center;
    gap: 22px;
    padding: 90px 0 68px;
  }

  .pki-hero-copy {
    position: relative;
    z-index: 3;
    max-width: 700px;
    padding-right: 0;
  }

  .pki-hero-kicker {
    display: inline-block;
    margin-bottom: 18px;
    color: rgba(198, 190, 178, 0.82);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
  }

  .pki-hero-copy h1 {
    margin: 0;
    max-width: 12ch;
    color: #f4efe5;
    font-family: "Playfair Display", serif;
    font-size: clamp(3.4rem, 6.5vw, 5.8rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .pki-hero-lead {
    margin: 30px 0 0;
    max-width: 54ch;
    color: rgba(242, 236, 227, 0.95);
    font-family: "Playfair Display", serif;
    font-size: clamp(1.55rem, 2.2vw, 2rem);
    line-height: 1.1;
  }

  .pki-hero-body {
    margin: 24px 0 0;
    max-width: 54ch;
    color: rgba(211, 203, 191, 0.82);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 1.03rem;
    line-height: 1.82;
  }

  .pki-hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 34px;
  }

  .pki-hero-byline {
    margin-top: 50px;
    margin-bottom: 28px;
    display: grid;
    gap: 4px;
    max-width: 56ch;
  }

  .pki-hero-byline p {
    margin: 0;
    font-family: "Inter", system-ui, sans-serif;
    color: rgba(196, 189, 179, 0.62);
    font-size: 0.86rem;
    line-height: 1.55;
    letter-spacing: 0.01em;
  }

  .pki-hero-byline span {
    color: rgba(230, 224, 214, 0.8);
    margin-right: 4px;
  }

  .pki-hero-graph-wrap {
    position: relative;
    min-height: 620px;
    margin-top: 28px;
    margin-left: 8px;
    contain: paint;
  }

  .pki-hero-graph {
    display: block;
    width: min(118%, 1120px);
    height: auto;
    margin-left: 0;
    margin-right: -18px;
    overflow: visible;
  }

  .pki-link {
    fill: none;
    stroke: rgba(189, 205, 223, 0.16);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .pki-link.is-dim {
    opacity: 0.55;
  }

  .pki-link.is-structural {
    opacity: 0.8;
  }

  .pki-primary-link {
    fill: none;
    stroke: rgba(223, 236, 255, 0.96);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgba(210, 230, 255, 0.18));
  }

  .pki-node {
    transform-origin: center;
  }

  .pki-node-ambient {
    fill: rgba(231, 237, 246, 0.74);
    filter: drop-shadow(0 0 4px rgba(227, 235, 246, 0.14));
  }

  .pki-node-ambient.is-tiny {
    opacity: 0.72;
  }

  .pki-node-ambient.is-small {
    opacity: 0.88;
  }

  .pki-node-primary {
    fill: rgba(213, 226, 241, 0.72);
    filter: drop-shadow(0 0 6px rgba(205, 225, 245, 0.14));
  }

  .pki-node-primary.is-anchor {
    fill: rgba(241, 247, 255, 0.82);
    filter: drop-shadow(0 0 10px rgba(219, 235, 255, 0.24));
  }

  .pki-node-halo {
    fill: url(#pkiPathGlow);
    opacity: 0;
    transform-origin: center;
  }

  .pki-node-label text {
    fill: rgba(239, 234, 224, 0.96);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.01em;
    filter: drop-shadow(0 2px 6px rgba(7, 11, 18, 0.72));
  }

  @media (max-width: 1080px) {
    .pki-hero {
      min-height: 172vh;
    }

    .pki-hero-shell {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .pki-hero-copy,
    .pki-hero-lead,
    .pki-hero-body {
      max-width: none;
    }

    .pki-hero-copy h1 {
      max-width: none;
    }

    .pki-hero-graph-wrap {
      margin-left: 0;
      min-height: 520px;
    }

    .pki-hero-graph {
      width: 106%;
      margin: 0 -18px 0 0;
    }

  }

  @media (max-width: 760px) {
    .pki-hero {
      min-height: auto;
    }

    .pki-hero-mobile-sweep {
      display: block;
      filter: blur(24px);
    }

    .pki-hero-shell {
      min-height: auto;
      padding: 42px 0 48px;
    }

    .pki-hero-overlay {
      background:
        linear-gradient(180deg, rgba(6, 10, 17, 0.84) 0%, rgba(7, 11, 18, 0.7) 34%, rgba(8, 12, 20, 0.16) 66%, rgba(8, 12, 20, 0) 100%);
    }

    .pki-hero-backdrop {
      opacity: 0.16;
    }

    .pki-hero-starfield {
      opacity: 0.2;
    }

    .pki-hero-copy {
      padding-right: 0;
    }

    .pki-hero-copy h1 {
      font-size: clamp(2.95rem, 13vw, 4.4rem);
      line-height: 1.03;
    }

    .pki-hero-lead {
      margin-top: 34px;
      font-size: 1.42rem;
      line-height: 1.15;
    }

    .pki-hero-body {
      font-size: 1rem;
      line-height: 1.72;
    }

    .pki-hero-byline {
      margin-top: 40px;
      margin-bottom: 22px;
    }

    .pki-hero-byline p {
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .pki-hero-graph-wrap {
      min-height: auto;
      margin-top: 34px;
    }

    .pki-hero-graph {
      width: 100%;
      margin: 0;
    }

    .pki-node-label text {
      font-size: 13px;
      filter: none;
    }

    .pki-ambient-links .pki-link.is-dim,
    .pki-ambient-nodes .pki-node-ambient.is-tiny {
      display: none;
    }

    .pki-ambient-links .pki-link.is-structural {
      opacity: 0.36;
    }

    .pki-node-ambient.is-small {
      opacity: 0.52;
      filter: none;
    }

    .pki-primary-link,
    .pki-node-primary,
    .pki-node-primary.is-anchor {
      filter: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (typeof window !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector(".pki-hero");
    if (section instanceof HTMLElement) {
      const track = section.querySelector(".pki-hero-track");
      const graphWrap = section.querySelector(".pki-hero-graph-wrap");
      const graph = section.querySelector("#pki-hero-graph");
      const ambientNodes = Array.from(section.querySelectorAll(".pki-node-ambient"));
      const primaryNodes = Array.from(section.querySelectorAll("[data-path-node]"));
      const primaryLinks = Array.from(section.querySelectorAll("[data-path-link]"));
      const halos = Array.from(section.querySelectorAll("[data-node-halo]"));
      const cards = Array.from(section.querySelectorAll("[data-node-card]"));
      const mobileSweep = section.querySelector(".pki-hero-mobile-sweep");

      if (
        track instanceof HTMLElement &&
        graphWrap instanceof HTMLElement &&
        graph instanceof SVGSVGElement &&
        primaryNodes.length &&
        primaryLinks.length &&
        halos.length &&
        cards.length
      ) {
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const motionTargets = [...primaryNodes, ...halos, ...cards];

        primaryLinks.forEach((link) => {
          if (link instanceof SVGPathElement) {
            const length = link.getTotalLength();
            link.style.strokeDasharray = `${length}`;
            link.style.strokeDashoffset = `${length}`;
          }
        });

        gsap.set(primaryNodes, {
          opacity: 0.72,
          scale: 1,
          transformOrigin: "center center",
        });

        gsap.set(halos, {
          opacity: 0,
          scale: 0.62,
          transformOrigin: "center center",
        });

        gsap.set(cards, {
          opacity: 0,
          y: 16,
        });

        const clearMotionHints = () => {
          gsap.set(motionTargets, {
            clearProps: "willChange",
          });
        };

        if (prefersReducedMotion) {
          if (mobileSweep instanceof HTMLElement) {
            gsap.set(mobileSweep, {
              opacity: 0.14,
              yPercent: -12,
              scale: 1,
            });
          }

          gsap.set(primaryLinks, {
            opacity: 1,
            strokeDashoffset: 0,
          });

          primaryNodes.forEach((node, index) => {
            gsap.set(node, {
              opacity: 1,
              scale: index === primaryNodes.length - 1 ? 1.24 : 1.12,
            });
          });

          halos.forEach((halo, index) => {
            gsap.set(halo, {
              opacity: index === primaryNodes.length - 1 ? 0.82 : 0.62,
              scale: index === primaryNodes.length - 1 ? 1.18 : 1.04,
            });
          });

          gsap.set(cards, {
            opacity: 1,
            y: 0,
          });

          clearMotionHints();
        } else {
          const mm = gsap.matchMedia();

          mm.add(
            {
              light: "(max-width: 760px), (pointer: coarse)",
              desktop: "(min-width: 761px) and (pointer: fine)",
            },
            ({ conditions }) => {
              const isLightViewport = Boolean(conditions?.light);

              gsap.set(motionTargets, {
                willChange: "transform, opacity",
              });

              if (isLightViewport) {
                const mobileTimeline = gsap.timeline({
                  defaults: { ease: "power1.out" },
                  scrollTrigger: {
                    trigger: graphWrap,
                    start: "top 70%",
                    end: "bottom 81%",
                    scrub: 0.45,
                    invalidateOnRefresh: true,
                  },
                });

                if (mobileSweep instanceof HTMLElement) {
                  gsap.set(mobileSweep, {
                    opacity: 0.05,
                    yPercent: 18,
                    scale: 0.96,
                    transformOrigin: "center center",
                  });

                  mobileTimeline
                    .to(
                      mobileSweep,
                      {
                        opacity: 0.18,
                        yPercent: -28,
                        scale: 1.01,
                        duration: 0.26,
                      },
                      0
                    )
                    .to(
                      mobileSweep,
                      {
                        opacity: 0.05,
                        duration: 0.12,
                      },
                      0.18
                    );
                }

                primaryNodes.forEach((node, index) => {
                  mobileTimeline.to(
                    node,
                    {
                      opacity: 1,
                      scale: index === primaryNodes.length - 1 ? 1.2 : 1.1,
                      duration: 0.12,
                    },
                    index === 0 ? 0.04 : ">"
                  );

                  mobileTimeline.to(
                    halos[index],
                    {
                      opacity: index === primaryNodes.length - 1 ? 0.78 : 0.58,
                      scale: index === primaryNodes.length - 1 ? 1.16 : 1.04,
                      duration: 0.12,
                    },
                    "<"
                  );

                  mobileTimeline.to(
                    cards[index],
                    {
                      opacity: 1,
                      y: 0,
                      duration: 0.14,
                    },
                    "<+0.03"
                  );

                  if (index < primaryLinks.length) {
                    mobileTimeline.to(
                      primaryLinks[index],
                      {
                        opacity: 1,
                        strokeDashoffset: 0,
                        duration: 0.14,
                      },
                      "<+0.02"
                    );
                  }
                });

                mobileTimeline.eventCallback("onComplete", clearMotionHints);
                mobileTimeline.eventCallback("onReverseComplete", clearMotionHints);
                return;
              }

              const ambientPulseNodes = ambientNodes
                .filter((node) => node.classList.contains("is-small"))
                .filter((_, index) => index % 2 === 0)
                .slice(0, 8);

              if (ambientPulseNodes.length) {
                gsap.set(ambientPulseNodes, {
                  willChange: "transform, opacity",
                  transformOrigin: "center center",
                });

                gsap.to(ambientPulseNodes, {
                  opacity: 0.92,
                  scale: 1.06,
                  duration: 2.6,
                  ease: "sine.inOut",
                  yoyo: true,
                  repeat: -1,
                  stagger: {
                    each: 0.18,
                    from: "random",
                  },
                });
              }

              if (mobileSweep instanceof HTMLElement) {
                gsap.set(mobileSweep, {
                  opacity: 0,
                  yPercent: 0,
                  scale: 1,
                });
              }

              const timeline = gsap.timeline({
                defaults: { ease: "power2.out" },
                scrollTrigger: {
                  trigger: section,
                  start: "top top",
                  end: "+=1320",
                  scrub: 0.85,
                  pin: track,
                  anticipatePin: 1,
                  invalidateOnRefresh: true,
                },
              });

              primaryNodes.forEach((node, index) => {
                timeline.to(
                  node,
                  {
                    opacity: 1,
                    scale: index === primaryNodes.length - 1 ? 1.3 : 1.18,
                    duration: 0.24,
                  },
                  index === 0 ? 0.14 : ">"
                );

                timeline.to(
                  halos[index],
                  {
                    opacity: index === primaryNodes.length - 1 ? 0.9 : 0.7,
                    scale: index === primaryNodes.length - 1 ? 1.26 : 1.12,
                    duration: 0.24,
                  },
                  "<"
                );

                timeline.to(
                  cards[index],
                  {
                    opacity: 1,
                    y: 0,
                    duration: 0.28,
                  },
                  "<+0.05"
                );

                if (index < primaryLinks.length) {
                  timeline.to(
                    primaryLinks[index],
                    {
                      opacity: 1,
                      strokeDashoffset: 0,
                      duration: 0.34,
                    },
                    "<+0.02"
                  );
                }
              });
            }
          );
        }
      }
    }
  }
</script>
