---
import {
  buttonBaseClasses,
  buttonPrimaryClasses,
  buttonSecondaryClasses,
} from "../lib/ui";
---

<section class="pki-hero relative border-b border-white/[0.06] overflow-clip" id="top">
  <div class="pki-hero-track relative">
    <div class="pki-hero-backdrop absolute inset-0 pointer-events-none max-[760px]:opacity-[0.16]" aria-hidden="true"></div>
    <div class="pki-hero-starfield absolute inset-0 pointer-events-none max-[760px]:opacity-20" aria-hidden="true"></div>
    <div class="pki-hero-overlay absolute inset-0 pointer-events-none" aria-hidden="true"></div>

    <div class="container pki-hero-shell relative z-[2] min-h-screen grid grid-cols-[minmax(0,1.08fr)_minmax(0,1.32fr)] items-center gap-[22px] pt-[90px] pb-[68px] max-[1080px]:grid-cols-1 max-[760px]:min-h-0 max-[760px]:pt-[42px] max-[760px]:pb-12">

      <!-- ─── LEFT: hero copy (unchanged) ─── -->
      <div class="pki-hero-copy relative z-[3] max-w-[700px] max-[1080px]:max-w-none">
        <h1 class="m-0 max-w-[12ch] text-[#f4efe5] [font-family:'Playfair_Display',serif] text-[clamp(3.4rem,6.5vw,5.8rem)] font-normal leading-[1.02] tracking-[-0.03em] max-[1080px]:max-w-none max-[760px]:text-[clamp(2.95rem,13vw,4.4rem)] max-[760px]:leading-[1.03]">Navigating trust across federated PKI ecosystems</h1>
        <p class="pki-hero-lead mt-[22px] max-w-[54ch] text-[rgba(242,236,227,0.95)] [font-family:'Playfair_Display',serif] text-[clamp(1.55rem,2.2vw,2rem)] leading-[1.1] max-[1080px]:max-w-none max-[760px]:mt-[26px] max-[760px]:text-[1.42rem] max-[760px]:leading-[1.15]">
          A research-driven platform for formal graph-based modeling of governed trust, enabling optimal trust path discovery and crypto-agile interoperability across federated PKI ecosystems.
        </p>
        <p class="pki-hero-body mt-5 max-w-[54ch] text-[rgba(211,203,191,0.82)] [font-family:'Inter',system-ui,sans-serif] text-[1.03rem] leading-[1.66] max-[1080px]:max-w-none max-[760px]:mt-[18px] max-[760px]:text-base max-[760px]:leading-[1.58]">
          PolarisChain formalizes certification authorities and federation
          relationships as a governed weighted graph, enabling deterministic and
          explainable trust-path computation across classical, hybrid, and
          post-quantum environments without replacing PKIX validation semantics.
        </p>

        <div class="pki-hero-actions flex gap-[14px] flex-wrap mt-[34px]">
          <a class={`${buttonBaseClasses} ${buttonPrimaryClasses}`} href="#research">
            Explore research
          </a>
          <a class={`${buttonBaseClasses} ${buttonSecondaryClasses}`} href="/docs">
            Read documentation
          </a>
        </div>

        <div class="pki-hero-byline mt-[50px] mb-7 grid gap-1 max-w-[56ch] max-[760px]:mt-10 max-[760px]:mb-[22px]" aria-label="Author and academic context">
          <p class="m-0 [font-family:'Inter',system-ui,sans-serif] text-[rgba(196,189,179,0.62)] text-[0.86rem] leading-[1.55] tracking-[0.01em] max-[760px]:text-[0.8rem] max-[760px]:leading-[1.5] [&>span]:text-[rgba(230,224,214,0.8)] [&>span]:mr-1"><span>Author:</span> Jorge Pablo Trías Posa</p>
          <p class="m-0 [font-family:'Inter',system-ui,sans-serif] text-[rgba(196,189,179,0.62)] text-[0.86rem] leading-[1.55] tracking-[0.01em] max-[760px]:text-[0.8rem] max-[760px]:leading-[1.5] [&>span]:text-[rgba(230,224,214,0.8)] [&>span]:mr-1">
            <span>ORCID:</span>
            <a
              class="pki-hero-byline-link inline-flex items-center gap-2 text-[rgba(214,227,244,0.82)] no-underline transition-[color,opacity] duration-[180ms] ease-[ease] hover:text-[rgba(238,244,252,0.96)]"
              href="https://orcid.org/0009-0005-8226-8071"
              target="_blank"
              rel="noreferrer"
            >
              0009-0005-8226-8071
            </a>
          </p>
          <p class="m-0 [font-family:'Inter',system-ui,sans-serif] text-[rgba(196,189,179,0.62)] text-[0.86rem] leading-[1.55] tracking-[0.01em] max-[760px]:text-[0.8rem] max-[760px]:leading-[1.5] [&>span]:text-[rgba(230,224,214,0.8)] [&>span]:mr-1"><span>Email:</span> jptripos@etsinf.upv.es</p>
          <p class="m-0 [font-family:'Inter',system-ui,sans-serif] text-[rgba(196,189,179,0.62)] text-[0.86rem] leading-[1.55] tracking-[0.01em] max-[760px]:text-[0.8rem] max-[760px]:leading-[1.5] [&>span]:text-[rgba(230,224,214,0.8)] [&>span]:mr-1"><span>Institution:</span> Polytechnic University of Valencia</p>
          <p class="m-0 [font-family:'Inter',system-ui,sans-serif] text-[rgba(196,189,179,0.62)] text-[0.86rem] leading-[1.55] tracking-[0.01em] max-[760px]:text-[0.8rem] max-[760px]:leading-[1.5] [&>span]:text-[rgba(230,224,214,0.8)] [&>span]:mr-1"><span>Thesis supervisor:</span> PhD Mario Aragonés Lozano</p>
          <p class="m-0 [font-family:'Inter',system-ui,sans-serif] text-[rgba(196,189,179,0.62)] text-[0.86rem] leading-[1.55] tracking-[0.01em] max-[760px]:text-[0.8rem] max-[760px]:leading-[1.5] [&>span]:text-[rgba(230,224,214,0.8)] [&>span]:mr-1"><span>Thesis supervisor email:</span> maragones@teleco.upv.es</p>
          <p class="m-0 [font-family:'Inter',system-ui,sans-serif] text-[rgba(196,189,179,0.62)] text-[0.86rem] leading-[1.55] tracking-[0.01em] max-[760px]:text-[0.8rem] max-[760px]:leading-[1.5] [&>span]:text-[rgba(230,224,214,0.8)] [&>span]:mr-1"><span>Academic context:</span> Master's thesis with progress toward a PhD</p>
        </div>
      </div>

      <!-- ─── RIGHT: animated graph ─── -->
      <div class="pki-hero-graph-wrap relative mt-7 ml-2 [contain:paint] max-[1080px]:ml-0 max-[760px]:mt-[34px]" id="pkiGraphWrap">

        <!-- Canvas starfield -->
        <canvas class="pki-graph-canvas" id="pkiStarfield" aria-hidden="true"></canvas>

        <!-- Domain lane pill labels -->
        <div class="pki-lane-labels" aria-hidden="true">
          <div class="pki-lane-label">
            <span class="pki-lane-tag pki-tag-a">Domain A</span>
            <div class="pki-lane-sublabel">CERTIFICATE ORIGIN</div>
          </div>
          <div></div>
          <div class="pki-lane-label">
            <span class="pki-lane-tag pki-tag-bridge">Federation</span>
            <div class="pki-lane-sublabel">CROSS-DOMAIN</div>
          </div>
          <div></div>
          <div class="pki-lane-label">
            <span class="pki-lane-tag pki-tag-b">Domain B</span>
            <div class="pki-lane-sublabel">TRUST ANCHOR</div>
          </div>
        </div>

        <!-- SVG graph + floating info-cards overlay -->
        <div class="pki-graph-area">
          <svg
            class="pki-graph-svg"
            id="pkiMainSvg"
            viewBox="0 0 680 270"
            role="img"
            aria-label="Federated PKI trust graph: Domain A → Federation Bridge → Domain B"
          ></svg>
          <div class="pki-card-overlay" id="pkiCardOverlay"></div>
        </div>

        <!-- Scroll hint (fades out after first interaction) -->
        <div class="pki-scroll-hint" id="pkiScrollHint" aria-hidden="true">
          <span class="pki-scroll-hint-icon">↕</span>
          <span>scroll to reveal trust path</span>
        </div>

        <!-- Trust-score bar -->
        <div class="pki-score-bar" id="pkiScoreBar">
          <div class="pki-score-left">
            <div class="pki-score-num" id="pkiScoreNum">0.00</div>
            <div class="pki-score-lbl">Trust score</div>
          </div>
          <div class="pki-score-track">
            <div class="pki-score-fill" id="pkiScoreFill"></div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Hero shell ─── */
  .pki-hero {
    background:
      radial-gradient(circle at 68% 30%, rgba(100, 135, 185, 0.12), transparent 22%),
      radial-gradient(circle at 86% 22%, rgba(212, 231, 255, 0.07), transparent 16%),
      linear-gradient(180deg, #070b13 0%, #0b1018 100%);
  }

  .pki-hero-backdrop {
    opacity: 0.24;
    background-image:
      radial-gradient(circle at 8% 14%, rgba(255,255,255,0.42) 0 1px, transparent 1.6px),
      radial-gradient(circle at 12% 22%, rgba(255,255,255,0.78) 0 1px, transparent 1.6px),
      radial-gradient(circle at 22% 12%, rgba(255,255,255,0.40) 0 1px, transparent 1.5px),
      radial-gradient(circle at 28% 34%, rgba(255,255,255,0.36) 0 1px, transparent 1.5px),
      radial-gradient(circle at 42% 30%, rgba(255,255,255,0.52) 0 1px, transparent 1.5px),
      radial-gradient(circle at 56% 16%, rgba(255,255,255,0.38) 0 1px, transparent 1.6px),
      radial-gradient(circle at 74% 26%, rgba(255,255,255,0.56) 0 1px, transparent 1.6px),
      radial-gradient(circle at 82% 44%, rgba(255,255,255,0.34) 0 1px, transparent 1.6px),
      radial-gradient(circle at 88% 62%, rgba(255,255,255,0.44) 0 1px, transparent 1.6px),
      radial-gradient(circle at 94% 20%, rgba(255,255,255,0.32) 0 1px, transparent 1.6px);
    background-size:
      320px 320px, 520px 520px, 360px 360px, 420px 420px, 640px 640px,
      460px 460px, 700px 700px, 540px 540px, 760px 760px, 620px 620px;
  }

  .pki-hero-starfield {
    opacity: 0.34;
    background-image:
      radial-gradient(circle at 8% 12%, rgba(255,255,255,0.46) 0 1px, transparent 1.7px),
      radial-gradient(circle at 14% 28%, rgba(255,255,255,0.40) 0 1px, transparent 1.7px),
      radial-gradient(circle at 18% 18%, rgba(255,255,255,0.62) 0 1px, transparent 1.7px),
      radial-gradient(circle at 22% 44%, rgba(255,255,255,0.34) 0 1px, transparent 1.7px),
      radial-gradient(circle at 28% 14%, rgba(255,255,255,0.36) 0 1px, transparent 1.7px),
      radial-gradient(circle at 34% 58%, rgba(255,255,255,0.42) 0 1px, transparent 1.8px),
      radial-gradient(circle at 42% 32%, rgba(255,255,255,0.32) 0 1px, transparent 1.8px),
      radial-gradient(circle at 50% 16%, rgba(255,255,255,0.28) 0 1px, transparent 1.8px),
      radial-gradient(circle at 58% 24%, rgba(255,255,255,0.48) 0 1px, transparent 1.8px),
      radial-gradient(circle at 66% 52%, rgba(255,255,255,0.30) 0 1px, transparent 1.8px),
      radial-gradient(circle at 72% 72%, rgba(255,255,255,0.36) 0 1px, transparent 1.8px),
      radial-gradient(circle at 82% 22%, rgba(255,255,255,0.28) 0 1px, transparent 1.8px),
      radial-gradient(circle at 92% 34%, rgba(255,255,255,0.40) 0 1px, transparent 1.8px);
    background-size:
      120px 120px, 160px 160px, 220px 220px, 180px 180px, 240px 240px,
      280px 280px, 320px 320px, 360px 360px, 420px 420px, 460px 460px,
      520px 520px, 560px 560px, 620px 620px;
    mix-blend-mode: screen;
  }

  .pki-hero-overlay {
    background:
      linear-gradient(90deg, rgba(6,10,17,0.9) 0%, rgba(7,11,18,0.8) 22%, rgba(8,12,20,0.5) 42%, rgba(8,12,20,0.12) 62%, rgba(8,12,20,0) 76%);
  }

  .pki-hero-byline-link::before {
    content: "";
    width: 0.62rem; height: 0.62rem;
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 50%, rgba(255,255,255,0.85) 0 18%, transparent 19%),
      #a6ce39;
    box-shadow: 0 0 10px rgba(166,206,57,0.18);
    flex: 0 0 auto;
  }

  /* ─── Graph wrap ─── */
  .pki-hero-graph-wrap {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Canvas starfield within the graph wrap */
  .pki-graph-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.6;
  }

  /* ─── Lane labels ─── */
  .pki-lane-labels {
    display: grid;
    grid-template-columns: 1fr 40px 1fr 40px 1fr;
    position: relative;
    z-index: 2;
    margin-bottom: 1rem;
  }

  .pki-lane-label {
    text-align: center;
  }

  .pki-lane-tag {
    display: inline-block;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.12em;
    padding: 2px 9px;
    border-radius: 20px;
  }

  .pki-tag-a {
    background: rgba(55, 138, 221, 0.12);
    color: #85B7EB;
    border: 0.5px solid rgba(55, 138, 221, 0.25);
  }

  .pki-tag-bridge {
    background: rgba(180, 178, 169, 0.10);
    color: #B4B2A9;
    border: 0.5px solid rgba(180, 178, 169, 0.20);
  }

  .pki-tag-b {
    background: rgba(239, 159, 39, 0.12);
    color: #FAC775;
    border: 0.5px solid rgba(239, 159, 39, 0.25);
  }

  .pki-lane-sublabel {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 8px;
    color: rgba(255, 255, 255, 0.20);
    text-align: center;
    margin-top: 2px;
    letter-spacing: 0.07em;
  }

  /* ─── Graph area ─── */
  .pki-graph-area {
    position: relative;
    width: 100%;
    aspect-ratio: 680 / 270;
    z-index: 2;
  }

  .pki-graph-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pki-card-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* ─── Info cards (JS-created) ─── */
  :global(.pki-info-card) {
    background: rgba(8, 12, 24, 0.92);
    border: 0.5px solid rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 8px 11px;
    width: 136px;
    box-sizing: border-box;
    opacity: 0;
    transform: translateY(4px) scale(0.97);
    transition: opacity 0.28s ease, transform 0.28s ease;
    position: absolute;
    backdrop-filter: blur(6px);
    font-family: "Inter", system-ui, sans-serif;
  }

  :global(.pki-info-card.visible) {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  :global(.pki-ic-name) {
    font-size: 11px;
    font-weight: 500;
    margin-bottom: 5px;
    line-height: 1.2;
  }

  :global(.pki-ic-row) {
    margin-bottom: 3px;
  }

  :global(.pki-ic-lbl) {
    font-size: 8px;
    letter-spacing: 0.09em;
    color: rgba(255, 255, 255, 0.28);
    line-height: 1.3;
  }

  :global(.pki-ic-val) {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.3;
  }

  /* ─── Scroll hint ─── */
  .pki-scroll-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-top: 0.75rem;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.22);
    letter-spacing: 0.06em;
    position: relative;
    z-index: 2;
    transition: opacity 0.5s ease;
  }

  .pki-scroll-hint.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .pki-scroll-hint-icon {
    font-size: 11px;
    opacity: 0.7;
    animation: pkiScrollBounce 1.8s ease-in-out infinite;
  }

  @keyframes pkiScrollBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  /* ─── Score bar ─── */
  .pki-score-bar {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transition: opacity 0.6s;
    position: relative;
    z-index: 2;
  }

  .pki-score-bar.visible {
    opacity: 1;
  }

  .pki-score-left {
    flex-shrink: 0;
  }

  .pki-score-num {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
    min-width: 32px;
  }

  .pki-score-lbl {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.25);
  }

  .pki-score-track {
    flex: 1;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    overflow: hidden;
  }

  .pki-score-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #378ADD, #EF9F27);
    transition: width 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ─── Mobile adjustments ─── */
  @media (max-width: 760px) {
    .pki-hero-overlay {
      background:
        linear-gradient(180deg, rgba(6,10,17,0.84) 0%, rgba(7,11,18,0.7) 34%, rgba(8,12,20,0.16) 66%, rgba(8,12,20,0) 100%);
    }

    .pki-graph-canvas {
      opacity: 0.35;
    }

    .pki-lane-labels {
      grid-template-columns: 1fr 20px 1fr 20px 1fr;
      margin-bottom: 0.6rem;
    }

    :global(.pki-info-card) {
      width: 108px;
      padding: 6px 8px;
    }

    :global(.pki-ic-name) {
      font-size: 9px;
      margin-bottom: 3px;
    }

    :global(.pki-ic-lbl) {
      font-size: 7px;
    }

    :global(.pki-ic-val) {
      font-size: 8px;
    }

    .pki-scroll-hint {
      font-size: 8px;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    // ── Node definitions ───────────────────────────────────────────────────
    const nodes = [
      { id: "entity",   x: 60,  y: 210, r: 4,  col: "#378ADD", label: "End-entity",        domain: "Domain A",   role: "Cert subject",        crypto: "—",                lane: "a" },
      { id: "issuingA", x: 130, y: 195, r: 6,  col: "#378ADD", label: "Issuing CA",         domain: "Domain A",   role: "End-entity issuance",  crypto: "RSA-4096",         lane: "a" },
      { id: "intA",     x: 195, y: 125, r: 8,  col: "#378ADD", label: "Intermediate CA",    domain: "Domain A",   role: "Subordinate CA",       crypto: "RSA-4096 hybrid",  lane: "a" },
      { id: "rootA",    x: 175, y: 42,  r: 6,  col: "#378ADD", label: "Root CA A",          domain: "Domain A",   role: "Internal trust root",  crypto: "RSA-4096",         lane: "a" },
      { id: "bridge",   x: 340, y: 108, r: 9,  col: "#B4B2A9", label: "Federation Bridge",  domain: "Federation", role: "Cross-domain bridge",  crypto: "Hybrid RSA/ML-DSA",lane: "f" },
      { id: "crossB",   x: 490, y: 158, r: 8,  col: "#EF9F27", label: "Cross-certified CA", domain: "Domain B",   role: "Federated gateway",    crypto: "ML-DSA-65",        lane: "b" },
      { id: "intB",     x: 560, y: 75,  r: 5,  col: "#EF9F27", label: "Intermediate CA B",  domain: "Domain B",   role: "Chain bridging",       crypto: "ML-DSA-65",        lane: "b" },
      { id: "anchor",   x: 640, y: 130, r: 10, col: "#EF9F27", label: "Trust Anchor",       domain: "Domain B",   role: "Root of trust · RP",   crypto: "PQC ML-DSA-87",    lane: "b" },
    ] as const;

    const bgEdges: [string, string][] = [
      ["rootA", "intA"], ["entity", "issuingA"], ["issuingA", "intA"],
      ["intA", "bridge"], ["bridge", "crossB"], ["bridge", "intB"],
      ["crossB", "anchor"], ["intB", "anchor"],
    ];

    // Trust path — entity is r=4 so its card is invisible; skip it as first step
    const trustPath = ["entity", "issuingA", "intA", "bridge", "crossB", "anchor"];

    const svgEl    = document.getElementById("pkiMainSvg") as SVGSVGElement | null;
    const overlay  = document.getElementById("pkiCardOverlay") as HTMLDivElement | null;
    const scoreBar = document.getElementById("pkiScoreBar") as HTMLElement | null;
    const scoreFill= document.getElementById("pkiScoreFill") as HTMLElement | null;
    const scoreNum = document.getElementById("pkiScoreNum") as HTMLElement | null;
    const graphWrap= document.getElementById("pkiGraphWrap") as HTMLElement | null;
    const scrollHint = document.getElementById("pkiScrollHint") as HTMLElement | null;

    if (!svgEl || !overlay || !graphWrap) { /* bail silently */ }
    else {

    type NodeDef = typeof nodes[number];
    function nodeById(id: string): NodeDef | undefined {
      return (nodes as readonly NodeDef[]).find(n => n.id === id);
    }

    // ── Canvas starfield ──────────────────────────────────────────────────
    function drawStarfield() {
      const c = document.getElementById("pkiStarfield") as HTMLCanvasElement | null;
      if (!c) return;
      const wrap = c.parentElement;
      if (!wrap) return;
      const w = wrap.offsetWidth, h = wrap.offsetHeight;
      c.width = w; c.height = h;
      const ctx = c.getContext("2d");
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < 160; i++) {
        const x = Math.random() * w, y = Math.random() * h;
        const r = Math.random() * 1.1 + 0.2;
        const alpha = Math.random() * 0.55 + 0.05;
        ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,255,${alpha})`; ctx.fill();
      }
      for (let i = 0; i < 18; i++) {
        const x = Math.random() * w, y = Math.random() * h;
        const r = Math.random() * 0.7 + 0.6;
        ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2);
        const blue = Math.random() > 0.5;
        ctx.fillStyle = blue ? "rgba(180,210,255,0.6)" : "rgba(255,240,200,0.5)";
        ctx.fill();
      }
    }

    // ── Build static SVG graph ────────────────────────────────────────────
    function buildGraph() {
      svgEl.innerHTML = "";
      const NS = "http://www.w3.org/2000/svg";

      const defs = document.createElementNS(NS, "defs");
      defs.innerHTML = `
        <filter id="pkiGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="4" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="pkiSoftglow" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="6" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="pkiPathglow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="2.5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>`;
      svgEl.appendChild(defs);

      bgEdges.forEach(([a, b]) => {
        const na = nodeById(a), nb = nodeById(b);
        if (!na || !nb) return;
        const line = document.createElementNS(NS, "line");
        line.setAttribute("x1", String(na.x)); line.setAttribute("y1", String(na.y));
        line.setAttribute("x2", String(nb.x)); line.setAttribute("y2", String(nb.y));
        line.setAttribute("stroke", "rgba(255,255,255,0.055)");
        line.setAttribute("stroke-width", "0.8");
        svgEl.appendChild(line);
      });

      const pathGroup = document.createElementNS(NS, "g");
      pathGroup.id = "pkiPathGroup";
      svgEl.appendChild(pathGroup);

      (nodes as readonly NodeDef[]).forEach(n => {
        const g = document.createElementNS(NS, "g");
        g.id = "pki-node-" + n.id;

        if (n.r >= 6) {
          const halo = document.createElementNS(NS, "circle");
          halo.setAttribute("cx", String(n.x)); halo.setAttribute("cy", String(n.y));
          halo.setAttribute("r", String(n.r + 4));
          halo.setAttribute("fill", n.col + "08");
          halo.id = "pki-halo-" + n.id;
          g.appendChild(halo);
        }

        const circle = document.createElementNS(NS, "circle");
        circle.setAttribute("cx", String(n.x)); circle.setAttribute("cy", String(n.y));
        circle.setAttribute("r", String(n.r));
        circle.setAttribute("fill", n.col + "22");
        circle.setAttribute("stroke", n.col);
        circle.setAttribute("stroke-width", "1");
        (circle.style as CSSStyleDeclaration).transition = "all 0.4s";
        circle.id = "pki-circle-" + n.id;
        g.appendChild(circle);

        const dot = document.createElementNS(NS, "circle");
        dot.setAttribute("cx", String(n.x)); dot.setAttribute("cy", String(n.y));
        dot.setAttribute("r", String(Math.max(1.5, n.r * 0.35)));
        dot.setAttribute("fill", n.col); dot.setAttribute("opacity", "0.7");
        g.appendChild(dot);

        if (n.r >= 6) {
          const text = document.createElementNS(NS, "text");
          text.setAttribute("x", String(n.x)); text.setAttribute("y", String(n.y - n.r - 5));
          text.setAttribute("text-anchor", "middle");
          text.setAttribute("fill", "rgba(255,255,255,0.3)");
          text.setAttribute("font-size", "8");
          text.setAttribute("font-family", "Inter, system-ui, sans-serif");
          text.setAttribute("letter-spacing", "0.04em");
          text.textContent = n.label;
          g.appendChild(text);
        }

        svgEl.appendChild(g);
      });
    }

    // ── Card placement with collision detection ───────────────────────────
    interface CardRect { l: number; t: number; r: number; b: number; }
    const placedCards: CardRect[] = [];

    function noOverlap(l: number, t: number, cw: number, ch: number): boolean {
      return !placedCards.some(p =>
        l < p.r && l + cw > p.l && t < p.b && t + ch > p.t
      );
    }

    function inBounds(l: number, t: number, cw: number, ch: number, W: number, H: number): boolean {
      return l >= 0 && t >= 0 && l + cw <= W && t + ch <= H;
    }

    function bestCardPosition(
      cx: number, cy: number, nr: number,
      W: number, H: number
    ): { left: number; top: number } {
      // Card dimensions adapt to overlay width (mobile vs desktop)
      const cw = W < 420 ? 108 : 136;
      const ch = W < 420 ? 72  : 90;
      const G  = 9; // gap from node edge

      // Candidate positions in preference order
      const candidates = [
        // above-center
        { l: cx - cw / 2,      t: cy - nr - G - ch },
        // above-right
        { l: cx + nr + G,      t: cy - nr - G - ch },
        // above-left
        { l: cx - cw - nr - G, t: cy - nr - G - ch },
        // right-center
        { l: cx + nr + G,      t: cy - ch / 2 },
        // left-center
        { l: cx - cw - nr - G, t: cy - ch / 2 },
        // below-center
        { l: cx - cw / 2,      t: cy + nr + G },
        // below-right
        { l: cx + nr + G,      t: cy + nr + G },
        // below-left
        { l: cx - cw - nr - G, t: cy + nr + G },
      ];

      for (const { l, t } of candidates) {
        if (inBounds(l, t, cw, ch, W, H) && noOverlap(l, t, cw, ch)) {
          placedCards.push({ l, t, r: l + cw, b: t + ch });
          return { left: l, top: t };
        }
      }

      // Fallback: above-center, clamped within bounds
      const fl = Math.max(0, Math.min(cx - cw / 2, W - cw));
      const ft = Math.max(0, Math.min(cy - nr - G - ch, H - ch));
      placedCards.push({ l: fl, t: ft, r: fl + cw, b: ft + ch });
      return { left: fl, top: ft };
    }

    // ── Animation state ───────────────────────────────────────────────────
    let currentStep  = -1;   // -1 = not started
    let isAnimating  = false;
    let isComplete   = false;

    function clearCards() {
      overlay.innerHTML = "";
      placedCards.length = 0;
      if (scoreBar)  scoreBar.classList.remove("visible");
      if (scoreFill) scoreFill.style.width = "0";
      if (scoreNum)  scoreNum.textContent = "0.00";
    }

    function clearPathLines() {
      const pg = document.getElementById("pkiPathGroup");
      if (pg) pg.innerHTML = "";
      (nodes as readonly NodeDef[]).forEach(n => {
        const c = document.getElementById("pki-circle-" + n.id);
        if (c) {
          c.setAttribute("fill", n.col + "22");
          c.setAttribute("stroke", n.col);
          c.setAttribute("stroke-width", "1");
          c.removeAttribute("filter");
        }
        const h = document.getElementById("pki-halo-" + n.id);
        if (h) h.setAttribute("fill", n.col + "08");
      });
    }

    function animateSegment(fromNode: NodeDef, toNode: NodeDef, color: string, cb: () => void) {
      const pg = document.getElementById("pkiPathGroup");
      if (!pg) { cb(); return; }
      const NS = "http://www.w3.org/2000/svg";

      const glowLine = document.createElementNS(NS, "line");
      glowLine.setAttribute("x1", String(fromNode.x)); glowLine.setAttribute("y1", String(fromNode.y));
      glowLine.setAttribute("x2", String(fromNode.x)); glowLine.setAttribute("y2", String(fromNode.y));
      glowLine.setAttribute("stroke", color); glowLine.setAttribute("stroke-width", "4");
      glowLine.setAttribute("stroke-linecap", "round"); glowLine.setAttribute("opacity", "0.25");
      glowLine.setAttribute("filter", "url(#pkiPathglow)");
      pg.appendChild(glowLine);

      const line = document.createElementNS(NS, "line");
      line.setAttribute("x1", String(fromNode.x)); line.setAttribute("y1", String(fromNode.y));
      line.setAttribute("x2", String(fromNode.x)); line.setAttribute("y2", String(fromNode.y));
      line.setAttribute("stroke", color); line.setAttribute("stroke-width", "1.2");
      line.setAttribute("stroke-linecap", "round"); line.setAttribute("opacity", "0.85");
      pg.appendChild(line);

      const dx = toNode.x - fromNode.x, dy = toNode.y - fromNode.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      const dur = dist * 3;
      const start = performance.now();

      function tick(now: number) {
        const t = Math.min((now - start) / dur, 1);
        const ex = fromNode.x + dx * t, ey = fromNode.y + dy * t;
        line.setAttribute("x2", String(ex));      line.setAttribute("y2", String(ey));
        glowLine.setAttribute("x2", String(ex));  glowLine.setAttribute("y2", String(ey));
        if (t < 1) requestAnimationFrame(tick);
        else cb();
      }
      requestAnimationFrame(tick);
    }

    function showCard(nodeId: string) {
      const n = nodeById(nodeId);
      if (!n || n.r < 5) return;

      const svgRect  = svgEl.getBoundingClientRect();
      const wrapRect = overlay.getBoundingClientRect();
      const scaleX   = svgRect.width  / 680;
      const scaleY   = svgRect.height / 270;
      const cx = n.x * scaleX + (svgRect.left - wrapRect.left);
      const cy = n.y * scaleY + (svgRect.top  - wrapRect.top);
      const nr = n.r * Math.min(scaleX, scaleY);
      const W  = overlay.offsetWidth;
      const H  = overlay.offsetHeight;

      const accentColor = n.lane === "a" ? "#85B7EB" : n.lane === "f" ? "#D3D1C7" : "#FAC775";

      const card = document.createElement("div");
      card.className = "pki-info-card";
      card.style.borderColor = accentColor + "40";
      card.innerHTML = `
        <div class="pki-ic-name" style="color:${accentColor}">${n.label}</div>
        <div class="pki-ic-row"><div class="pki-ic-lbl">DOMAIN</div><div class="pki-ic-val">${n.domain}</div></div>
        <div class="pki-ic-row"><div class="pki-ic-lbl">ROLE</div><div class="pki-ic-val">${n.role}</div></div>
        <div class="pki-ic-row"><div class="pki-ic-lbl">CRYPTO</div><div class="pki-ic-val">${n.crypto}</div></div>`;

      const { left, top } = bestCardPosition(cx, cy, nr, W, H);
      card.style.left = left + "px";
      card.style.top  = top  + "px";
      overlay.appendChild(card);
      requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add("visible")));

      const circle = document.getElementById("pki-circle-" + nodeId);
      if (circle) {
        circle.setAttribute("fill", n.col + "44");
        circle.setAttribute("stroke-width", "1.5");
        circle.setAttribute("filter", "url(#pkiSoftglow)");
      }
      const halo = document.getElementById("pki-halo-" + nodeId);
      if (halo) halo.setAttribute("fill", n.col + "18");
    }

    function revealScore() {
      if (!scoreBar || !scoreFill || !scoreNum) return;
      scoreBar.classList.add("visible");
      setTimeout(() => { scoreFill.style.width = "91%"; }, 80);
      let v = 0;
      const t = setInterval(() => {
        v = Math.min(v + 0.025, 0.91);
        scoreNum.textContent = v.toFixed(2);
        if (v >= 0.91) clearInterval(t);
      }, 35);
    }

    function runStep(idx: number) {
      if (idx >= trustPath.length) { isAnimating = false; revealScore(); return; }
      const nodeId = trustPath[idx];
      if (idx > 0) {
        const prev = nodeById(trustPath[idx - 1]);
        const curr = nodeById(nodeId);
        if (!prev || !curr) { isAnimating = false; return; }
        const color = curr.lane === "b" ? "#EF9F27" : curr.lane === "f" ? "#cccccc" : "#378ADD";
        isAnimating = true;
        animateSegment(prev, curr, color, () => {
          showCard(nodeId);
          isAnimating = false;
        });
      } else {
        showCard(nodeId);
        isAnimating = false;
      }
    }

    // ── Scroll / touch-driven advance ─────────────────────────────────────
    function hideScrollHint() {
      scrollHint?.classList.add("hidden");
    }

    function advanceStep() {
      if (isAnimating || isComplete) return;

      hideScrollHint();

      if (currentStep === -1) {
        // First interaction: reset and start from step 1 (skip entity r=4)
        clearCards(); clearPathLines();
        currentStep = 1;
        runStep(currentStep);
      } else {
        currentStep++;
        if (currentStep >= trustPath.length) {
          isComplete = true;
          currentStep = trustPath.length - 1;
          revealScore();
        } else {
          runStep(currentStep);
        }
      }
    }

    // Desktop: intercept wheel events when the cursor is over the graph wrap.
    // Listening on the section element (not graphWrap) ensures we always catch
    // the event even when SVG / canvas children absorb the pointer target.
    const heroSection = svgEl.closest("section");
    heroSection?.addEventListener("wheel", (e: WheelEvent) => {
      if (isComplete) return; // animation done — let page scroll naturally
      const rect = graphWrap.getBoundingClientRect();
      const over = e.clientX >= rect.left && e.clientX <= rect.right
                && e.clientY >= rect.top  && e.clientY <= rect.bottom;
      if (!over) return; // cursor outside graph — let page scroll naturally
      e.preventDefault();
      if (isAnimating) return; // segment in progress — ignore until done
      advanceStep();
    }, { passive: false });

    // Mobile: tap anywhere on the graph wrap
    let touchStartY = 0;
    graphWrap.addEventListener("touchstart", (e: TouchEvent) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    graphWrap.addEventListener("touchend", (e: TouchEvent) => {
      const dy = Math.abs(touchStartY - e.changedTouches[0].clientY);
      if (dy < 12 && !isAnimating && !isComplete) {
        advanceStep();
      }
    }, { passive: true });

    // ── Init ──────────────────────────────────────────────────────────────
    drawStarfield();
    buildGraph();

    window.addEventListener("resize", drawStarfield, { passive: true });

    } // end if svgEl
  }
</script>
