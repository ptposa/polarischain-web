---
import HeroAperture from './HeroAperture.astro';
---

<!-- One continuous move: the reader scrolls, the camera flies towards Polaris
     through the sky chart, the stars stream past and the black of the sky
     settles into the deep blue of the page. `lib/dive.ts` drives it. -->
<div class="dive" id="top" data-dive>
  <div class="dive__stage" data-dive-stage>
    <canvas class="dive__sky" data-dive-sky aria-hidden="true"></canvas>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner" data-dive-content>
        <div class="hero__copy" data-dive-copy>
          <p class="hero__eyebrow">
            Navigating trust across federated PKI ecosystems · Academic research
          </p>

          <h1 class="hero__title" id="hero-title">
            A governed graph model for <em>federated trust.</em>
          </h1>

          <p class="hero__lead">
            In a sea of cross-certifications, bridge CAs and trust lists, federation relationships
            remain implicit and hard to reason about.
          </p>

          <p class="hero__body">
            Like the polar star for a navigator, PolarisChain is a fixed reference that stays outside the route. It reads the trust that others have already established and turns it into a governed graph of keys, on which each receiver computes the certification paths it admits and the one it prefers, whether its domains are traditional, hybrid or post-quantum.
          </p>
          <dl class="hero__kicker">
            <dt>Author</dt><dd>Jorge Pablo Trías Posa</dd>
            <dt>Supervisor</dt><dd>Dr. Mario Aragonés Lozano</dd>
            <dt>Institution</dt><dd>Polytechnic University of Valencia&nbsp;(UPV)</dd>
            <dt>Academic context</dt><dd>Master’s thesis and doctoral research</dd>
          </dl>

          <div class="dive__cue dive__cue--inline" data-dive-cue aria-hidden="true">
            <span>Deep dive into the research</span>
            <svg width="2" height="44" viewBox="0 0 2 44"><line x1="1" y1="0" x2="1" y2="44"></line></svg>
          </div>
        </div>

        <HeroAperture />
      </div>
    </section>

    <div class="dive__cue dive__cue--float" data-dive-cue aria-hidden="true">
      <span>Deep dive into the research</span>
      <svg width="2" height="44" viewBox="0 0 2 44"><line x1="1" y1="0" x2="1" y2="44"></line></svg>
    </div>
  </div>
</div>

<style>
  /* The script sets the exact height: one screen, plus the part of the hero
     that does not fit on it, plus the length of the dive. */
  .dive {
    position: relative;
    height: 170vh;
  }

  .dive__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .dive__sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero {
    position: relative;
    height: 100%;
  }

  .hero__inner {
    --hero-top: calc(var(--header-h) + 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 25rem);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
    width: min(var(--wide), 100% - 2 * var(--gutter));
    min-height: 100%;
    margin-inline: auto;
    padding: var(--hero-top) 0 5.5rem;
  }

  .hero__copy {
    will-change: transform, opacity;
  }

  /* The credits, as on the cover of a thesis: a label in the small capitals
     of the text face before each entry, one entry per line. */
  .hero__kicker {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.15rem 1.1rem;
    max-width: 58ch;
    margin: 1.5rem 0 0;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-body);
    font-size: 0.96875rem;
    line-height: 1.5;
  }

  /* The labels in small capitals at the size of the names beside them: the
     A of Author stands as tall as the J of Jorge, the rest of the word lower. */
  .hero__kicker dt {
    font-variant: small-caps;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .hero__kicker dd {
    margin: 0;
    color: var(--text);
  }

  @media (max-width: 420px) {
    .hero__kicker {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .hero__kicker dd + dt {
      margin-top: 0.35rem;
    }
  }

  /* The one line set in spaced capitals on the whole page: it names the
     field before the headline names the work. */
  .hero__eyebrow {
    margin: 0 0 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* A dimmed bone white: neither the blue grey of the navigation nor the
       yellow of the headline just below. */
    color: rgba(238, 242, 248, 0.62);
  }


  .hero__title {
    max-width: 13ch;
    font-size: clamp(2.8rem, 5.6vw, 5.2rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--text-strong);
  }

  .hero__title em {
    color: var(--star);
  }

  .hero__lead {
    max-width: 46ch;
    margin: 1.4rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.25;
    color: var(--text);
  }

  .hero__body {
    max-width: 58ch;
    margin: 1rem 0 0;
    font-size: var(--body-size);
    line-height: 1.45;
    color: var(--text-soft);
  }

  .dive__cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    transform: translateX(-50%);
    /* The mono capitals of the eyebrow, so the opening screen starts and
       ends in the same voice. */
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    pointer-events: none;
    isolation: isolate;
  }

  .dive__cue > span,
  .dive__cue > svg {
    opacity: var(--cue-op, 1);
  }

  .dive__cue--inline {
    display: none;
  }

  .dive__cue line {
    stroke: var(--sky);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    animation: cue 1.2s linear infinite;
  }

  @keyframes cue {
    to {
      stroke-dashoffset: -14;
    }
  }

  /* On one column the first screen holds only the introduction and the cue:
     the copy fills the stage below the header, its text centred in the
     free space, and the sky chart waits below until the reader scrolls. */
  @media (max-width: 960px) {
    .dive__cue--float {
      display: none;
    }
    .hero__copy {
      display: flex;
      flex-direction: column;
      min-height: calc(100vh - var(--hero-top));
      min-height: calc(100svh - var(--hero-top));
    }
    .hero__eyebrow {
      margin-top: auto;
    }
    .dive__cue--inline {
      position: relative;
      left: auto;
      bottom: auto;
      display: flex;
      align-self: center;
      margin-top: auto;
      padding: 2.5rem 0 1.6rem;
      transform: none;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 2.5rem;
      padding-bottom: 6rem;
    }
    .hero__title {
      max-width: 14ch;
    }
  }

  @media (max-width: 560px) {
    .hero__inner {
      --hero-top: calc(var(--header-h) + 1.5rem);
    }
    .hero__title {
      font-size: clamp(2.4rem, 11vw, 3.2rem);
    }
  }

  /* Short phones: tighter type, so the cue still fits on the first screen. */
  @media (max-width: 960px) and (max-height: 740px) {
    .hero__inner {
      --hero-top: calc(var(--header-h) + 0.75rem);
    }
    .hero__title {
      font-size: clamp(2.1rem, 9.4vw, 2.6rem);
    }
    .hero__lead {
      margin-top: 1.1rem;
      font-size: 1.08rem;
    }
    .hero__body {
      margin-top: 0.9rem;
    }
    .dive__cue--inline {
      padding: 1.4rem 0 1.1rem;
    }
  }

  /* Desktop windows of ordinary height: the headline and the gaps follow
     the height of the window, so the whole introduction, the credits and
     the cue fit on the first screen. */
  @media (min-width: 961px) and (max-height: 1080px) {
    .hero__inner {
      --hero-top: calc(var(--header-h) + 1.25rem);
    }
    .hero__eyebrow {
      margin-bottom: 1.1rem;
    }
    .hero__title {
      font-size: clamp(2.6rem, min(5.6vw, 8vh), 5.2rem);
      line-height: 0.98;
    }
    .hero__kicker {
      line-height: 1.4;
    }
  }

  /* Shorter windows on two columns (small laptops): the cue would sit on
     the credits, so it goes and the text keeps the room. */
  @media (min-width: 961px) and (max-height: 909px) {
    .dive__cue--float {
      display: none;
    }
    .hero__inner {
      padding-bottom: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dive {
      height: auto;
    }
    .dive__stage {
      position: relative;
      height: auto;
    }
    .dive__cue {
      display: none;
    }
    .dive__cue line {
      animation: none;
    }
  }
</style>
