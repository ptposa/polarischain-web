---
// Right column of the hero: a static sky chart that foreshadows the scroll-dive.
// The constellation is Ursa Minor — a nod to Polaris. The bowl (quadrilateral) is
// the federation mesh, i.e. cross-certifications between intermediate CAs of
// different domains (never at root level); the handle is the admissible trust
// chain climbing to Polaris. `scroll-dive.ts` measures `.aperture-frame` to place
// the dive's focal point, so the camera enters *through* this chart.
---

<aside class="hero-aperture" aria-hidden="true">
  <div class="aperture-head">
    <span>The model</span>
  </div>

  <div class="aperture-frame">
    <svg class="aperture-svg" viewBox="0 0 400 400">
      <!-- outer instrument rings -->
      <circle cx="200" cy="200" r="188" fill="none" stroke="rgba(200,218,240,0.07)" stroke-width="1"
      ></circle>
      <g class="aperture-ring-a">
        <circle
          cx="200"
          cy="200"
          r="170"
          fill="none"
          stroke="rgba(200,218,240,0.22)"
          stroke-width="1"
          stroke-dasharray="1 13"
          stroke-linecap="round"></circle>
      </g>
      <g class="aperture-ring-b">
        <circle
          cx="200"
          cy="200"
          r="146"
          fill="none"
          stroke="rgba(200,218,240,0.12)"
          stroke-width="1"
          stroke-dasharray="1 26"
          stroke-linecap="round"></circle>
      </g>
      <!-- reticle -->
      <path
        d="M200 26 L200 66 M200 334 L200 374 M26 200 L66 200 M334 200 L374 200"
        stroke="rgba(200,218,240,0.14)"
        stroke-width="1"></path>

      <g class="aperture-graph">
        <!-- Bowl of Ursa Minor = federation mesh: cross-certifications
             between intermediate CAs of different domains (never at root level) -->
        <g stroke="rgba(184,170,152,0.3)" stroke-width="0.9" stroke-dasharray="2 5" fill="none">
          <path d="M190 235 L243 283 L203 325 L157 258 Z"></path>
        </g>

        <!-- Handle = admissible trust chain climbing to Polaris -->
        <g
          class="aperture-path"
          fill="none"
          stroke="rgba(122,179,232,0.85)"
          stroke-width="1.6"
          stroke-linecap="round"
        >
          <path d="M190 235 L182 179 L188 121 L223 75"></path>
        </g>

        <!-- Stars / CA nodes — size follows stellar magnitude -->
        <g fill="#010309">
          <circle cx="223" cy="75" r="5.4" stroke="#e8c96a" stroke-width="1.6"></circle>
          <circle cx="188" cy="121" r="3.8" stroke="#b8aa98" stroke-width="1.2"></circle>
          <circle cx="182" cy="179" r="3.6" stroke="#b8aa98" stroke-width="1.2"></circle>
          <circle cx="190" cy="235" r="4.6" stroke="#7ab3e8" stroke-width="1.4"></circle>
          <circle cx="243" cy="283" r="5" stroke="#7ab3e8" stroke-width="1.4"></circle>
          <circle cx="203" cy="325" r="4.4" stroke="#b8aa98" stroke-width="1.2"></circle>
          <circle cx="157" cy="258" r="3.6" stroke="rgba(184,170,152,0.5)" stroke-width="1.1"
          ></circle>
        </g>
        <g fill="none">
          <circle cx="223" cy="75" r="1.9" stroke="#e8c96a" stroke-width="3.2"></circle>
          <circle cx="223" cy="75" r="18" stroke="rgba(232,201,106,0.28)" stroke-width="0.7"
          ></circle>
          <circle cx="190" cy="235" r="1.7" stroke="#7ab3e8" stroke-width="3"></circle>
          <circle cx="243" cy="283" r="1.7" stroke="#7ab3e8" stroke-width="3"></circle>
          <circle cx="190" cy="235" r="14" stroke="rgba(122,179,232,0.2)" stroke-width="0.7"
          ></circle>
        </g>
      </g>

      <!-- Labels sit outside .aperture-graph: no breathe, no shimmer -->
      <g
        class="aperture-labels"
        font-family="IBM Plex Mono, monospace"
        font-size="9"
        letter-spacing="0.6"
        fill="rgba(184,170,152,0.75)"
      >
        <text x="236" y="70" fill="rgba(232,201,106,0.8)"
          >Polaris · D<tspan font-size="7" dy="2">n</tspan></text
        >
        <text x="178" y="228" text-anchor="end"
          >CA-Int · D<tspan font-size="7" dy="2">0</tspan></text
        >
        <text x="256" y="287">CA-Int · D<tspan font-size="7" dy="2">1</tspan></text>
        <text class="lbl-cross" x="215" y="300" fill="rgba(184,170,152,0.5)">cross-cert</text>
      </g>
    </svg>
  </div>

  <div class="aperture-legend">
    <span class="lg-blue"><i></i>origin domain</span>
    <span class="lg-gray"><i></i>federation transit</span>
    <span class="lg-gold"><i></i>relying party</span>
  </div>
</aside>

<style>
  /* ════ HERO APERTURE — dive preview (right column of the hero) ════ */
  .hero-aperture {
    position: relative;
    align-self: center;
    justify-self: end;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    opacity: 0;
    animation: apertureIn 1.2s cubic-bezier(0.22, 0.8, 0.3, 1) 0.35s forwards;
  }

  @keyframes apertureIn {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .aperture-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .aperture-frame {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  /* Faint sky inside the aperture */
  .aperture-frame::before {
    content: '';
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, oklch(56% 0.09 250 / 0.14), transparent 68%),
      radial-gradient(circle at 62% 32%, oklch(76% 0.11 72 / 0.05), transparent 60%);
    pointer-events: none;
  }

  .aperture-svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  .aperture-ring-a {
    animation: apertureSpin 120s linear infinite;
    transform-origin: 200px 200px;
  }
  .aperture-ring-b {
    animation: apertureSpin 190s linear infinite reverse;
    transform-origin: 200px 200px;
  }
  .aperture-graph {
    animation: apertureBreathe 9s ease-in-out infinite;
    transform-origin: 200px 200px;
  }
  .aperture-path {
    animation: aperturePulse 6s ease-in-out infinite;
  }

  @keyframes apertureSpin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes apertureBreathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.035);
    }
  }
  @keyframes aperturePulse {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.95;
    }
  }

  .aperture-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .aperture-legend span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .aperture-legend i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    font-style: normal;
  }
  .aperture-legend .lg-blue {
    color: var(--node-a);
  }
  .aperture-legend .lg-gray {
    color: var(--text-soft);
  }
  .aperture-legend .lg-gold {
    color: var(--node-b);
  }

  /* ── Tablet: chart centres under the copy, labels scale up to stay legible ── */
  @media (max-width: 1080px) {
    .hero-aperture {
      justify-self: center;
      max-width: 330px;
      margin-top: 8px;
    }
    .aperture-labels {
      font-size: 11px;
    }
  }

  /* ── Mobile: the chart stays, sized to the column and simplified ── */
  @media (max-width: 760px) {
    .hero-aperture {
      display: flex;
      justify-self: center;
      align-self: stretch;
      width: 100%;
      max-width: 300px;
      margin: 4px auto 0;
      gap: 14px;
    }
    .aperture-head {
      justify-content: center;
      font-size: 0.58rem;
      letter-spacing: 0.24em;
    }
    /* Tracking stays on the SVG's own letter-spacing attribute */
    .aperture-labels {
      font-size: 13px;
    }
    .aperture-legend {
      justify-content: center;
      gap: 5px 14px;
      font-size: 0.58rem;
    }
  }

  /* ── Narrow mobile: the cross-cert label crowds the quadrilateral, so it goes ── */
  @media (max-width: 420px) {
    .hero-aperture {
      max-width: 258px;
      gap: 12px;
    }
    .aperture-labels {
      font-size: 15px;
    }
    .aperture-labels .lbl-cross {
      display: none;
    }
    .aperture-legend {
      flex-direction: column;
      align-items: center;
      gap: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-aperture {
      animation: none;
      opacity: 1;
    }
    .aperture-ring-a,
    .aperture-ring-b,
    .aperture-graph,
    .aperture-path {
      animation: none;
    }
  }
</style>
