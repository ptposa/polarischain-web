---
// Right column of the hero: a sky chart that the dive enters.
// The constellation is Ursa Minor. The bowl is the federation mesh, the
// cross-certificates between intermediate CAs of different domains (never at
// root level); the handle is the admissible trust chain climbing to Polaris,
// the anchor of the relying party. `lib/dive.ts` reads `data-focal` to aim the
// camera at Polaris.
---

<aside class="aperture" aria-hidden="true" data-aperture>
  <div class="aperture__frame" data-aperture-frame>
    <svg class="aperture__svg" viewBox="0 0 400 400">
      <circle class="ring" cx="200" cy="200" r="188"></circle>
      <g class="spin spin--a">
        <circle class="ring ring--dots" cx="200" cy="200" r="170"></circle>
      </g>
      <g class="spin spin--b">
        <circle class="ring ring--dots-wide" cx="200" cy="200" r="146"></circle>
      </g>
      <path class="ring" d="M200 26 V60 M200 340 V374 M26 200 H60 M340 200 H374"></path>

      <!-- Bowl: the federation mesh -->
      <path class="mesh" d="M190 235 L243 283 L203 325 L157 258 Z"></path>

      <!-- Handle: the admissible chain, flowing towards Polaris -->
      <path class="chain" d="M190 235 L182 179 L188 121 L223 75"></path>

      <g class="stars">
        <circle class="st st--transit" cx="188" cy="121" r="3.4"></circle>
        <circle class="st st--transit" cx="182" cy="179" r="3.2"></circle>
        <circle class="st st--origin" cx="190" cy="235" r="4.2"></circle>
        <circle class="st st--origin" cx="243" cy="283" r="4.4"></circle>
        <circle class="st st--transit" cx="203" cy="325" r="3.8"></circle>
        <circle class="st st--faint" cx="157" cy="258" r="3.2"></circle>
        <circle class="polaris-ring" cx="223" cy="75" r="13"></circle>
        <circle class="st st--polaris" cx="223" cy="75" r="4.6" data-focal></circle>
      </g>

      <g class="labels">
        <text x="242" y="71" class="lbl-polaris">Polaris · D<tspan dy="2" font-size="7">n</tspan></text>
        <text x="176" y="228" text-anchor="end">CA-Int · D<tspan dy="2" font-size="7">0</tspan></text>
        <text x="256" y="287">CA-Int · D<tspan dy="2" font-size="7">1</tspan></text>
        <text x="214" y="302" class="lbl-cross">cross-cert</text>
      </g>
    </svg>
  </div>

  <div class="aperture__legend" data-aperture-legend>
    <span class="lg lg--origin">origin domain</span>
    <span class="lg lg--transit">federation transit</span>
    <span class="lg lg--rp">relying party</span>
  </div>
</aside>

<style>
  .aperture {
    width: 100%;
    max-width: 380px;
    justify-self: end;
    align-self: center;
  }

  .aperture__frame {
    position: relative;
    aspect-ratio: 1;
    transform-origin: 55.75% 18.75%;
    will-change: transform, opacity;
  }

  .aperture__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ring {
    fill: none;
    stroke: rgba(186, 198, 217, 0.16);
    stroke-width: 1;
  }

  .ring--dots {
    stroke: rgba(186, 198, 217, 0.34);
    stroke-dasharray: 1 12;
    stroke-linecap: round;
  }

  .ring--dots-wide {
    stroke: rgba(186, 198, 217, 0.2);
    stroke-dasharray: 1 24;
    stroke-linecap: round;
  }

  .spin {
    transform-origin: 200px 200px;
  }
  .spin--a {
    animation: spin 160s linear infinite;
  }
  .spin--b {
    animation: spin 240s linear infinite reverse;
  }

  .mesh {
    fill: none;
    stroke: rgba(186, 198, 217, 0.4);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .chain {
    fill: none;
    stroke: var(--ieee-cyan);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 5 4;
    animation: chain 1.3s linear infinite;
  }

  .st {
    fill: var(--sky-black);
    stroke-width: 1.3;
  }
  .st--origin {
    stroke: var(--ieee-blue-50);
  }
  .st--transit {
    stroke: var(--ieee-dark-blue-25);
  }
  .st--faint {
    stroke: rgba(173, 174, 190, 0.45);
  }
  .st--polaris {
    fill: var(--ieee-yellow);
    stroke: var(--ieee-yellow);
  }
  .polaris-ring {
    fill: none;
    stroke: rgba(255, 199, 44, 0.45);
    stroke-width: 1;
  }

  .labels text {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    fill: rgba(186, 198, 217, 0.75);
  }
  .labels .lbl-polaris {
    fill: var(--ieee-yellow-75);
  }
  .labels .lbl-cross {
    fill: rgba(186, 198, 217, 0.5);
  }

  .aperture__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .lg::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 0.45rem;
    border-radius: 50%;
    vertical-align: 0.12em;
    background: currentColor;
  }
  .lg--origin {
    color: var(--ieee-blue-50);
  }
  .lg--transit {
    color: var(--ieee-dark-blue-25);
  }
  .lg--rp {
    color: var(--ieee-yellow-75);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes chain {
    to {
      stroke-dashoffset: -18;
    }
  }

  @media (max-width: 960px) {
    .aperture {
      justify-self: center;
      max-width: 300px;
    }
    .labels text {
      font-size: 12px;
    }
    .labels .lbl-cross {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spin--a,
    .spin--b,
    .chain {
      animation: none;
    }
  }
</style>
