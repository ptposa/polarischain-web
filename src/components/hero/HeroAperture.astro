---
// Right column of the hero: the sky chart that the dive enters.
// Of the sky only Polaris is kept. Around it turns the federation of the
// laboratory: three domains, each with its trust anchor, intermediate CAs and
// issuing CAs, cross-certified only between intermediates. Polaris is not a
// node and no path goes through it; each receiver in turn takes it as its
// reference. `lib/federation-wheel.ts` draws and moves the graph, and
// `lib/dive.ts` reads `data-focal` to aim the camera at Polaris.
---

<aside class="aperture" aria-hidden="true" data-aperture>
  <div class="aperture__frame" data-aperture-frame>
    <svg class="aperture__svg" viewBox="-175 -175 350 350" data-fed>
      <g data-fed-guide></g>
      <g data-fed-edges></g>
      <polyline class="fw-route" data-fed-route></polyline>
      <g data-fed-nodes></g>
      <g data-fed-polaris>
        <circle class="fw-polaris-halo" cx="0" cy="0" r="12"></circle>
        <circle class="fw-polaris" cx="0" cy="0" r="4.8" data-focal></circle>
      </g>
      <g data-fed-labels>
        <text class="fw-lbl fw-lbl--polaris" x="0" y="-18" text-anchor="middle">Polaris</text>
        <text class="fw-lbl fw-lbl--caption" x="-171" y="-161" data-fed-caption></text>
      </g>
    </svg>
  </div>

  <div class="aperture__legend" data-aperture-legend>
    <span class="lg lg--a">classical</span>
    <span class="lg lg--b">hybrid</span>
    <span class="lg lg--c">post-quantum</span>
    <span class="lg lg--pruned">pruned by τ</span>
  </div>
</aside>

<style>
  .aperture {
    width: 100%;
    max-width: 400px;
    justify-self: end;
    align-self: center;
  }

  .aperture__frame {
    position: relative;
    aspect-ratio: 1;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  .aperture__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* The graph is created by the script, so its parts carry no scope
     attribute: they are reached through :global(). */
  .aperture :global(.fw-edge) {
    stroke: rgba(186, 198, 217, 0.34);
    stroke-width: 1;
  }
  .aperture :global(.fw-edge--leaf) {
    stroke: rgba(186, 198, 217, 0.22);
  }
  .aperture :global(.fw-edge--cross) {
    stroke: rgba(186, 198, 217, 0.5);
    stroke-dasharray: 2 4;
  }
  .aperture :global(.fw-edge--cross.is-pruned) {
    stroke: rgba(234, 148, 143, 0.85);
  }

  .fw-route {
    fill: none;
    stroke: var(--ieee-cyan);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 5 4;
    animation: route 1.3s linear infinite;
  }

  .aperture :global(.fw-sight) {
    stroke: rgba(255, 199, 44, 0.42);
    stroke-width: 1;
    stroke-dasharray: 1 5;
    stroke-linecap: round;
  }

  .aperture :global(.fw-node) {
    fill: var(--sky-black);
    stroke-width: 1.3;
  }
  .aperture :global(.fw-node--A) {
    stroke: var(--classical);
  }
  .aperture :global(.fw-node--B) {
    stroke: var(--hybrid);
  }
  .aperture :global(.fw-node--C) {
    stroke: var(--pq);
  }
  .aperture :global(.fw-node--leaf) {
    fill: rgba(186, 198, 217, 0.6);
    stroke: none;
  }
  .aperture :global(.fw-anchor) {
    fill: none;
    stroke: rgba(238, 242, 248, 0.55);
    stroke-width: 1;
  }

  .fw-polaris {
    fill: var(--ieee-yellow);
  }
  .fw-polaris-halo {
    fill: none;
    stroke: rgba(255, 199, 44, 0.45);
    stroke-width: 1;
  }

  .aperture :global(.fw-lbl) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.03em;
    fill: rgba(186, 198, 217, 0.8);
  }
  .aperture :global(.fw-lbl--iss) {
    fill: rgba(147, 169, 198, 0.8);
  }
  .aperture :global(.fw-lbl--leaf) {
    fill: var(--text);
  }
  .aperture .fw-lbl--polaris {
    fill: var(--ieee-yellow-75);
  }
  .aperture .fw-lbl--caption {
    fill: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .aperture__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .lg::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.45rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    vertical-align: 0.1em;
  }
  .lg--a::before {
    color: var(--classical);
  }
  .lg--b::before {
    color: var(--hybrid);
  }
  .lg--c::before {
    color: var(--pq);
  }
  .lg--pruned::before {
    width: 14px;
    height: 0;
    border: 0;
    border-top: 1px dashed rgba(234, 148, 143, 0.85);
    border-radius: 0;
    vertical-align: 0.25em;
  }

  @keyframes route {
    to {
      stroke-dashoffset: -18;
    }
  }

  /* One column (tablets): a larger chart with smaller type, since the view
     box is drawn bigger. */
  @media (max-width: 960px) {
    .aperture {
      justify-self: center;
      max-width: 520px;
    }
    .aperture :global(.fw-lbl) {
      font-size: 8.5px;
    }
  }

  /* Phones: the chart takes the full width and the names of the issuing CAs
     give way so the rest stay legible. */
  @media (max-width: 560px) {
    .aperture {
      max-width: none;
    }
    .aperture :global(.fw-lbl) {
      font-size: 9px;
    }
    .aperture :global(.fw-lbl--iss) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fw-route {
      animation: none;
    }
  }
</style>
