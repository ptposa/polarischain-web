---
import { constellationNodes, constellationEdges } from '../../data/constellation';
---

<div class="dive-graph" aria-hidden="true">
  <svg data-dive-edges>
    {constellationEdges.map(() => <line />)}
  </svg>
  <div>
    {
      constellationNodes.map((n) => (
        <div class={`gnode ${n.color}`}>
          <span class="gnode-ring" />
          <span class="gnode-dot" />
          <span class="gnode-label" set:html={n.label} />
          <span class="gnode-sub">{n.sub}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .dive-graph {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .dive-graph svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .dive-graph line {
    stroke: rgba(184, 170, 152, 0.35);
    stroke-width: 0.7;
    stroke-dasharray: 2 5;
  }
  .gnode {
    position: absolute;
    left: 50%;
    top: 50%;
    will-change: transform, opacity;
    opacity: 0;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .gnode-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg-cosmos);
    border: 1.4px solid currentColor;
    position: relative;
  }
  .gnode-dot::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: currentColor;
  }
  .gnode-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 0.6px solid currentColor;
    border-radius: 50%;
    opacity: 0.35;
  }
  .gnode-label {
    position: absolute;
    left: 16px;
    top: -6px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-soft);
  }
  .gnode-sub {
    position: absolute;
    left: 16px;
    top: 8px;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .gnode :global(sub) {
    font-size: 0.72em;
    line-height: 0;
  }
  .gnode.c-blue {
    color: #7ab3e8;
  }
  .gnode.c-gray {
    color: #b8aa98;
  }
  .gnode.c-gold {
    color: #e8c96a;
  }

  @media (max-width: 640px) {
    .gnode-label {
      font-size: 9.5px;
    }
    .gnode-sub {
      font-size: 9px;
    }
  }
</style>
