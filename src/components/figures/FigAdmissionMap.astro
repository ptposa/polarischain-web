---
// The definition of admissible paths read over the use-case route (thesis,
// figure mapa-de-la-admision), drawn as a matrix. The route runs down the
// left, key by key, with the certificates x1 to x4 as the edges between
// them; each condition of Definition 2 is a column, and each crossing says
// what that condition checks on that certificate. Under the matrix, the
// selection among the paths that pass. Two drawings, wide and narrow, as in
// every figure; the legend below is HTML, so it reflows on a phone, and
// hovering or focusing one of its entries lights its column.

const keys = [
  { name: 'Root B', sub: 'anchor tp', cls: 'box-accent' },
  { name: 'Intermediate B', cls: 'box-strong' },
  { name: 'Intermediate A', cls: 'box-strong' },
  { name: 'Issuing A', cls: 'box-strong' },
  {
    name: 'c<tspan baseline-shift="sub" font-size="0.75em">A</tspan>',
    sub: 'erp.ops.altair.example',
    mono: true,
    cls: 'box',
  },
];

const sub = (s: string) => `<tspan baseline-shift="sub" font-size="0.72em">${s}</tspan>`;

const conds = [
  {
    sym: `fresh${sub('d')}(M, t)`,
    head: 'the snapshot is recent',
    legend: 'fresh<sub>d</sub>(M, t)',
    text: 'The snapshot is recent: its checkpoint is no older than F<sub>d</sub><sup>cp</sup>. It guards the whole query, not one certificate.',
  },
  {
    sym: `Paths${sub('d,τ')}(t) ∩ 𝒰${sub('d')}`,
    head: 'valid, simple, h ≤ L_d',
    legend: 'Paths<sub>d,τ</sub>(t) ∩ 𝒰<sub>d</sub>',
    text: 'The path starts at a valid anchor entry tp of B, and its CA certificates x<sub>1</sub> to x<sub>3</sub> are valid at t, stay in B’s subgraph and repeat no key, with h = 3 ≤ L<sub>d</sub>. The presented certificate is not a CA certificate.',
  },
  {
    sym: `P ⊨${sub('d,c')} Φ`,
    head: 'the constraints hold',
    legend: 'P ⊨<sub>d,c</sub> Φ',
    text: 'From the initial state s<sub>0</sub>, each certificate moves the state with δ without falling to ⊥, and fin<sub>t</sub> closes the path with the presented certificate c<sub>A</sub>.',
  },
  {
    sym: `status${sub('t')}(P, i)`,
    head: 'each one held good',
    legend: 'status<sub>t</sub>(P, i)',
    text: 'Each certificate is held good by the list of its own issuer, entitled to sign it on this path, from the anchor down; the presented certificate may instead be exempt.',
  },
];

// One layout per drawing. Rows: the keys and, between them, the certificates.
const layouts = [
  {
    cls: 'fig-wide',
    vw: 760,
    keyX: 20,
    keyW: 160,
    keyH: 36,
    leafH: 42,
    key0: 92,
    step: 80,
    cols: [262, 392, 522, 652],
    colW: 130,
    wide: true,
  },
  {
    cls: 'fig-narrow',
    vw: 380,
    keyX: 6,
    keyW: 126,
    keyH: 34,
    leafH: 40,
    key0: 64,
    step: 66,
    cols: [170, 229, 288, 347],
    colW: 59,
    wide: false,
  },
].map((L) => {
  const kx = L.keyX + L.keyW / 2;
  const ky = keys.map((_, i) => L.key0 + i * L.step);
  const xy = ky.slice(0, -1).map((y) => y + L.step / 2);
  const top = L.key0 - L.keyH / 2 - 14;
  const bottom = ky[ky.length - 1] + L.leafH / 2 + 12;
  const selY = bottom + 34;
  const selH = L.wide ? 58 : 74;
  const headY = top - (L.wide ? 28 : 14);
  return { ...L, kx, ky, xy, top, bottom, headY, selY, selH, vh: selY + selH + 6 };
});

const check = (x: number, y: number) => `M${x - 5} ${y} L${x - 1.5} ${y + 3.5} L${x + 5} ${y - 4}`;
---

<div class="am">
  {
    layouts.map((L) => (
      <svg
        class={`svg-fig am-svg ${L.cls}`}
        viewBox={`0 0 ${L.vw} ${L.vh}`}
        role="img"
        aria-label="The conditions of an admissible path over the use-case route, and the selection"
      >
        <defs>
          <marker
            id={`am-ar-${L.cls}`}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto"
          >
            <path class="arrow-path" d="M0 0 L10 5 L0 10 z" />
          </marker>
          <marker
            id={`am-arm-${L.cls}`}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto"
          >
            <path class="arrow" d="M0 0 L10 5 L0 10 z" />
          </marker>
        </defs>

        {/* Columns: a tinted ground that lights on hover, and the header. */}
        {conds.map((c, j) => (
          <g class={`am-col am-col--${j + 1}`}>
            <rect
              class="am-colbg"
              x={L.cols[j] - L.colW / 2}
              y={L.top}
              width={L.colW}
              height={L.bottom - L.top}
            />
            {L.wide ? (
              <>
                <text
                  x={L.cols[j]}
                  y={L.headY}
                  text-anchor="middle"
                  class="am-sym"
                  set:html={c.sym}
                />
                <text x={L.cols[j]} y={L.headY + 18} text-anchor="middle" class="t-tiny">
                  {c.head === 'valid, simple, h ≤ L_d' ? (
                    <Fragment set:html={`valid, simple, h ≤ L${sub('d')}`} />
                  ) : (
                    c.head
                  )}
                </text>
              </>
            ) : (
              <text x={L.cols[j]} y={L.headY} text-anchor="middle" class="am-num">
                {j + 1}
              </text>
            )}
          </g>
        ))}

        {/* The frame of the matrix: a rule above and below, and faint
            guides along each certificate. */}
        <line class="am-rule" x1={L.keyX} x2={L.vw - 8} y1={L.top} y2={L.top} />
        <line class="am-rule" x1={L.keyX} x2={L.vw - 8} y1={L.bottom} y2={L.bottom} />
        {L.xy.map((y) => (
          <line class="am-guide" x1={L.kx + 26} x2={L.vw - 8} y1={y} y2={y} />
        ))}

        {/* The route: keys and certificates. */}
        {keys.map((k, i) => {
          const h = i === keys.length - 1 ? L.leafH : L.keyH;
          const y = L.ky[i];
          return (
            <>
              <rect class={k.cls} x={L.keyX} y={y - h / 2} width={L.keyW} height={h} />
              {k.sub ? (
                <>
                  <text
                    x={L.kx}
                    y={y - 3}
                    text-anchor="middle"
                    class="t-strong"
                    set:html={k.name}
                  />
                  <text
                    x={L.kx}
                    y={y + 12}
                    text-anchor="middle"
                    class={
                      k.mono ? (L.wide ? 't-mono am-dns' : 't-mono am-dns am-dns--n') : 't-tiny'
                    }
                  >
                    {k.sub}
                  </text>
                </>
              ) : (
                <text
                  x={L.kx}
                  y={y + 4.5}
                  text-anchor="middle"
                  class="t-strong"
                  set:html={k.name}
                />
              )}
            </>
          );
        })}
        {L.xy.map((y, i) => {
          const y1 = L.ky[i] + L.keyH / 2 + 2;
          const y2 = L.ky[i + 1] - (i + 1 === keys.length - 1 ? L.leafH : L.keyH) / 2 - 2;
          return (
            <>
              <line
                class="am-cert"
                x1={L.kx}
                x2={L.kx}
                y1={y1}
                y2={y2}
                marker-end={`url(#am-ar-${L.cls})`}
              />
              <text x={L.kx + 10} y={y + 4} class="t-path" set:html={`x${sub(String(i + 1))}`} />
            </>
          );
        })}

        {/* 1 · fresh: one bracket over the whole query. */}
        <path
          class="am-span"
          d={`M${L.cols[0] - 5} ${L.ky[0] - 12} H${L.cols[0]} V${L.ky[4] + 12} H${L.cols[0] - 5}`}
        />
        <text
          class="t-tiny"
          text-anchor="middle"
          transform={`translate(${L.cols[0] + 11} ${(L.ky[0] + L.ky[4]) / 2}) rotate(-90)`}
        >
          {L.wide ? 'the whole query, before any certificate' : 'the whole query'}
        </text>

        {/* 2 · Paths ∩ U: the anchor entry and the three CA certificates. */}
        <text
          x={L.cols[1]}
          y={L.ky[0] + 4}
          text-anchor="middle"
          class="am-cell"
          set:html={L.wide ? `tp ∈ TP${sub('d')}(t)` : 'tp'}
        />
        {[0, 1, 2].map((i) => (
          <path class="am-ok" d={check(L.cols[1], L.xy[i])} />
        ))}
        <text x={L.cols[1]} y={L.xy[3] + 4} text-anchor="middle" class="am-no t-halo">
          —
        </text>
        {L.wide && (
          <text x={L.cols[1]} y={L.xy[3] + 18} text-anchor="middle" class="t-tiny">
            not a CA certificate
          </text>
        )}

        {/* 3 · Φ: the initial state, δ on each certificate, fin_t to close. */}
        <text
          x={L.cols[2]}
          y={L.ky[0] + 4}
          text-anchor="middle"
          class="am-cell"
          set:html={`s${sub('0')}`}
        />
        {[0, 1, 2].map((i) => (
          <>
            <text x={L.cols[2] - 7} y={L.xy[i] + 4} text-anchor="middle" class="am-cell">
              δ
            </text>
            <path class="am-ok" d={check(L.cols[2] + 9, L.xy[i])} />
          </>
        ))}
        <text
          x={L.cols[2] - 7}
          y={L.xy[3] + 4}
          text-anchor="middle"
          class="am-cell"
          set:html={`fin${sub('t')}`}
        />
        <path class="am-ok" d={check(L.cols[2] + 14, L.xy[3])} />

        {/* 4 · status: every certificate, the presented one possibly exempt. */}
        {[0, 1, 2, 3].map((i) => (
          <path class="am-ok" d={check(L.cols[3], L.xy[i])} />
        ))}
        {L.wide && (
          <>
            <text x={L.cols[3]} y={L.xy[0] + 17} text-anchor="middle" class="t-tiny">
              list of tp
            </text>
            <text x={L.cols[3]} y={L.xy[3] + 17} text-anchor="middle" class="t-tiny">
              or exempt
            </text>
          </>
        )}

        {/* All four hold: the selection. */}
        <line
          class="edge"
          x1={(L.cols[0] + L.cols[3]) / 2}
          x2={(L.cols[0] + L.cols[3]) / 2}
          y1={L.bottom + 4}
          y2={L.selY - 3}
          marker-end={`url(#am-arm-${L.cls})`}
        />
        <text x={(L.cols[0] + L.cols[3]) / 2 + 10} y={L.bottom + 21} class="t-tiny">
          {L.wide ? 'all four hold: P is admissible' : 'all four hold'}
        </text>
        <rect class="box-accent" x={L.keyX} y={L.selY} width={L.vw - 8 - L.keyX} height={L.selH} />
        {L.wide ? (
          <>
            <text x={L.keyX + 16} y={L.selY + 25} class="am-sym" set:html={`P*${sub('d')}(c)`} />
            <text x={L.keyX + 110} y={L.selY + 25} class="t-strong">
              The selected path
            </text>
            <text x={L.keyX + 110} y={L.selY + 43} class="t-tiny">
              <Fragment
                set:html={`Under the first floor that leaves any (j*), the admissible path of least cost W${sub('d')}; on a tie, the first in the order of Sel.`}
              />
            </text>
          </>
        ) : (
          <>
            <text x={L.keyX + 12} y={L.selY + 23} class="am-sym" set:html={`P*${sub('d')}(c)`} />
            <text x={L.keyX + 86} y={L.selY + 23} class="t-strong">
              The selected path
            </text>
            <text x={L.keyX + 12} y={L.selY + 44} class="t-tiny">
              First floor that leaves any (j*), then the least
            </text>
            <text x={L.keyX + 12} y={L.selY + 59} class="t-tiny">
              <Fragment set:html={`cost W${sub('d')}; on a tie, the order of Sel.`} />
            </text>
          </>
        )}
      </svg>
    ))
  }

  <ol class="am__legend">
    {
      conds.map((c, j) => (
        <li data-c={j + 1} tabindex="0">
          <span class="am__n">{j + 1}</span>
          <span class="am__sym m" set:html={c.legend} />
          <span class="am__txt" set:html={c.text} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .am {
    max-width: var(--figure);
    margin-inline: auto;
  }

  .am-svg {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .am-svg.fig-narrow {
    display: none;
    max-width: 440px;
  }
  @media (max-width: 719px) {
    .am-svg.fig-wide {
      display: none;
    }
    .am-svg.fig-narrow {
      display: block;
    }
  }

  .am-svg .am-sym {
    font-family: var(--font-math);
    font-size: 15px;
    fill: var(--text);
  }
  .am-svg .am-num {
    font-size: 13px;
    fill: var(--text);
  }
  .am-svg .am-cell {
    font-family: var(--font-math);
    font-size: 13.5px;
    fill: var(--text);
  }
  .am-svg .am-no {
    fill: var(--fig-muted);
  }
  .am-svg .am-dns {
    fill: var(--fig-text);
  }
  .am-svg .am-dns--n {
    font-size: 9px;
  }

  .am-svg .am-ok {
    fill: none;
    stroke: var(--path);
    stroke-width: 1.6;
  }
  .am-svg .am-span {
    fill: none;
    stroke: var(--fig-stroke);
    stroke-width: 1;
  }
  .am-svg .am-cert {
    stroke: var(--path);
    stroke-width: 1.4;
  }
  .am-svg .am-rule {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .am-svg .am-guide {
    stroke: var(--rule);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  /* The column of the condition under the pointer, or in focus, lights. */
  .am-svg .am-colbg {
    fill: var(--path);
    fill-opacity: 0;
    transition: fill-opacity 0.25s ease;
  }
  .am:has([data-c='1']:is(:hover, :focus-visible)) .am-col--1 .am-colbg,
  .am:has([data-c='2']:is(:hover, :focus-visible)) .am-col--2 .am-colbg,
  .am:has([data-c='3']:is(:hover, :focus-visible)) .am-col--3 .am-colbg,
  .am:has([data-c='4']:is(:hover, :focus-visible)) .am-col--4 .am-colbg {
    fill-opacity: 0.08;
  }

  /* The legend: the conditions of Definition 2, numbered as the columns,
     set as the where blocks of the text, with rules only. */
  .am__legend {
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-figure);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-soft);
  }
  .am__legend li {
    display: grid;
    grid-template-columns: 1.4rem 11rem minmax(0, 1fr);
    gap: 0.2rem 0.8rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-top: 1px solid var(--rule);
    transition: background-color 0.25s ease;
  }
  .am__legend li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .am__legend li:hover,
  .am__legend li:focus-visible {
    outline: none;
    background: color-mix(in srgb, var(--path) 6%, transparent);
  }
  .am__n {
    color: var(--path);
  }
  .am__sym {
    font-size: 1rem;
    color: var(--ink-eq);
    white-space: nowrap;
  }

  @media (max-width: 719px) {
    .am__legend li {
      grid-template-columns: 1.4rem minmax(0, 1fr);
    }
    .am__txt {
      grid-column: 2;
    }
  }
</style>
