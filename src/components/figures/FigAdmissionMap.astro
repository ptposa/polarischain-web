---
// The definition of admissible paths read over the use-case route (thesis,
// figure mapa-de-la-admision). HTML, so it reflows on a phone. Each band
// names the certificates it checks; hovering or focusing it lights them in
// the chain above, with a few lines of CSS and no script.
const chain = [
  { id: 'k0', name: 'Root B', sub: 'anchor tp', cls: 'anchor' },
  { id: 'k1', name: 'Intermediate B' },
  { id: 'k2', name: 'Intermediate A' },
  { id: 'k3', name: 'Issuing A' },
  { id: 'k4', name: 'c<sub>A</sub>', sub: 'erp.ops.altair.example', cls: 'leaf' },
];
const bands = [
  {
    sym: 'fresh<sub>d</sub>(M, t)',
    text: 'The snapshot is recent: its checkpoint is no older than F<sub>d</sub><sup>cp</sup>. Without it there is no query at all.',
    lights: 'gate',
    cls: 'gate',
  },
  {
    sym: 'Paths<sub>d,τ</sub>(t) ∩ 𝒰<sub>d</sub>',
    text: 'The three CA certificates x<sub>1</sub> to x<sub>3</sub> are valid at t and join keys of B’s subgraph, without repeating any, and h ≤ L<sub>d</sub>.',
    lights: 'x1 x2 x3',
  },
  {
    sym: 'P ⊨<sub>d,c</sub> Φ',
    text: 'The state moves with δ from s<sub>0</sub> without falling to ⊥, and fin<sub>t</sub> closes the path with c<sub>A</sub>.',
    lights: 'x1 x2 x3 x4',
  },
  {
    sym: 'status<sub>t</sub>(P, i)',
    text: 'The list of whoever issued each x<sub>i</sub>, entitled to sign it on this path, holds it good, from the anchor to the presented certificate, which may be exempt.',
    lights: 'x1 x2 x3 x4',
  },
];
---

<div class="am">
  <div class="am__chain" aria-label="The use-case route">
    {
      chain.map((k, i) => (
        <>
          <span class:list={['am__key', k.cls && `am__key--${k.cls}`]}>
            <b set:html={k.name} />
            {k.sub && <small>{k.sub}</small>}
          </span>
          {i < chain.length - 1 && (
            <span class={`am__cert am__cert--x${i + 1}`} aria-hidden="true">
              x<sub>{i + 1}</sub>
            </span>
          )}
        </>
      ))
    }
  </div>
  <p class="am__count">
    <span>x<sub>1</sub> to x<sub>3</sub>: the h = 3 CA certificates of the path</span>
    <span>x<sub>4</sub>: the presented one, h + 1 = 4</span>
  </p>

  <ol class="am__bands">
    {
      bands.map((b) => (
        <li class:list={['am__band', b.cls && `am__band--${b.cls}`]} data-lights={b.lights} tabindex="0">
          <span class="am__sym m" set:html={b.sym} />
          <span class="am__txt" set:html={b.text} />
        </li>
      ))
    }
  </ol>
  <div class="am__sel">
    <span class="am__sym m">P*<sub>d</sub>(c)</span>
    <span class="am__txt"
      >Among the paths that meet everything: the first floor of the list that leaves any (<span class="m">j*</span>), the least cost <span class="m">W<sub>d</sub></span> and, on a tie, the order of <span class="m">Sel</span>. It is the route that goes on to explicit validation.</span
    >
  </div>
</div>

<style>
  .am {
    max-width: var(--figure);
    margin-inline: auto;
    font-family: var(--font-figure);
    color: var(--fig-text);
  }

  .am__chain {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0;
  }

  .am__key {
    display: grid;
    flex: 1 1 0;
    min-width: 6.5rem;
    padding: 0.5rem 0.4rem;
    border: 1px solid var(--path);
    border-radius: 3px;
    background: var(--ground-raise);
    text-align: center;
    font-size: 0.875rem;
  }
  .am__key b {
    font-weight: 500;
    color: var(--text);
  }
  .am__key small {
    font-size: 0.6875rem;
    color: var(--fig-muted);
    overflow-wrap: anywhere;
  }
  .am__key--leaf small {
    font-family: var(--font-mono);
  }
  .am__key--anchor {
    border-color: var(--anchor);
  }
  .am__key--leaf {
    flex-grow: 1.7;
    border-color: var(--fig-stroke);
  }

  /* A certificate is the arrow between two keys. */
  .am__cert {
    position: relative;
    flex: 0 0 2.6rem;
    height: 1.4rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--fig-muted);
    transition: color 0.25s ease;
  }
  .am__cert::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 0;
    border-bottom: 1.5px solid var(--fig-stroke);
    transition: border-color 0.25s ease;
  }
  .am__cert::before {
    content: '';
    position: absolute;
    right: 0.15rem;
    bottom: -0.25rem;
    border: 0.28rem solid transparent;
    border-left-color: var(--fig-stroke);
    transition: border-color 0.25s ease;
  }

  .am__count {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0.7rem 0 1.4rem;
    font-size: 0.8125rem;
    color: var(--fig-muted);
  }

  .am__bands {
    margin: 0;
    padding: 0.6rem;
    list-style: none;
    border: 1px dashed var(--rule-strong);
    border-radius: 4px;
  }

  .am__band,
  .am__sel {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    align-items: baseline;
    padding: 0.7rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--path) 55%, transparent);
    border-radius: 3px;
    background: color-mix(in srgb, var(--path) 5%, transparent);
    font-size: 0.9375rem;
    line-height: 1.45;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .am__band + .am__band {
    margin-top: 0.5rem;
  }
  .am__band:hover,
  .am__band:focus-visible {
    outline: none;
    border-color: var(--path);
    background: color-mix(in srgb, var(--path) 12%, transparent);
  }

  .am__band--gate {
    border-color: var(--rule-strong);
    background: var(--ground-raise);
  }

  .am__sym {
    font-size: 1.05rem;
    color: var(--text);
    white-space: nowrap;
  }

  .am__sel {
    position: relative;
    margin-top: 1.4rem;
    border-color: var(--brass);
    background: color-mix(in srgb, var(--brass) 7%, transparent);
  }
  .am__sel::before {
    content: '↓';
    position: absolute;
    left: 50%;
    top: -1.35rem;
    transform: translateX(-50%);
    color: var(--fig-muted);
  }

  /* Light the certificates that the hovered band checks. */
  .am:has([data-lights~='x1']:is(:hover, :focus-visible)) .am__cert--x1,
  .am:has([data-lights~='x2']:is(:hover, :focus-visible)) .am__cert--x2,
  .am:has([data-lights~='x3']:is(:hover, :focus-visible)) .am__cert--x3,
  .am:has([data-lights~='x4']:is(:hover, :focus-visible)) .am__cert--x4 {
    color: var(--path);
  }
  .am:has([data-lights~='x1']:is(:hover, :focus-visible)) .am__cert--x1::after,
  .am:has([data-lights~='x2']:is(:hover, :focus-visible)) .am__cert--x2::after,
  .am:has([data-lights~='x3']:is(:hover, :focus-visible)) .am__cert--x3::after,
  .am:has([data-lights~='x4']:is(:hover, :focus-visible)) .am__cert--x4::after {
    border-bottom-color: var(--path);
  }
  .am:has([data-lights~='x1']:is(:hover, :focus-visible)) .am__cert--x1::before,
  .am:has([data-lights~='x2']:is(:hover, :focus-visible)) .am__cert--x2::before,
  .am:has([data-lights~='x3']:is(:hover, :focus-visible)) .am__cert--x3::before,
  .am:has([data-lights~='x4']:is(:hover, :focus-visible)) .am__cert--x4::before {
    border-left-color: var(--path);
  }

  @media (max-width: 719px) {
    .am__chain {
      flex-direction: column;
      align-items: stretch;
    }
    .am__key {
      min-width: 0;
    }
    .am__cert {
      flex: 0 0 1.8rem;
      height: 1.8rem;
      line-height: 1.8rem;
      padding-left: 1.2rem;
      text-align: left;
    }
    .am__cert::after {
      left: 0.6rem;
      right: auto;
      top: 0.2rem;
      bottom: 0.2rem;
      border-bottom: 0;
      border-left: 1.5px solid var(--fig-stroke);
    }
    .am__cert::before {
      left: 0.32rem;
      right: auto;
      bottom: -0.1rem;
      border-left-color: transparent;
      border-top-color: var(--fig-stroke);
    }
    .am__band,
    .am__sel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
