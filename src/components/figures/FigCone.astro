---
// The cone of trust of receiver B (thesis, figures cono-de-confinamiento and
// del-grafo-al-cono). Three nested sets: every key of the common graph, the
// subgraph of B (the keys that meet its floor and its lists) and, inside it,
// the cone, the keys B reaches from its anchor. The cone is drawn as the
// beam of a radar: an open sector from the anchor whose orange light fades
// towards its mouth, swept by a slow beam and by rings that leave the anchor.
// Domain M stays outside: it certifies a key of its own under the name of
// Intermediate A and signs with it a list that revokes A's certificates, and
// nothing changes for B. The reader changes the floor of B: with (hybrid, 0)
// Intermediate A, a traditional key, leaves the subgraph and the cone bends
// back to B's own branch. Without script the figure shows the traditional
// floor, as in the text. Motion stops under prefers-reduced-motion.

// Wide drawing: apex at the anchor, radius 320, half-angle 40 degrees; the
// strict cone keeps the left edge and closes 12 degrees right of the axis.
const W = { ax: 330, ay: 96, r: 320 };
const wideCone = `M${W.ax} ${W.ay} L124 341 A${W.r} ${W.r} 0 0 0 536 341 Z`;
const strictCone = `M${W.ax} ${W.ay} L124 341 A${W.r} ${W.r} 0 0 0 396.5 409 Z`;
const wideRim = `M124 341 L${W.ax} ${W.ay} L536 341`;
const strictRim = `M124 341 L${W.ax} ${W.ay} L396.5 409`;
const wideBeam = `M${W.ax} ${W.ay} L307.7 415.2 A${W.r} ${W.r} 0 0 0 352.3 415.2 Z`;

// Narrow drawing: apex 190,74, radius 300, half-angle 34 degrees; the strict
// cone closes 10 degrees right of the axis.
const N = { ax: 190, ay: 74, r: 300 };
const nWideCone = `M${N.ax} ${N.ay} L22.2 322.7 A${N.r} ${N.r} 0 0 0 357.8 322.7 Z`;
const nStrictCone = `M${N.ax} ${N.ay} L22.2 322.7 A${N.r} ${N.r} 0 0 0 242.1 369.4 Z`;
const nWideRim = `M22.2 322.7 L${N.ax} ${N.ay} L357.8 322.7`;
const nStrictRim = `M22.2 322.7 L${N.ax} ${N.ay} L242.1 369.4`;
const nBeam = `M${N.ax} ${N.ay} L169.1 373.3 A${N.r} ${N.r} 0 0 0 210.9 373.3 Z`;

const ORANGE = '#f0893a';
---

<div class="cn" data-cone>
  <svg class="svg-fig fig-wide cn-svg" viewBox="0 0 760 500" role="img" aria-labelledby="cn-t cn-d">
    <title id="cn-t">The cone of trust of receiver B</title>
    <desc id="cn-d">
      Three nested sets. The keys of the common graph contain the subgraph of B, the keys that meet its
      floor and its lists, and the subgraph contains the cone of trust, the keys B reaches from its anchor
      Root B: Intermediate B, Issuing B and, through the cross-certificate, Intermediate A and Issuing A.
      Domain M meets the floor but no certificate leads to it, so the revocation list it signs with a key
      named like Intermediate A changes no decision of B. Intermediate E, excluded by B, and Root F, a weak
      key, are outside the subgraph. With the floor (hybrid, 0) Intermediate A leaves the subgraph and the
      cone shrinks to B's own branch.
    </desc>

    <defs>
      <radialGradient id="cn-glow" gradientUnits="userSpaceOnUse" cx={W.ax} cy={W.ay} r={W.r}>
        <stop offset="0" stop-color={ORANGE} stop-opacity="0.55" />
        <stop offset="0.3" stop-color={ORANGE} stop-opacity="0.3" />
        <stop offset="0.7" stop-color={ORANGE} stop-opacity="0.1" />
        <stop offset="1" stop-color={ORANGE} stop-opacity="0" />
      </radialGradient>
      <linearGradient id="cn-rim" gradientUnits="userSpaceOnUse" x1={W.ax} y1={W.ay} x2={W.ax} y2={W.ay + W.r}>
        <stop offset="0" stop-color={ORANGE} stop-opacity="1" />
        <stop offset="1" stop-color={ORANGE} stop-opacity="0" />
      </linearGradient>
      <linearGradient id="cn-beam" gradientUnits="userSpaceOnUse" x1={W.ax} y1={W.ay} x2={W.ax} y2={W.ay + W.r}>
        <stop offset="0" stop-color="#ffd2a6" stop-opacity="0.5" />
        <stop offset="1" stop-color={ORANGE} stop-opacity="0" />
      </linearGradient>
      <clipPath id="cn-clip-w"><path d={wideCone} /></clipPath>
      <clipPath id="cn-clip-s"><path d={strictCone} /></clipPath>
      <marker id="cn-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path class="arrow" d="M0 0 L10 5 L0 10 z" />
      </marker>
      <marker id="cn-arp" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path class="arrow-path" d="M0 0 L10 5 L0 10 z" />
      </marker>
      <marker id="cn-ard" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path class="arrow-deny" d="M0 0 L10 5 L0 10 z" />
      </marker>
    </defs>

    <!-- The common graph and the subgraph of B -->
    <rect class="box-plain" x="10" y="10" width="740" height="440" />
    <text x="24" y="30" class="t-label">KEYS OF THE COMMON GRAPH V &#183; the same for every domain</text>
    <rect class="box-dash" x="30" y="44" width="560" height="396" />
    <text x="44" y="64" class="t-label">SUBGRAPH OF B &#183; keys that meet its floor and its lists</text>

    <!-- The cone: two shapes, one per floor, crossfaded -->
    <g class="cn-cone cn-cone--wide">
      <path d={wideCone} fill="url(#cn-glow)" />
      <g clip-path="url(#cn-clip-w)">
        <path class="cn-beam" d={wideBeam} fill="url(#cn-beam)" />
        <circle class="cn-ring" cx={W.ax} cy={W.ay} r={W.r} />
        <circle class="cn-ring cn-ring--late" cx={W.ax} cy={W.ay} r={W.r} />
      </g>
      <path class="cn-rim" d={wideRim} stroke="url(#cn-rim)" />
    </g>
    <g class="cn-cone cn-cone--strict">
      <path d={strictCone} fill="url(#cn-glow)" />
      <g clip-path="url(#cn-clip-s)">
        <path class="cn-beam" d={wideBeam} fill="url(#cn-beam)" />
        <circle class="cn-ring" cx={W.ax} cy={W.ay} r={W.r} />
        <circle class="cn-ring cn-ring--late" cx={W.ax} cy={W.ay} r={W.r} />
      </g>
      <path class="cn-rim" d={strictRim} stroke="url(#cn-rim)" />
    </g>
    <text x="236" y="420" class="t-label cn-t-cone">CONE OF TRUST OF B</text>

    <!-- Certificates inside the cone -->
    <path class="edge" d="M330 116 V153" marker-end="url(#cn-ar)" />
    <path class="edge" d="M312 195 L268 233" marker-end="url(#cn-ar)" />
    <path class="edge-path cn-cross" d="M348 195 L402 233" marker-end="url(#cn-arp)" />
    <path class="edge cn-a" d="M420 275 V323" marker-end="url(#cn-ar)" />
    <path class="edge cn-a" d="M420 365 V376" />
    <circle class="cn-badge" cx="384" cy="210" r="8" />
    <text x="384" y="214" text-anchor="middle" class="t-tiny cn-badge-t">1</text>

    <!-- Keys of the cone -->
    <rect class="box-accent" x="274" y="76" width="112" height="40" rx="3" />
    <text x="330" y="94" text-anchor="middle" class="t-strong">Root B</text>
    <text x="330" y="109" text-anchor="middle" class="t-tiny">anchor &#183; (hybrid, 3)</text>

    <rect class="cn-key" x="274" y="155" width="112" height="40" rx="3" />
    <text x="330" y="173" text-anchor="middle" class="t-strong">Intermediate B</text>
    <text x="330" y="188" text-anchor="middle" class="t-tiny">(hybrid, 3)</text>

    <rect class="cn-key" x="194" y="235" width="112" height="40" rx="3" />
    <text x="250" y="253" text-anchor="middle" class="t-strong">Issuing B</text>
    <text x="250" y="268" text-anchor="middle" class="t-tiny">(hybrid, 3)</text>

    <rect class="cn-key cn-a" x="364" y="235" width="112" height="40" rx="3" />
    <text x="420" y="253" text-anchor="middle" class="t-strong cn-a-t">Intermediate A</text>
    <text x="420" y="268" text-anchor="middle" class="t-tiny cn-wide-only">(traditional, 0)</text>
    <text x="420" y="268" text-anchor="middle" class="t-tiny t-deny cn-strict-only">below the floor</text>

    <rect class="cn-key cn-a" x="364" y="325" width="112" height="40" rx="3" />
    <text x="420" y="343" text-anchor="middle" class="t-strong cn-a-t">Issuing A</text>
    <text x="420" y="358" text-anchor="middle" class="t-tiny cn-wide-only">(traditional, 0)</text>
    <text x="420" y="358" text-anchor="middle" class="t-tiny t-deny cn-strict-only">cut off with it</text>

    <text x="420" y="392" text-anchor="middle" class="t-mono t-halo">erp.ops.altair.example</text>
    <text x="420" y="407" text-anchor="middle" class="t-tiny t-allow t-halo cn-wide-only">client of A &#183; admitted</text>
    <text x="420" y="407" text-anchor="middle" class="t-tiny t-deny t-halo cn-strict-only">client of A &#183; no route</text>

    <!-- Domain M: in the subgraph, outside the cone -->
    <text x="40" y="96" class="t-label">DOMAIN M</text>
    <rect class="box" x="37" y="112" width="96" height="36" rx="3" />
    <text x="85" y="134" text-anchor="middle">Root M</text>
    <rect class="box" x="37" y="194" width="96" height="40" rx="3" />
    <text x="85" y="211" text-anchor="middle">Key K&#8242;</text>
    <text x="85" y="225" text-anchor="middle" class="t-tiny">named Intermediate A</text>
    <rect class="box" x="37" y="290" width="96" height="44" rx="3" />
    <text x="85" y="307" text-anchor="middle">Revocation list</text>
    <text x="85" y="322" text-anchor="middle" class="t-tiny">signed with K&#8242;</text>
    <path class="edge" d="M85 148 V192" marker-end="url(#cn-ar)" />
    <path class="edge" d="M85 234 V288" marker-end="url(#cn-ar)" />
    <path class="edge-deny cn-bounce" d="M133 304 L156 287" />
    <path class="cn-x" d="M156 281 L168 293 M168 281 L156 293" />
    <text x="85" y="354" text-anchor="middle" class="t-tiny">no key of the cone signs it:</text>
    <text x="85" y="368" text-anchor="middle" class="t-tiny t-strong">no decision of B changes</text>

    <!-- Outside the subgraph -->
    <text x="612" y="100" class="t-label">OUTSIDE THE SUBGRAPH</text>
    <rect class="box-deny" x="612" y="126" width="120" height="44" rx="3" />
    <text x="672" y="145" text-anchor="middle">Intermediate E</text>
    <text x="672" y="160" text-anchor="middle" class="t-tiny t-deny">excluded, in D<tspan baseline-shift="sub" font-size="8">B</tspan></text>
    <rect class="box-deny" x="612" y="236" width="120" height="44" rx="3" />
    <text x="672" y="255" text-anchor="middle">Root F</text>
    <text x="672" y="270" text-anchor="middle" class="t-tiny t-deny">weak key</text>
    <rect class="box-deny cn-strict-only" x="612" y="336" width="120" height="44" rx="3" />
    <text x="672" y="355" text-anchor="middle" class="cn-strict-only">Intermediate A</text>
    <text x="672" y="370" text-anchor="middle" class="t-tiny t-deny cn-strict-only">now joins them</text>

    <!-- Legend -->
    <rect x="24" y="466" width="18" height="10" fill="url(#cn-glow)" stroke={ORANGE} stroke-width="0.8" />
    <text x="48" y="475" class="t-tiny">cone of trust of B</text>
    <rect class="box-dash" x="168" y="466" width="18" height="10" />
    <text x="192" y="475" class="t-tiny">subgraph of B</text>
    <rect class="box-deny" x="290" y="466" width="18" height="10" />
    <text x="314" y="475" class="t-tiny">outside the subgraph</text>
    <circle class="cn-badge" cx="458" cy="471" r="7" />
    <text x="458" y="474.5" text-anchor="middle" class="t-tiny cn-badge-t">1</text>
    <text x="470" y="475" class="t-tiny">cross-certificate of B to A, whose constraints bound what hangs from it</text>
  </svg>

  <svg class="svg-fig fig-narrow cn-svg" viewBox="0 0 380 640" role="img" aria-labelledby="cnn-t">
    <title id="cnn-t">The cone of trust of receiver B</title>
    <defs>
      <radialGradient id="cnn-glow" gradientUnits="userSpaceOnUse" cx={N.ax} cy={N.ay} r={N.r}>
        <stop offset="0" stop-color={ORANGE} stop-opacity="0.55" />
        <stop offset="0.3" stop-color={ORANGE} stop-opacity="0.3" />
        <stop offset="0.7" stop-color={ORANGE} stop-opacity="0.1" />
        <stop offset="1" stop-color={ORANGE} stop-opacity="0" />
      </radialGradient>
      <linearGradient id="cnn-rim" gradientUnits="userSpaceOnUse" x1={N.ax} y1={N.ay} x2={N.ax} y2={N.ay + N.r}>
        <stop offset="0" stop-color={ORANGE} stop-opacity="1" />
        <stop offset="1" stop-color={ORANGE} stop-opacity="0" />
      </linearGradient>
      <linearGradient id="cnn-beam" gradientUnits="userSpaceOnUse" x1={N.ax} y1={N.ay} x2={N.ax} y2={N.ay + N.r}>
        <stop offset="0" stop-color="#ffd2a6" stop-opacity="0.5" />
        <stop offset="1" stop-color={ORANGE} stop-opacity="0" />
      </linearGradient>
      <clipPath id="cnn-clip-w"><path d={nWideCone} /></clipPath>
      <clipPath id="cnn-clip-s"><path d={nStrictCone} /></clipPath>
      <marker id="cnn-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path class="arrow" d="M0 0 L10 5 L0 10 z" />
      </marker>
      <marker id="cnn-arp" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path class="arrow-path" d="M0 0 L10 5 L0 10 z" />
      </marker>
    </defs>

    <rect class="box-plain" x="4" y="4" width="372" height="562" />
    <text x="14" y="22" class="t-label">KEYS OF THE COMMON GRAPH V</text>
    <rect class="box-dash" x="12" y="30" width="356" height="444" />
    <text x="22" y="47" class="t-label">SUBGRAPH OF B</text>

    <g class="cn-cone cn-cone--wide">
      <path d={nWideCone} fill="url(#cnn-glow)" />
      <g clip-path="url(#cnn-clip-w)">
        <path class="cn-beam cn-beam--n" d={nBeam} fill="url(#cnn-beam)" />
        <circle class="cn-ring cn-ring--n" cx={N.ax} cy={N.ay} r={N.r} />
        <circle class="cn-ring cn-ring--n cn-ring--late" cx={N.ax} cy={N.ay} r={N.r} />
      </g>
      <path class="cn-rim" d={nWideRim} stroke="url(#cnn-rim)" />
    </g>
    <g class="cn-cone cn-cone--strict">
      <path d={nStrictCone} fill="url(#cnn-glow)" />
      <g clip-path="url(#cnn-clip-s)">
        <path class="cn-beam cn-beam--n" d={nBeam} fill="url(#cnn-beam)" />
        <circle class="cn-ring cn-ring--n" cx={N.ax} cy={N.ay} r={N.r} />
        <circle class="cn-ring cn-ring--n cn-ring--late" cx={N.ax} cy={N.ay} r={N.r} />
      </g>
      <path class="cn-rim" d={nStrictRim} stroke="url(#cnn-rim)" />
    </g>

    <path class="edge" d="M190 92 V126" marker-end="url(#cnn-ar)" />
    <path class="edge" d="M172 164 L138 206" marker-end="url(#cnn-ar)" />
    <path class="edge-path cn-cross" d="M208 164 L242 206" marker-end="url(#cnn-arp)" />
    <path class="edge cn-a" d="M255 244 V282" marker-end="url(#cnn-ar)" />
    <circle class="cn-badge" cx="232" cy="182" r="7" />
    <text x="232" y="185.5" text-anchor="middle" class="t-tiny cn-badge-t">1</text>

    <rect class="box-accent" x="138" y="56" width="104" height="36" rx="3" />
    <text x="190" y="72" text-anchor="middle" class="t-strong">Root B</text>
    <text x="190" y="86" text-anchor="middle" class="t-tiny">anchor</text>
    <rect class="cn-key" x="138" y="128" width="104" height="36" rx="3" />
    <text x="190" y="144" text-anchor="middle" class="t-strong">Intermediate B</text>
    <text x="190" y="158" text-anchor="middle" class="t-tiny">(hybrid, 3)</text>
    <rect class="cn-key" x="73" y="208" width="104" height="36" rx="3" />
    <text x="125" y="224" text-anchor="middle" class="t-strong">Issuing B</text>
    <text x="125" y="238" text-anchor="middle" class="t-tiny">(hybrid, 3)</text>
    <rect class="cn-key cn-a" x="203" y="208" width="104" height="36" rx="3" />
    <text x="255" y="224" text-anchor="middle" class="t-strong cn-a-t">Intermediate A</text>
    <text x="255" y="238" text-anchor="middle" class="t-tiny cn-wide-only">(traditional, 0)</text>
    <text x="255" y="238" text-anchor="middle" class="t-tiny t-deny cn-strict-only">below the floor</text>
    <rect class="cn-key cn-a" x="203" y="284" width="104" height="36" rx="3" />
    <text x="255" y="300" text-anchor="middle" class="t-strong cn-a-t">Issuing A</text>
    <text x="255" y="314" text-anchor="middle" class="t-tiny cn-wide-only">(traditional, 0)</text>
    <text x="255" y="314" text-anchor="middle" class="t-tiny t-deny cn-strict-only">cut off with it</text>
    <text x="255" y="338" text-anchor="middle" class="t-mono t-halo">erp.ops.altair.example</text>
    <text x="255" y="352" text-anchor="middle" class="t-tiny t-allow t-halo cn-wide-only">admitted</text>
    <text x="255" y="352" text-anchor="middle" class="t-tiny t-deny t-halo cn-strict-only">no route</text>

    <text x="22" y="398" class="t-label">DOMAIN M</text>
    <text x="22" y="411" class="t-tiny">B does not reach its keys</text>
    <rect class="box" x="16" y="420" width="88" height="40" rx="3" />
    <text x="60" y="444" text-anchor="middle">Root M</text>
    <rect class="box" x="116" y="420" width="104" height="40" rx="3" />
    <text x="168" y="437" text-anchor="middle">Key K&#8242;</text>
    <text x="168" y="451" text-anchor="middle" class="t-tiny">named Int. A</text>
    <rect class="box" x="232" y="420" width="128" height="40" rx="3" />
    <text x="296" y="437" text-anchor="middle">Revocation list</text>
    <text x="296" y="451" text-anchor="middle" class="t-tiny">signed with K&#8242;</text>
    <path class="edge" d="M104 440 H114" marker-end="url(#cnn-ar)" />
    <path class="edge" d="M220 440 H230" marker-end="url(#cnn-ar)" />
    <path class="edge-deny cn-bounce" d="M300 418 V388" />
    <path class="cn-x" d="M294 376 L306 388 M306 376 L294 388" />
    <text x="290" y="384" text-anchor="end" class="t-tiny t-strong t-halo">no decision of B changes</text>

    <text x="14" y="492" class="t-label">OUTSIDE THE SUBGRAPH</text>
    <rect class="box-deny" x="14" y="502" width="110" height="44" rx="3" />
    <text x="69" y="521" text-anchor="middle">Intermediate E</text>
    <text x="69" y="536" text-anchor="middle" class="t-tiny t-deny">excluded by B</text>
    <rect class="box-deny" x="134" y="502" width="110" height="44" rx="3" />
    <text x="189" y="521" text-anchor="middle">Root F</text>
    <text x="189" y="536" text-anchor="middle" class="t-tiny t-deny">weak key</text>
    <rect class="box-deny cn-strict-only" x="254" y="502" width="110" height="44" rx="3" />
    <text x="309" y="521" text-anchor="middle" class="cn-strict-only">Intermediate A</text>
    <text x="309" y="536" text-anchor="middle" class="t-tiny t-deny cn-strict-only">now joins them</text>

    <rect x="8" y="584" width="16" height="10" fill="url(#cnn-glow)" stroke={ORANGE} stroke-width="0.8" />
    <text x="30" y="593" class="t-tiny">cone of trust of B</text>
    <rect class="box-dash" x="150" y="584" width="16" height="10" />
    <text x="172" y="593" class="t-tiny">subgraph of B</text>
    <circle class="cn-badge" cx="15" cy="616" r="7" />
    <text x="15" y="619.5" text-anchor="middle" class="t-tiny cn-badge-t">1</text>
    <text x="28" y="620" class="t-tiny">cross-certificate of B to A, which bounds what hangs from it</text>
  </svg>

  <div class="cn__controls">
    <fieldset class="cn__floor">
      <legend>Floor τ of receiver B</legend>
      <label><input type="radio" name="cn-floor" value="traditional" checked data-cn-floor /> (traditional, 0)</label>
      <label><input type="radio" name="cn-floor" value="hybrid" data-cn-floor /> (hybrid, 0)</label>
    </fieldset>
  </div>
  <p class="cn__out" aria-live="polite" data-cn-out>
    With the floor (traditional, 0) the cone holds Root B, Intermediate B, Issuing B and, through the cross-certificate, Intermediate A and Issuing A, so the client <code>erp.ops.altair.example</code> has a route. Domain M meets the floor but stays outside the cone, and nothing it signs changes a decision of B.
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-cone]');
  if (root) {
    const out = root.querySelector<HTMLElement>('[data-cn-out]')!;
    const floors = Array.from(root.querySelectorAll<HTMLInputElement>('[data-cn-floor]'));
    const render = (): void => {
      const strict = floors.find((f) => f.checked)?.value === 'hybrid';
      root.classList.toggle('is-strict', strict);
      out.innerHTML = strict
        ? 'With the floor (hybrid, 0) Intermediate A, a traditional key, leaves the subgraph of B, and the cone bends back to B’s own branch. The client <code>erp.ops.altair.example</code> is denied: no certificate was revoked and the relation with A is intact, and the route returns as soon as A offers a key that meets the floor.'
        : 'With the floor (traditional, 0) the cone holds Root B, Intermediate B, Issuing B and, through the cross-certificate, Intermediate A and Issuing A, so the client <code>erp.ops.altair.example</code> has a route. Domain M meets the floor but stays outside the cone, and nothing it signs changes a decision of B.';
    };
    floors.forEach((f) => f.addEventListener('change', render));
    render();
  }
</script>

<style>
  .cn {
    max-width: 62rem;
    margin-inline: auto;
  }

  .cn-svg {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .cn-svg.fig-wide {
    max-width: 62rem;
  }
  .cn-svg.fig-narrow {
    display: none;
    max-width: 440px;
