---
// The state space S as a card with six slots (thesis, figure
// anatomia-del-estado). Built in HTML rather than SVG, so the same drawing
// reflows on a phone: the three columns stack and the product signs stay
// between the factors. Hovering or focusing a slot lights its row.
const slots = [
  { f: 'ℕ<sub>∞</sub>', what: 'Remaining depth', rfc: 'max_path_length', v: '1' },
  { f: '𝒯', what: 'Permitted name subtrees', rfc: 'permitted_subtrees', v: '<code>ops.altair.example</code>', pair: true },
  { f: '𝒯', what: 'Excluded name subtrees', rfc: 'excluded_subtrees', v: '<code>ext.ops.altair.example</code>', pair: true },
  { f: '𝒢<sub>pol</sub>', what: 'Graph of valid policies', rfc: 'valid_policy_graph', v: 'p<sub>B</sub>, expecting p<sub>A</sub>' },
  { f: 'ℕ<sub>∞</sub><sup>3</sup>', what: 'Three policy counters', rfc: 'explicit_policy · inhibit_anyPolicy · policy_mapping', v: '(0, ∞, ∞)' },
  { f: '2<sup>OID</sup>', what: 'Initial policies the receiver accepts', rfc: 'user-initial-policy-set', v: '{ p<sub>B</sub> }' },
];

// The rows, grouped: the two name slots share a group, so the bracket that
// joins them is drawn once, on the group, and is never cut between rows.
const groups = [[0], [1, 2], [3], [4], [5]];
---

<div class="st" role="group" aria-label="The six slots of a validation state">
  <div class="st__head" aria-hidden="true">
    <span class="m">S =</span>
    <span>What each slot keeps</span>
    <span>A state s ∈ S, at Intermediate A</span>
  </div>
  <ol class="st__rows">
    {
      groups.map((g) => {
        const rows = g.map((i) => (
          <li class="st__row" tabindex="0">
            <span class="st__f m">
              <span set:html={slots[i].f} />
              {i < slots.length - 1 && <span class="st__x" aria-hidden="true">×</span>}
            </span>
            <span class="st__what">
              {slots[i].what}
              <code class="st__rfc">{slots[i].rfc}</code>
            </span>
            <span class="st__v m" set:html={slots[i].v} />
          </li>
        ));
        return g.length > 1 ? (
          <li class="st__pair">
            <ol class="st__sub">{rows}</ol>
          </li>
        ) : (
          rows
        );
      })
    }
  </ol>
  <p class="st__note">
    The sign × reads “and”: a state holds one value of each slot at once, and <span class="m">S</span> is the set of every combination. <span class="m">𝒯</span> appears twice, joined by the bracket, because the permitted and the excluded names are two values of the same type.
  </p>
</div>

<style>
  .st {
    /* Vertical padding of a row. The factor boxes fill the row, so the gap
       between two boxes is twice this, and the product sign and the ends of
       the bracket are placed from it. */
    --st-pad: 0.45rem;
    /* Width of the column of factors and the gap after it: the rules between
       rows start after that column, so they never cross a product sign. */
    --st-fcol: 4.5rem;
    --st-gap: 1.2rem;
    max-width: var(--figure);
    margin-inline: auto;
    font-family: var(--font-figure);
    color: var(--fig-text);
  }

  .st__head,
  .st__row {
    display: grid;
    grid-template-columns: var(--st-fcol) minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 0 var(--st-gap);
    align-items: center;
  }

  .st__head {
    padding: 0 0 0.6rem;
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: var(--fig-muted);
  }

  .st__head .m {
    font-size: 1.1rem;
    color: var(--text);
  }

  .st__rows,
  .st__sub {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .st__pair {
    position: relative;
  }

  /* The bracket: from the top of the first name slot to the foot of the
     second, with a short tick at each end. */
  .st__pair::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: var(--st-pad);
    bottom: var(--st-pad);
    width: 0.45rem;
    border: 1px solid var(--brass);
    border-right: 0;
  }

  .st__row {
    position: relative;
    padding: var(--st-pad) 0;
    transition: background-color 0.25s ease;
  }

  /* The rule above each row starts after the column of factors; only the
     first and the last rules, which close the whole product, run across. */
  .st__row::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(var(--st-fcol) + var(--st-gap));
    right: 0;
    border-top: 1px solid var(--rule);
  }

  .st__rows > .st__row:first-child::before {
    left: 0;
  }

  .st__rows > .st__row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .st__row:hover,
  .st__row:focus-visible {
    outline: none;
    background: color-mix(in srgb, var(--brass) 8%, transparent);
  }

  .st__f {
    position: relative;
    display: flex;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    padding: 0.3rem 0;
    border: 1px solid var(--fig-stroke);
    background: var(--ground-raise);
    font-size: 1.15rem;
    color: var(--text);
  }

  /* The product sign hangs between this factor and the next. */
  .st__x {
    position: absolute;
    left: 50%;
    bottom: calc(-1 * var(--st-pad) - 0.5em);
    /* The glyph sits above the middle of its line box; this lowers its ink
       to the middle of the gap between the two boxes. */
    transform: translate(-50%, 0.1em);
    font-size: 0.95rem;
    line-height: 1;
    color: var(--brass-soft);
  }

  .st__what {
    display: grid;
    gap: 0.05rem;
    line-height: 1.3;
    font-size: 0.95rem;
    color: var(--text);
  }

  .st__rfc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
    color: var(--fig-muted);
    overflow-wrap: anywhere;
  }

  .st__v {
    padding: 0.25rem 0.6rem;
    line-height: 1.35;
    border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
    background: color-mix(in srgb, var(--brass) 7%, transparent);
    font-size: 1rem;
    color: var(--brass-soft);
    overflow-wrap: anywhere;
  }

  .st__v :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--brass-soft);
  }

  .st__note {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  @media (max-width: 719px) {
    .st {
      --st-pad: 0.5rem;
      --st-fcol: 3.4rem;
      --st-gap: 0.9rem;
      padding-left: 0.9rem;
    }
    .st__pair::before {
      left: -0.8rem;
    }
    .st__head {
      display: none;
    }
    .st__row {
      grid-template-columns: var(--st-fcol) minmax(0, 1fr);
      gap: 0.35rem var(--st-gap);
    }
    .st__f {
      grid-row: span 2;
    }
  }
</style>
