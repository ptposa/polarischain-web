---
interface Props {
  id: string;
  /** Section number, as in a paper. */
  num?: string;
  /** What the section is, in two or three words. */
  kicker: string;
  title: string;
  class?: string;
}

const { id, num, kicker, title, class: extra } = Astro.props;
---

<section class:list={['chapter', extra]} id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <p class="sec">{num && <><b>{num}</b><i aria-hidden="true">·</i></>}<span>{kicker}</span></p>
    <h2 id={`${id}-h`} set:html={title} />
    <slot />
  </div>
</section>
