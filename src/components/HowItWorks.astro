---
type DomainId = "a" | "b" | "c";
type NodeId = `${DomainId}-${string}`;
type PointId = NodeId | "leaf";
type LinkKind = "intra" | "cross" | "leaf";

type DomainZone = {
  id: DomainId;
  title: string;
  subtitle: string;
  x: number;
  y: number;
  width: number;
  height: number;
};

type ProcessNode = {
  id: NodeId;
  domain: DomainId;
  title: string;
  x: number;
  y: number;
  r: number;
  emphasis?: "issuer" | "anchor";
  showLabel?: boolean;
};

type ProcessLink = {
  id: string;
  from: PointId;
  to: PointId;
  kind: LinkKind;
};

const leafPoint = { id: "leaf" as const, x: 134, y: 296 };

const zones: DomainZone[] = [
  { id: "a", title: "Domain A", subtitle: "certificate origin", x: 66, y: 58, width: 298, height: 304 },
  { id: "c", title: "Cross-domain trust graph", subtitle: "federated trust space", x: 468, y: 58, width: 304, height: 304 },
  { id: "b", title: "Domain B", subtitle: "validation / trust anchor", x: 870, y: 58, width: 304, height: 304 },
];

const nodes: ProcessNode[] = [
  { id: "a-root", domain: "a", title: "Root CA", x: 236, y: 98, r: 11, showLabel: true },
  { id: "a-intermediate-1", domain: "a", title: "Intermediate CA", x: 236, y: 160, r: 10, showLabel: true },
  { id: "a-intermediate-2", domain: "a", title: "Intermediate CA", x: 236, y: 224, r: 10, showLabel: true },
  { id: "a-issuing", domain: "a", title: "Issuing CA", x: 236, y: 296, r: 11, emphasis: "issuer", showLabel: true },
  { id: "c-root", domain: "c", title: "Root CA", x: 540, y: 102, r: 10 },
  { id: "c-bridge-nw", domain: "c", title: "Cross-cert node", x: 610, y: 126, r: 9.5 },
  { id: "c-policy", domain: "c", title: "Policy node", x: 690, y: 110, r: 9.5 },
  { id: "c-mesh-west", domain: "c", title: "Intermediate CA", x: 548, y: 190, r: 10 },
  { id: "c-mesh-center", domain: "c", title: "Trust relation", x: 626, y: 198, r: 10.5 },
  { id: "c-mesh-east", domain: "c", title: "Relay CA", x: 706, y: 188, r: 9.5 },
  { id: "c-bridge-south", domain: "c", title: "Cross-cert node", x: 574, y: 284, r: 9.5 },
  { id: "c-exit-south", domain: "c", title: "Exit CA", x: 650, y: 288, r: 9.5 },
  { id: "c-exit-north", domain: "c", title: "Exit CA", x: 724, y: 258, r: 9.5 },
  { id: "c-dead-end", domain: "c", title: "Dead end", x: 682, y: 338, r: 8.5 },
  { id: "b-root", domain: "b", title: "Trust Anchor", x: 1010, y: 98, r: 13, emphasis: "anchor", showLabel: true },
  { id: "b-intermediate-1", domain: "b", title: "Intermediate CA", x: 1010, y: 162, r: 10, showLabel: true },
  { id: "b-intermediate-2", domain: "b", title: "Intermediate CA", x: 1010, y: 228, r: 10, showLabel: true },
  { id: "b-issuing", domain: "b", title: "Issuing CA", x: 1010, y: 296, r: 10, showLabel: true },
];

const links: ProcessLink[] = [
  { id: "leaf-a-issuing", from: "leaf", to: "a-issuing", kind: "leaf" },
  { id: "a-root-a-intermediate-1", from: "a-root", to: "a-intermediate-1", kind: "intra" },
  { id: "a-intermediate-1-a-intermediate-2", from: "a-intermediate-1", to: "a-intermediate-2", kind: "intra" },
  { id: "a-intermediate-2-a-issuing", from: "a-intermediate-2", to: "a-issuing", kind: "intra" },
  { id: "c-root-c-bridge-nw", from: "c-root", to: "c-bridge-nw", kind: "intra" },
  { id: "c-root-c-mesh-west", from: "c-root", to: "c-mesh-west", kind: "intra" },
  { id: "c-bridge-nw-c-policy", from: "c-bridge-nw", to: "c-policy", kind: "intra" },
  { id: "c-bridge-nw-c-mesh-center", from: "c-bridge-nw", to: "c-mesh-center", kind: "intra" },
  { id: "c-policy-c-mesh-east", from: "c-policy", to: "c-mesh-east", kind: "intra" },
  { id: "c-policy-c-exit-north", from: "c-policy", to: "c-exit-north", kind: "intra" },
  { id: "c-mesh-west-c-mesh-center", from: "c-mesh-west", to: "c-mesh-center", kind: "intra" },
  { id: "c-mesh-west-c-bridge-south", from: "c-mesh-west", to: "c-bridge-south", kind: "intra" },
  { id: "c-mesh-center-c-mesh-east", from: "c-mesh-center", to: "c-mesh-east", kind: "intra" },
  { id: "c-mesh-center-c-bridge-south", from: "c-mesh-center", to: "c-bridge-south", kind: "intra" },
  { id: "c-mesh-center-c-exit-south", from: "c-mesh-center", to: "c-exit-south", kind: "intra" },
  { id: "c-mesh-center-c-exit-north", from: "c-mesh-center", to: "c-exit-north", kind: "intra" },
  { id: "c-mesh-east-c-exit-north", from: "c-mesh-east", to: "c-exit-north", kind: "intra" },
  { id: "c-bridge-south-c-exit-south", from: "c-bridge-south", to: "c-exit-south", kind: "intra" },
  { id: "c-exit-south-c-exit-north", from: "c-exit-south", to: "c-exit-north", kind: "intra" },
  { id: "c-exit-south-c-dead-end", from: "c-exit-south", to: "c-dead-end", kind: "intra" },
  { id: "b-root-b-intermediate-1", from: "b-root", to: "b-intermediate-1", kind: "intra" },
  { id: "b-intermediate-1-b-intermediate-2", from: "b-intermediate-1", to: "b-intermediate-2", kind: "intra" },
  { id: "b-intermediate-2-b-issuing", from: "b-intermediate-2", to: "b-issuing", kind: "intra" },
  { id: "a-root-c-root", from: "a-root", to: "c-root", kind: "cross" },
  { id: "a-intermediate-1-c-bridge-nw", from: "a-intermediate-1", to: "c-bridge-nw", kind: "cross" },
  { id: "a-intermediate-2-c-mesh-west", from: "a-intermediate-2", to: "c-mesh-west", kind: "cross" },
  { id: "a-intermediate-2-c-mesh-center", from: "a-intermediate-2", to: "c-mesh-center", kind: "cross" },
  { id: "a-issuing-c-bridge-south", from: "a-issuing", to: "c-bridge-south", kind: "cross" },
  { id: "a-issuing-c-exit-south", from: "a-issuing", to: "c-exit-south", kind: "cross" },
  { id: "c-policy-b-root", from: "c-policy", to: "b-root", kind: "cross" },
  { id: "c-exit-north-b-root", from: "c-exit-north", to: "b-root", kind: "cross" },
  { id: "c-exit-north-b-intermediate-1", from: "c-exit-north", to: "b-intermediate-1", kind: "cross" },
  { id: "c-mesh-east-b-intermediate-1", from: "c-mesh-east", to: "b-intermediate-1", kind: "cross" },
  { id: "c-mesh-center-b-intermediate-2", from: "c-mesh-center", to: "b-intermediate-2", kind: "cross" },
  { id: "c-exit-south-b-intermediate-2", from: "c-exit-south", to: "b-intermediate-2", kind: "cross" },
  { id: "a-issuing-b-intermediate-2", from: "a-issuing", to: "b-intermediate-2", kind: "cross" },
];

const pathNodeOrder: NodeId[] = [
  "a-issuing",
  "a-intermediate-2",
  "c-mesh-west",
  "c-mesh-center",
  "c-exit-north",
  "b-intermediate-1",
  "b-root",
];

const pathLinkOrder = [
  "leaf-a-issuing",
  "a-intermediate-2-a-issuing",
  "a-intermediate-2-c-mesh-west",
  "c-mesh-west-c-mesh-center",
  "c-mesh-center-c-exit-north",
  "c-exit-north-b-intermediate-1",
  "b-root-b-intermediate-1",
] as const;

const pathNodeOrderMap = new Map(pathNodeOrder.map((id, index) => [id, index + 1]));
const pathLinkOrderMap = new Map(pathLinkOrder.map((id, index) => [id, index + 1]));
const pathNodeIdSet = new Set(pathNodeOrder);
const deadEndLinkIds = new Set(["a-issuing-c-bridge-south", "c-bridge-south-c-exit-south", "c-exit-south-c-dead-end"]);
const detourLinkIds = new Set(["a-issuing-c-exit-south", "c-exit-south-c-exit-north", "c-exit-north-b-root"]);
const shortcutLinkIds = new Set(["a-issuing-b-intermediate-2"]);
const hintLinkIds = new Set([...deadEndLinkIds, ...detourLinkIds, ...shortcutLinkIds]);
const hintNodeIds = new Set<NodeId>(["c-exit-south", "c-dead-end", "c-exit-north"]);

const pointMap = Object.fromEntries(
  [leafPoint, ...nodes].map((point) => [point.id, point]),
) as Record<PointId, { x: number; y: number }>;

const selectedLinks = pathLinkOrder
  .map((id) => links.find((link) => link.id === id))
  .filter(Boolean) as ProcessLink[];

const ambientPoints = [
  { x: 88, y: 94, r: 2.4 },
  { x: 108, y: 330, r: 2.8 },
  { x: 342, y: 82, r: 2.6 },
  { x: 350, y: 338, r: 2.2 },
  { x: 508, y: 82, r: 2.2 },
  { x: 540, y: 320, r: 2.4 },
  { x: 736, y: 86, r: 2.6 },
  { x: 754, y: 336, r: 2.2 },
  { x: 904, y: 84, r: 2.2 },
  { x: 1138, y: 118, r: 2.6 },
  { x: 1156, y: 330, r: 2.4 },
  { x: 1186, y: 222, r: 2.2 },
];

const ambientLines = [
  "M 86 104 L 126 132",
  "M 322 92 L 364 132",
  "M 498 96 L 550 128",
  "M 702 102 L 756 140",
  "M 908 98 L 962 130",
  "M 1118 138 L 1174 172",
];

function linkPath(fromId: PointId, toId: PointId) {
  const from = pointMap[fromId];
  const to = pointMap[toId];
  return `M ${from.x} ${from.y} L ${to.x} ${to.y}`;
}

function selectedEdgeTone(link: ProcessLink) {
  if (link.to.startsWith("b-") || link.from.startsWith("b-")) {
    return "is-warm";
  }

  if (link.from === "leaf" || link.from.startsWith("a-") || link.to.startsWith("a-")) {
    return "is-cool";
  }

  return "is-neutral";
}

function linkBehaviorClass(link: ProcessLink) {
  if (shortcutLinkIds.has(link.id)) {
    return "is-shortcut";
  }

  if (deadEndLinkIds.has(link.id)) {
    return "is-dead-end";
  }

  if (detourLinkIds.has(link.id)) {
    return "is-detour";
  }

  return "";
}
---

<section id="how-it-works" class="process-section">
  <div class="container process-shell-wide">
    <div class="process-heading">
      <span class="section-kicker">How it works</span>
      <h2>Certification path building over a federated graph of CAs.</h2>
      <p>
        PolarisChain does not replace PKIX validation. It provides a formal layer for
        modelling federation relationships without introducing a central federation
        authority, discovering viable routes, and selecting an optimal path between the
        issuer side of a certificate request and governed trust points across
        multidomain PKI environments.
      </p>
    </div>

    <div class="process-overview" aria-label="Trust path discovery stages">
      <div class="stage stage-certificate">
        <svg viewBox="0 0 88 88" class="stage-icon stage-icon-certificate" aria-hidden="true">
          <rect x="14" y="10" width="46" height="58" rx="6"></rect>
          <path d="M26 26 H48"></path>
          <path d="M26 34 H48"></path>
          <path d="M26 42 H45"></path>
          <circle cx="58" cy="54" r="10"></circle>
          <path d="M54 63 L52 76 L58 72 L64 76 L62 63"></path>
        </svg>
        <div class="stage-copy">
          <strong>Input certificate</strong>
          <span>Certificate request enters the federated validation model.</span>
        </div>
      </div>

      <span class="stage-arrow" aria-hidden="true">→</span>

      <div class="stage">
        <svg viewBox="0 0 96 64" class="stage-icon" aria-hidden="true">
          <path d="M14 36 L32 22 L52 38 L80 18"></path>
          <path d="M16 24 L34 40 L52 38 L74 44"></path>
          <circle cx="14" cy="36" r="4"></circle>
          <circle cx="32" cy="22" r="4"></circle>
          <circle cx="34" cy="40" r="4"></circle>
          <circle cx="52" cy="38" r="4"></circle>
          <circle cx="80" cy="18" r="4"></circle>
          <circle cx="74" cy="44" r="4"></circle>
        </svg>
        <div class="stage-copy">
          <strong>Graph traversal</strong>
          <span>Candidate paths are explored over a weighted trust graph.</span>
        </div>
      </div>

      <span class="stage-arrow" aria-hidden="true">→</span>

      <div class="stage">
        <svg viewBox="0 0 96 64" class="stage-icon" aria-hidden="true">
          <path d="M12 40 L28 32 L44 18 L62 28 L82 14"></path>
          <path d="M28 32 L44 44 L62 28 L80 42"></path>
          <circle cx="12" cy="40" r="4"></circle>
          <circle cx="28" cy="32" r="4"></circle>
          <circle cx="44" cy="18" r="4"></circle>
          <circle cx="44" cy="44" r="4"></circle>
          <circle cx="62" cy="28" r="4"></circle>
          <circle cx="82" cy="14" r="5" class="is-bright"></circle>
          <circle cx="80" cy="42" r="4"></circle>
        </svg>
        <div class="stage-copy">
          <strong>Path scoring</strong>
          <span>Paths are evaluated based on cryptographic strength, policy compatibility, and structural cost.</span>
        </div>
      </div>

      <span class="stage-arrow" aria-hidden="true">→</span>

      <div class="stage">
        <svg viewBox="0 0 96 64" class="stage-icon" aria-hidden="true">
          <path class="is-highlight" d="M12 38 L34 24 L54 30 L82 14"></path>
          <path d="M12 38 L34 44 L54 30 L80 46"></path>
          <path d="M34 24 L54 30 L80 46"></path>
          <circle cx="12" cy="38" r="5" class="is-bright"></circle>
          <circle cx="34" cy="24" r="5"></circle>
          <circle cx="34" cy="44" r="4"></circle>
          <circle cx="54" cy="30" r="5" class="is-bright"></circle>
          <circle cx="80" cy="46" r="4"></circle>
          <circle cx="82" cy="14" r="5" class="is-bright"></circle>
        </svg>
        <div class="stage-copy">
          <strong>Optimal trust chain</strong>
          <span>The minimum-cost valid route is surfaced as an explainable validation path.</span>
        </div>
      </div>
    </div>

    <div class="federation-graph-card" aria-label="Federated trust graph with a selected cross-domain validation path">
      <svg
        id="federated-process-graph"
        viewBox="0 0 1240 420"
        class="federation-graph"
        role="img"
        aria-label="Three PKI domains with multiple cross-domain certification paths and one highlighted trust chain"
      >
        <defs>
          <radialGradient id="processDomainAGlow" cx="50%" cy="50%" r="70%">
            <stop offset="0%" stop-color="#72b7ff" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#72b7ff" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="processDomainCGlow" cx="50%" cy="50%" r="70%">
            <stop offset="0%" stop-color="#c8d4e2" stop-opacity="0.14" />
            <stop offset="100%" stop-color="#c8d4e2" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="processDomainBGlow" cx="50%" cy="50%" r="72%">
            <stop offset="0%" stop-color="#ffd887" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#ffd887" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="processNodeBlueGlow" cx="50%" cy="50%" r="64%">
            <stop offset="0%" stop-color="#c7e4ff" stop-opacity="0.48" />
            <stop offset="100%" stop-color="#c7e4ff" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="processNodeNeutralGlow" cx="50%" cy="50%" r="64%">
            <stop offset="0%" stop-color="#dce4ed" stop-opacity="0.34" />
            <stop offset="100%" stop-color="#dce4ed" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="processNodeGoldGlow" cx="50%" cy="50%" r="68%">
            <stop offset="0%" stop-color="#ffe3a3" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#ffe3a3" stop-opacity="0" />
          </radialGradient>
        </defs>

        <g class="process-background-grid" aria-hidden="true">
          <path d="M74 102 H1160"></path>
          <path d="M74 194 H1160"></path>
          <path d="M74 286 H1160"></path>
        </g>

        <g class="process-domain-zones" aria-hidden="true">
          {zones.map((zone) => (
            <>
              {zone.id === "c" ? null : (
                <rect
                  class={`process-domain-zone is-${zone.id}`}
                  x={zone.x}
                  y={zone.y}
                  width={zone.width}
                  height={zone.height}
                  rx="34"
                />
              )}
              <ellipse
                class={`process-domain-orbit is-${zone.id}`}
                cx={zone.x + zone.width / 2}
                cy={zone.y + zone.height / 2}
                rx={zone.width * 0.45}
                ry={zone.height * 0.42}
              />
            </>
          ))}
        </g>

        <g class="process-trust-space-mesh" aria-hidden="true">
          <ellipse cx="620" cy="208" rx="172" ry="112" class="process-trust-space-cloud is-outer" />
          <ellipse cx="632" cy="204" rx="128" ry="84" class="process-trust-space-cloud is-inner" />
          <path d="M492 138 C556 108, 696 108, 756 156" />
          <path d="M486 256 C560 208, 680 224, 768 286" />
          <path d="M540 330 C604 286, 684 286, 736 244" />
        </g>

        <g class="process-domain-headings">
          {zones.map((zone) => (
            <>
              <text class={`process-domain-title is-${zone.id}`} x={zone.x + 18} y={zone.y - 14}>
                {zone.title}
              </text>
              <text class="process-domain-subtitle" x={zone.x + 18} y={zone.y + 10}>
                {zone.subtitle}
              </text>
            </>
          ))}
        </g>

        <g class="process-ambient-lines" aria-hidden="true">
          {ambientLines.map((path) => (
            <path d={path} />
          ))}
        </g>

        <g class="process-ambient-points" aria-hidden="true">
          {ambientPoints.map((point) => (
            <circle cx={point.x} cy={point.y} r={point.r} />
          ))}
        </g>

        <g class="federation-links" aria-hidden="true">
          {links.map((link) => (
            <path
              class={`process-link is-${link.kind} ${link.kind === "cross" ? "is-candidate" : ""} ${linkBehaviorClass(link)}`}
              data-hint-edge={hintLinkIds.has(link.id) || undefined}
              d={linkPath(link.from, link.to)}
            />
          ))}
        </g>

        <g class="federation-links federation-links-active" aria-hidden="true">
          {selectedLinks.map((link) => (
            <path
              class={`process-active-edge ${selectedEdgeTone(link)}`}
              data-path-edge
              data-step={pathLinkOrderMap.get(link.id)}
              d={linkPath(link.from, link.to)}
            />
          ))}
        </g>

        <g
          class="process-certificate-origin process-cert-icon"
          data-origin-cert
          data-path-point
          data-step="0"
          data-point-x={leafPoint.x}
          data-point-y={leafPoint.y}
          transform={`translate(${leafPoint.x} ${leafPoint.y})`}
          aria-hidden="true"
        >
          <ellipse class="process-cert-shadow" cx="0" cy="0" rx="18" ry="12" />
          <rect x="-15" y="-18" width="30" height="36" rx="5" />
          <path d="M-7 -7 H7" />
          <path d="M-7 -1 H7" />
          <path d="M-7 5 H4" />
          <circle cx="8" cy="10" r="4.4" />
          <path d="M6 14 L5 21 L8 19 L11 21 L10 14" />
        </g>

        <g class="federation-nodes">
          {nodes.map((node) => {
            const isOnPath = pathNodeIdSet.has(node.id);
            const isAnchor = node.emphasis === "anchor";
            const labelClass = node.emphasis === "issuer" || isAnchor ? "is-emphasis" : "";
            const showLabel = Boolean(node.showLabel);

            return (
              <g
                class={`process-node-group is-${node.domain} ${isOnPath ? "is-on-path" : ""} ${isAnchor ? "is-anchor" : ""}`}
                data-point-x={node.x}
                data-point-y={node.y}
                data-hint-node={hintNodeIds.has(node.id) || undefined}
                data-path-node={isOnPath || undefined}
                data-path-point={isOnPath || undefined}
                data-step={isOnPath ? pathNodeOrderMap.get(node.id) : undefined}
              >
                <circle
                  class={`process-node-halo is-${node.domain} ${isAnchor ? "is-anchor" : ""}`}
                  data-node-halo={isOnPath || undefined}
                  data-step={isOnPath ? pathNodeOrderMap.get(node.id) : undefined}
                  cx={node.x}
                  cy={node.y}
                  r={isAnchor ? 40 : 30}
                />
                <circle
                  class={`process-graph-node is-${node.domain} ${node.emphasis === "issuer" ? "is-issuer" : ""} ${isAnchor ? "is-anchor" : ""}`}
                  cx={node.x}
                  cy={node.y}
                  r={node.r}
                />
                <circle class="process-node-core" cx={node.x} cy={node.y} r={Math.max(2.8, node.r * 0.28)} />
                {showLabel ? (
                  <text
                    class={`process-node-caption ${labelClass}`}
                    x={node.x}
                    y={node.y + node.r + 20}
                    text-anchor="middle"
                  >
                    {node.title}
                  </text>
                ) : null}
              </g>
            );
          })}
        </g>

        <g class="process-graph-labels" aria-hidden="true">
          <text x="84" y="338">End-Entity certificate</text>
          <text x="330" y="168">Cross-domain edge</text>
          <text x="520" y="348">Cross-domain trust graph</text>
          <text x="954" y="78">Trust Anchor</text>
        </g>

        <g class="process-moving-cert process-cert-icon" data-moving-cert aria-hidden="true">
          <ellipse class="process-cert-trail" data-cert-trail cx="-2" cy="0" rx="20" ry="12" />
          <rect x="-15" y="-18" width="30" height="36" rx="5" />
          <path d="M-7 -7 H7" />
          <path d="M-7 -1 H7" />
          <path d="M-7 5 H4" />
          <circle cx="8" cy="10" r="4.4" />
          <path d="M6 14 L5 21 L8 19 L11 21 L10 14" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .federation-graph-card {
    position: relative;
    overflow: hidden;
    padding: 18px 12px 8px;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 20% 48%, rgba(94, 146, 216, 0.12), transparent 22%),
      radial-gradient(circle at 50% 42%, rgba(203, 216, 233, 0.08), transparent 18%),
      radial-gradient(circle at 84% 44%, rgba(228, 187, 96, 0.12), transparent 22%),
      linear-gradient(180deg, rgba(10, 16, 30, 0.86), rgba(8, 13, 24, 0.92));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.26);
    contain: paint;
  }

  .federation-graph {
    display: block;
    width: 100%;
    height: auto;
  }

  .process-background-grid path {
    stroke: rgba(255, 255, 255, 0.04);
    stroke-width: 1;
