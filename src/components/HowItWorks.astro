  }

  .process-ambient-points circle {
    fill: rgba(223, 233, 245, 0.64);
    filter: drop-shadow(0 0 4px rgba(221, 234, 249, 0.12));
  }

  .federation-links path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .process-link.is-leaf {
    stroke: rgba(116, 177, 244, 0.28);
    stroke-width: 1.6;
  }

  .process-link.is-intra {
    stroke: rgba(177, 198, 223, 0.26);
    stroke-width: 1.8;
  }

  .process-link.is-cross {
    stroke: rgba(198, 212, 229, 0.14);
    stroke-width: 1.45;
  }

  .process-link.is-dead-end {
    stroke: rgba(176, 193, 214, 0.11);
  }

  .process-link.is-detour {
    stroke: rgba(193, 208, 226, 0.18);
  }

  .process-link.is-shortcut {
    stroke: rgba(228, 214, 182, 0.1);
