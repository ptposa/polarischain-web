---
import { processSteps } from '../data/process-steps';
import PkiGraphHero from './PkiGraphHero.astro';
---

<section class="section section-pad" id="how-it-works" style="background:transparent;">
  <div class="container">
    <div class="hiw-grid">
      <div class="hiw-left">
        <span class="section-kicker">How it works</span>
        <h2 class="section-heading">Certification path building over a federated graph of CAs.</h2>
        <p class="section-sub">
          PolarisChain does not replace PKIX validation. It provides a formal layer for modelling
          federation relationships without a central federation authority, discovering viable
          routes, and selecting an optimal path between the issuer side of a certificate request and
          governed trust points across multidomain PKI environments.
        </p>

        <div class="process-steps" data-step-timeline aria-label="Trust path discovery stages">
          {
            processSteps.map((step) => (
              <div class="process-step">
                <div class={`step-icon${step.isAnchor ? ' is-anchor' : ''}`}>
                  <svg
                    viewBox="0 0 40 40"
                    width="28"
                    height="28"
                    fill="none"
                    stroke="currentColor"
                    stroke-width={step.strokeWidth}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={step.icon}
                  />
                </div>
                <div class="step-text">
                  <span class="step-title">{step.title}</span>
                  <span class="step-desc">{step.desc}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="path-live-panel">
        <div class="path-live-header">
          <span class="graph-panel-title">Federated path discovery · Live</span>
          <span class="graph-panel-dot"></span>
        </div>
        <PkiGraphHero />
      </div>
    </div>
  </div>
</section>

<style>
  .hiw-grid {
    display: grid;
    grid-template-columns: 38fr 62fr;
    gap: 56px;
    align-items: start;
  }
  .hiw-left {
    position: sticky;
    top: 84px;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 34px;
    margin: 44px 0 0;
    position: relative;
    max-width: 560px;
  }
  .process-steps::before {
    content: '';
    position: absolute;
    left: 26px;
    top: 26px;
    bottom: 26px;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(122, 179, 232, 0.3) 16%,
      rgba(122, 179, 232, 0.3) 66%,
      rgba(232, 201, 106, 0.4) 88%,
      transparent
    );
    transform: scaleY(0);
    transform-origin: top center;
  }
  .process-steps.is-live::before {
    transform: scaleY(1);
    transition: transform 1.6s ease;
  }

  .process-step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    text-align: left;
    gap: 18px;
    padding: 0;
    position: relative;
  }
  .step-text {
    display: flex;
    flex-direction: column;
    padding-top: 4px;
  }

  .step-icon {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--bg-cosmos, #060a14);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    color: rgba(200, 218, 240, 0.4);
    transition:
      border-color 0.5s ease,
      background 0.5s ease,
      box-shadow 0.5s ease,
      color 0.5s ease;
  }
  .step-icon svg {
    width: 24px;
    height: 24px;
  }
  .step-icon:hover {
    border-color: rgba(255, 255, 255, 0.24);
  }

  .process-step.is-on .step-icon {
    color: #7ab3e8;
    border-color: oklch(72% 0.12 230 / 0.4);
    background: oklch(72% 0.12 230 / 0.08);
    box-shadow: 0 0 20px oklch(72% 0.12 230 / 0.12);
  }
  .process-step.is-on .step-icon:hover {
    border-color: oklch(72% 0.12 230 / 0.65);
  }
  .process-step.is-on .step-icon.is-anchor {
    color: #e8c96a;
    border-color: oklch(76% 0.11 72 / 0.4);
    background: oklch(76% 0.11 72 / 0.08);
    box-shadow: 0 0 20px oklch(76% 0.11 72 / 0.1);
  }
  .process-step.is-on .step-icon.is-anchor:hover {
    border-color: oklch(76% 0.11 72 / 0.65);
  }

  .process-step.is-on .step-icon::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    pointer-events: none;
    animation: stepPulse 0.9s ease-out 1 forwards;
    --pulse-c: oklch(72% 0.12 230 / 0.4);
  }
  .process-step.is-on .step-icon.is-anchor::after {
    animation: stepPulseStrong 1.1s ease-out 1 forwards;
    --pulse-c: oklch(76% 0.11 72 / 0.5);
  }
  @keyframes stepPulse {
    0% {
      box-shadow: 0 0 0 0 var(--pulse-c);
      opacity: 1;
    }
    100% {
      box-shadow: 0 0 0 22px transparent;
      opacity: 0;
    }
  }
  @keyframes stepPulseStrong {
    0% {
      box-shadow:
        0 0 0 0 var(--pulse-c),
        0 0 30px var(--pulse-c);
      opacity: 1;
    }
    100% {
      box-shadow:
        0 0 0 30px transparent,
        0 0 0 transparent;
      opacity: 0;
    }
  }

  .step-icon :global(.icd) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .process-step.is-on .step-icon :global(.icd) {
    animation: icDraw 0.9s ease 0.1s forwards;
  }
  @keyframes icDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .step-icon :global(.dim) {
    opacity: 0.4;
  }

  .step-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.18rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: 6px;
    transition: color 0.5s ease;
  }
  .process-step.is-on .step-title {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .process-steps::before,
    .process-steps.is-live::before {
      transform: scaleY(1);
      transition: none;
    }
    .step-icon,
    .step-title {
      transition: none;
    }
    .process-step.is-on .step-icon::after {
      animation: none;
      opacity: 0;
    }
    .step-icon :global(.icd) {
      stroke-dashoffset: 0 !important;
      animation: none !important;
    }
  }

  .step-desc {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-soft);
  }

  .path-live-panel {
    width: 100%;
    margin: 0;
  }
  .path-live-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .path-live-header .graph-panel-title {
    font-family: var(--font-mono);
  }

  .graph-panel-title {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .graph-panel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: oklch(72% 0.12 230);
    box-shadow: 0 0 8px oklch(72% 0.12 230 / 0.6);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  @media (max-width: 1100px) {
    .hiw-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .hiw-left {
      position: static;
    }
    .path-live-panel {
      max-width: 880px;
      margin: 0 auto;
    }
  }
  @media (max-width: 640px) {
    .step-icon {
      width: 44px;
      height: 44px;
    }
    .step-icon svg {
      width: 21px;
      height: 21px;
    }
    .process-steps::before {
      left: 22px;
      top: 22px;
      bottom: 22px;
    }
    .step-desc {
      font-size: 0.8rem;
    }
    .path-live-panel {
      max-width: none;
    }
  }
</style>

<script>
  import { init } from '../lib/step-timeline';

  const steps = document.querySelector<HTMLElement>('[data-step-timeline]');
  if (steps) init(steps);
</script>
