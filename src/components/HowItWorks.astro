    transform-origin: center;
  }

  .process-graph-node.is-a {
    fill: rgba(110, 176, 245, 0.84);
    filter: drop-shadow(0 0 8px rgba(113, 179, 247, 0.18));
  }

  .process-graph-node.is-c {
    fill: rgba(182, 196, 213, 0.5);
    filter: drop-shadow(0 0 7px rgba(206, 218, 232, 0.1));
  }

  .process-node-group[data-hint-node] .process-graph-node.is-c {
    fill: rgba(176, 190, 208, 0.42);
  }

  .process-graph-node.is-b {
    fill: rgba(226, 187, 103, 0.88);
    filter: drop-shadow(0 0 8px rgba(241, 202, 117, 0.18));
  }

  .process-graph-node.is-issuer {
    fill: rgba(132, 194, 255, 0.95);
