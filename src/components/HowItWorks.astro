    mix-blend-mode: screen;
  }

  .process-domain-orbit.is-a {
    fill: url(#processDomainAGlow);
  }

  .process-domain-orbit.is-c {
    fill: url(#processDomainCGlow);
    opacity: 0.64;
  }

  .process-domain-orbit.is-b {
