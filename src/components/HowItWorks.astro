  .process-domain-zone.is-c {
    fill: rgba(194, 205, 219, 0.04);
    stroke: rgba(213, 225, 236, 0.12);
  }

  .process-domain-zone.is-b {
    fill: rgba(205, 162, 81, 0.07);
    stroke: rgba(243, 208, 132, 0.18);
  }

  .process-trust-space-mesh {
    mix-blend-mode: screen;
  }

  .process-trust-space-cloud {
    fill: rgba(186, 203, 225, 0.04);
    stroke: rgba(208, 220, 235, 0.06);
    stroke-width: 1;
  }

  .process-trust-space-cloud.is-inner {
