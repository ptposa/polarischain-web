  .process-active-edge.is-cool {
    stroke: rgba(213, 234, 255, 0.98);
    filter: drop-shadow(0 0 6px rgba(133, 187, 245, 0.26));
  }

  .process-active-edge.is-neutral {
    stroke: rgba(234, 241, 248, 0.94);
