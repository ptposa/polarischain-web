    letter-spacing: 0.01em;
  }

  .process-cert-icon {
    transform-origin: center;
  }

  .process-cert-icon rect {
    fill: rgba(246, 241, 231, 0.92);
    stroke: rgba(84, 74, 61, 0.22);
    stroke-width: 1.1;
  }

  .process-cert-icon path {
    fill: none;
    stroke: rgba(92, 80, 63, 0.48);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .process-cert-icon circle {
    fill: rgba(220, 196, 139, 0.96);
    stroke: rgba(110, 83, 44, 0.56);
    stroke-width: 1.1;
  }

  .process-certificate-origin {
    opacity: 0.3;
  }

  .process-cert-shadow {
    fill: rgba(106, 159, 232, 0.14);
    filter: blur(14px);
  }

  .process-moving-cert {
    opacity: 0;
  }

  .process-cert-trail {
    fill: rgba(134, 190, 255, 0.28);
