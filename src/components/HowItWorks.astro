<script>
  import { gsap } from "gsap";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const graph = document.querySelector("#federated-process-graph");
    const activeEdges = graph?.querySelectorAll(".process-active-edge");
    const allNodes = graph?.querySelectorAll(".process-graph-node");
    const highlightNodes = graph?.querySelectorAll(".process-graph-node.is-highlight, .process-graph-node.is-anchor, .process-graph-node.is-issuer");
    const halos = graph?.querySelectorAll(".process-halo");
    const incoming = graph?.querySelectorAll(".incoming-cert");

    if (graph && activeEdges && allNodes && highlightNodes && halos && incoming) {
      activeEdges.forEach((edge) => {
        const path = edge as SVGPathElement;
        const len = path.getTotalLength();
        path.style.strokeDasharray = `${len}`;
        path.style.strokeDashoffset = `${len}`;
      });

      gsap.set(allNodes, {
        opacity: 0.42,
        scale: 0.9,
        transformOrigin: "center center",
      });

      gsap.set(halos, {
        opacity: 0,
        scale: 0.5,
        transformOrigin: "center center",
      });

      gsap.set(incoming, {
        opacity: 0.35,
        x: -10,
      });

      const tl = gsap.timeline({
        repeat: -1,
        repeatDelay: 1.2,
        defaults: { ease: "power2.out" },
      });

      tl.to(incoming, {
        opacity: 0.92,
        x: 0,
        duration: 0.8,
        stagger: 0.18,
      })
        .to(
          activeEdges,
          {
            strokeDashoffset: 0,
            opacity: 1,
            duration: 1.15,
            stagger: 0.45,
          },
          "-=0.2"
        )
        .to(
          highlightNodes,
          {
            opacity: 1,
            scale: 1.16,
            duration: 0.55,
            stagger: 0.38,
          },
          "-=4.9"
        )
        .to(
          halos,
          {
            opacity: 1,
            scale: 1.18,
            duration: 0.75,
            stagger: 1.05,
            yoyo: true,
            repeat: 1,
          },
          "-=4.2"
        )
        .to(
          activeEdges,
          {
            opacity: 0.24,
            strokeDashoffset: (index, target) => {
              const path = target as SVGPathElement;
              return path.getTotalLength();
            },
            duration: 0.01,
            stagger: 0,
          },
          "+=0.45"
        )
        .to(
          highlightNodes,
          {
            opacity: 0.72,
            scale: 1,
            duration: 0.2,
            stagger: 0,
          },
          "<"
        )
        .to(
          incoming,
          {
            opacity: 0.35,
            duration: 0.2,
            stagger: 0,
          },
          "<"
        );
    }
  }
</script>
