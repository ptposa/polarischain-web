---
import { processSteps } from '../data/process-steps';
import PkiGraphHero from './PkiGraphHero.astro';
---

<section class="section section-pad" id="how-it-works" style="background:transparent;">
  <div class="container">
    <div class="hiw-grid">
      <div class="hiw-left">
        <span class="section-kicker">How it works</span>
        <h2 class="section-heading">Certification path building over a federated graph of CAs.</h2>
        <p class="section-sub">
          PolarisChain does not replace PKIX validation. It provides a formal layer for modelling
          federation relationships without a central federation authority, discovering viable
          routes, and selecting an optimal path between the issuer side of a certificate request and
          governed trust points across multidomain PKI environments.
        </p>

        <div class="process-steps" data-step-timeline aria-label="Trust path discovery stages">
          {
            processSteps.map((step) => (
              <div class="process-step">
                <div class={`step-icon${step.isAnchor ? ' is-anchor' : ''}`}>
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width={step.strokeWidth}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={step.icon}
                  />
                  <span class="step-num">{step.num}</span>
                </div>
                <div class="step-text">
                  <span class="step-title">{step.title}</span>
                  <span class="step-desc">{step.desc}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="path-live-panel">
        <div class="path-live-header">
          <span class="graph-panel-title">Federated path discovery · Live</span>
          <span class="graph-panel-dot"></span>
        </div>
        <PkiGraphHero />
      </div>
    </div>
  </div>
</section>

<style>
  .hiw-grid {
    display: grid;
    grid-template-columns: 38fr 62fr;
    gap: 56px;
    align-items: start;
  }
  .hiw-left {
    position: sticky;
    top: 84px;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 34px;
    margin: 44px 0 0;
    position: relative;
    max-width: 560px;
  }
  /* No continuous rail: each step owns the rule that runs to the next one,
     so nothing has to be masked out and the plate stays flat like a figure. */
  .process-steps::before {
    content: none;
  }

  .process-step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    text-align: left;
    gap: 26px;
    padding: 0;
    position: relative;
  }

  /* Segment between this step's glyph and the next one */
  .process-step::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 62px;
    height: calc(100% - 46px);
    width: 2px;
    background: rgba(184, 170, 152, 0.2);
    transform: scaleY(0);
    transform-origin: top center;
    transition:
      transform 1.1s cubic-bezier(0.4, 0, 0.25, 1) 0.15s,
      background 1.1s ease;
  }
  .process-step:last-child::before {
    content: none;
  }
  .process-step.is-on::before {
    transform: scaleY(1);
  }

  .step-text {
    display: flex;
    flex-direction: column;
    padding-top: 6px;
  }

  /* Bare glyph: no container, no fill behind it */
  .step-icon {
    width: 48px;
    height: 52px;
    flex: none;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    position: relative;
    color: rgba(200, 218, 240, 0.28);
    opacity: 0.6;
    transition:
      opacity 1.1s ease,
      color 1.1s ease;
  }
  .step-icon svg {
    width: 46px;
    height: 46px;
  }

  /* Figure-style index, as in the plate captions */
  .step-num {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    color: rgba(184, 170, 152, 0.4);
    transition: color 1.1s ease;
  }

  .process-step.is-on .step-icon {
    opacity: 1;
    color: rgba(122, 179, 232, 0.8);
  }
  .process-step.is-on .step-icon.is-anchor {
    color: rgba(232, 201, 106, 0.85);
  }
  .process-step.is-on .step-num {
    color: rgba(184, 170, 152, 0.7);
  }

  .step-icon :global(.icd) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .process-step.is-on .step-icon :global(.icd) {
    animation: icDraw 1.8s cubic-bezier(0.35, 0, 0.25, 1) 0.2s forwards;
  }
  @keyframes icDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .step-icon :global(.dim) {
    opacity: 0.4;
  }

  .step-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.18rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: 6px;
    transition: color 1.1s ease;
  }
  .process-step.is-on .step-title {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step::before {
      transform: scaleY(1);
      transition: none;
    }
    .step-icon,
    .step-title,
    .step-num {
      transition: none;
      opacity: 1;
    }
    .step-icon :global(.icd) {
      stroke-dashoffset: 0 !important;
      animation: none !important;
    }
  }

  .step-desc {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-soft);
  }

  .path-live-panel {
    width: 100%;
    margin: 0;
  }
  .path-live-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .path-live-header .graph-panel-title {
    font-family: var(--font-mono);
  }

  .graph-panel-title {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .graph-panel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: oklch(72% 0.12 230);
    box-shadow: 0 0 8px oklch(72% 0.12 230 / 0.6);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  @media (max-width: 1100px) {
    .hiw-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .hiw-left {
      position: static;
    }
    .path-live-panel {
      max-width: 880px;
      margin: 0 auto;
    }
  }
  @media (max-width: 640px) {
    .step-icon {
      width: 42px;
      height: 48px;
    }
    .step-icon svg {
      width: 40px;
      height: 40px;
    }
    .process-step {
      gap: 18px;
    }
    .process-step::before {
      left: 20px;
      top: 56px;
      height: calc(100% - 42px);
    }
    .step-desc {
      font-size: 0.8rem;
    }
    .path-live-panel {
      max-width: none;
    }
  }
</style>

<script>
  import { init } from '../lib/step-timeline';

  const steps = document.querySelector<HTMLElement>('[data-step-timeline]');
  if (steps) init(steps);
</script>
