  }

  .process-domain-title {
    font-family: "Playfair Display", serif;
    font-size: 20px;
    letter-spacing: 0.02em;
  }

  .process-domain-title.is-a {
    fill: rgba(219, 236, 255, 0.92);
  }

  .process-domain-title.is-c {
    fill: rgba(226, 234, 241, 0.82);
  }

  .process-domain-title.is-b {
    fill: rgba(251, 231, 184, 0.95);
