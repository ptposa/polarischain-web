  }

  .process-node-group.is-anchor .process-node-caption {
    fill: rgba(255, 231, 180, 0.96);
  }

  .process-graph-labels text {
    fill: rgba(224, 213, 195, 0.82);
    font-family: "Playfair Display", serif;
