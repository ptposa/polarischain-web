---
import {
  actionRowClasses,
  buttonBaseClasses,
  buttonPrimaryClasses,
  buttonSecondaryClasses,
} from "../lib/ui";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  note?: string;
  statusCode?: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  panelKicker: string;
  panelTitle: string;
  panelText: string;
  metaPrimaryLabel?: string;
  metaPrimaryValue?: string;
  metaSecondaryLabel?: string;
  metaSecondaryValue?: string;
}

const {
  eyebrow,
  title,
  description,
  note,
  statusCode,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  panelKicker,
  panelTitle,
  panelText,
  metaPrimaryLabel = "Status",
  metaPrimaryValue = "In progress",
  metaSecondaryLabel = "Availability",
  metaSecondaryValue = "Soon",
} = Astro.props;

const hasSecondary = Boolean(secondaryHref && secondaryLabel);
---

<main class="status-page relative min-h-[calc(100vh-60px)] overflow-clip">
  <section class="status-hero relative pt-[36px] pb-[82px] max-[760px]:pt-[24px] max-[760px]:pb-[56px]">
    <div class="container status-shell relative z-[1] min-h-[calc(100vh-180px)] grid grid-cols-[minmax(0,0.96fr)_minmax(320px,0.9fr)] items-center gap-[34px] max-[1080px]:min-h-auto max-[1080px]:grid-cols-[1fr] max-[760px]:gap-[22px]">
      <div class="status-copy max-w-[720px] max-[1080px]:max-w-none">
        <span class="section-kicker mb-[18px] text-[rgba(197,188,176,0.74)] max-[760px]:mb-[16px]">{eyebrow}</span>
        {statusCode && <span class="status-code block mb-[14px] text-[rgba(206,222,242,0.58)] [font-family:'Playfair_Display',serif] text-[1.15rem] tracking-[0.18em] max-[760px]:mb-[12px] max-[760px]:text-[0.98rem]">{statusCode}</span>}
        <h1 class="m-0 max-w-[11ch] text-[#f4efe5] [font-family:'Playfair_Display',serif] text-[clamp(3.4rem,7vw,6rem)] font-normal leading-[0.94] tracking-[-0.04em] max-[1080px]:max-w-[10ch] max-[760px]:max-w-none max-[760px]:text-[clamp(2.9rem,13vw,4.3rem)] max-[760px]:leading-[0.98]">{title}</h1>
        <p class="status-lead mt-[28px] mb-0 max-w-[60ch] text-[rgba(217,208,196,0.82)] text-[1.08rem] leading-[1.9] max-[760px]:mt-[22px] max-[760px]:text-[1rem] max-[760px]:leading-[1.82]">{description}</p>
        {note && <p class="status-note mt-[18px] mb-0 max-w-[56ch] text-[rgba(190,181,170,0.68)] leading-[1.78] max-[760px]:mt-[14px]">{note}</p>}

        <div class={`status-actions mt-[34px] max-[760px]:mt-[28px] ${actionRowClasses}`}>
          <a class={`${buttonBaseClasses} ${buttonPrimaryClasses}`} href={primaryHref}>
            {primaryLabel}
          </a>
          {
            hasSecondary && (
              <a class={`${buttonBaseClasses} ${buttonSecondaryClasses}`} href={secondaryHref}>
                {secondaryLabel}
              </a>
            )
          }
        </div>
      </div>

      <div class="status-visual relative min-h-[560px] p-0 overflow-visible max-[760px]:min-h-[420px]" aria-hidden="true">
        <div class="status-orb status-orb-left absolute rounded-full blur-[36px] opacity-[0.34] top-[72px] left-[68px] right-auto bottom-auto w-[180px] h-[180px] bg-[rgba(176,205,239,0.14)]"></div>
        <div class="status-orb status-orb-right absolute rounded-full blur-[36px] opacity-[0.34] top-auto right-[62px] bottom-[110px] left-auto w-[220px] h-[220px] bg-[rgba(227,214,184,0.12)]"></div>

        <svg viewBox="0 0 620 620" class="status-graph absolute inset-0 w-full h-full" role="presentation">
          <g class="status-graph-grid">
            <path d="M104 122 L520 122"></path>
            <path d="M90 242 L540 242"></path>
            <path d="M82 364 L546 364"></path>
            <path d="M122 486 L512 486"></path>
            <path d="M122 96 L168 188 L102 300 L170 408 L132 510"></path>
            <path d="M232 82 L266 182 L220 296 L276 410 L250 520"></path>
            <path d="M368 88 L394 184 L344 304 L402 422 L376 522"></path>
            <path d="M500 100 L522 188 L470 300 L530 412 L506 514"></path>
          </g>

          <g class="status-links">
            <path d="M126 418 L210 338 L306 364 L414 244 L500 196"></path>
            <path d="M126 418 L246 470 L348 428 L428 482 L510 430"></path>
            <path d="M210 338 L250 208 L352 178 L414 244"></path>
            <path d="M306 364 L348 428"></path>
            <path d="M352 178 L500 196"></path>
          </g>

          <g class="status-halos">
            <circle cx="126" cy="418" r="42"></circle>
            <circle cx="414" cy="244" r="36"></circle>
            <circle cx="500" cy="196" r="54"></circle>
          </g>

          <g class="status-nodes">
            <circle cx="126" cy="418" r="11"></circle>
            <circle cx="210" cy="338" r="8"></circle>
            <circle cx="250" cy="208" r="7"></circle>
            <circle cx="306" cy="364" r="8"></circle>
            <circle cx="352" cy="178" r="7"></circle>
            <circle cx="348" cy="428" r="7"></circle>
            <circle cx="414" cy="244" r="9"></circle>
            <circle cx="428" cy="482" r="7"></circle>
            <circle cx="500" cy="196" r="12"></circle>
            <circle cx="510" cy="430" r="8"></circle>
          </g>
        </svg>

        <div class="status-panel absolute right-[30px] bottom-[28px] w-[min(320px,calc(100%-56px))] px-[22px] pt-[22px] pb-[20px] rounded-[24px] border border-[rgba(255,255,255,0.08)] bg-[rgba(8,12,20,0.72)] backdrop-blur-[16px] shadow-[0_18px_44px_rgba(0,0,0,0.28)] max-[760px]:right-[18px] max-[760px]:bottom-[18px] max-[760px]:w-[calc(100%-36px)] max-[760px]:p-[18px] max-[760px]:rounded-[20px]">
          <span class="note-label text-[rgba(197,189,178,0.68)]">{panelKicker}</span>
          <h2 class="mt-[14px] mx-0 mb-0 text-[#f3ede2] [font-family:'Playfair_Display',serif] text-[2rem] font-normal leading-[0.96] tracking-[-0.03em] max-[760px]:text-[1.62rem]">{panelTitle}</h2>
          <p class="mt-[16px] mx-0 mb-0 text-[rgba(209,200,188,0.72)] leading-[1.75] max-[760px]:leading-[1.64]">{panelText}</p>

          <div class="status-metadata mt-[22px] pt-[18px] border-t border-[rgba(255,255,255,0.08)] grid grid-cols-2 gap-[16px] max-[760px]:grid-cols-[1fr] max-[760px]:gap-[12px]">
            <div>
              <span class="block mb-[6px] text-[rgba(184,175,164,0.62)] text-[0.76rem] tracking-[0.12em] uppercase">{metaPrimaryLabel}</span>
              <strong class="text-[#f4efe5] [font-family:'Playfair_Display',serif] text-[1.15rem] font-normal">{metaPrimaryValue}</strong>
            </div>
            <div>
              <span class="block mb-[6px] text-[rgba(184,175,164,0.62)] text-[0.76rem] tracking-[0.12em] uppercase">{metaSecondaryLabel}</span>
              <strong class="text-[#f4efe5] [font-family:'Playfair_Display',serif] text-[1.15rem] font-normal">{metaSecondaryValue}</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
